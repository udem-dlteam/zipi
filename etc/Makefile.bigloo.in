#*---------------------------------------------------------------------*/
#*    Compilers, tools, and misc configuration                         */
#*---------------------------------------------------------------------*/
# the Bigloo compiler
LINK		= @LINK@
BIGLOOLIBDIR	= @BIGLOOLIBDIR@
AFILE		= @AFILE@
BTAGS		= @BTAGS@
DEPEND		= @BDEPEND@

#*---------------------------------------------------------------------*/
#*    Compilation flags                                                */
#*---------------------------------------------------------------------*/
DEBUG		= @DEBUG@
BCFLAGS		= @BCFLAGS@ -srfi zipi-$(LINK) $(EFLAGS)
BLDFLAGS	= @BLDFLAGS@
BTFLAGS		= @BTFLAGS@
BCFLAGSDEV	= @BCFLAGSDEV@
BCFLAGSRTS	= @BCFLAGSRTS@
BLFLAGS         = @BLFLAGS@ $(BLIBFLAGS)
BHFLAGS		= @BHFLAGS@ -q -mkaddheap -mkaddlib $(EFLAGS)
BJFLAGS		= -j
CCFLAGS		= @CCFLAGS@
HFLAGS		= @HFLAGS@ --reset-bigloo-options --bigloo=$(BIGLOO) --bigloo-lib-dir=$(BIGLOOLIBDIR) --share-dir $(BUILDSHAREDIR) $(EFLAGS) --

BZIPICFLAGS	= @BZIPICFLAGS@

#*---------------------------------------------------------------------*/
#*    Linking                                                          */
#*---------------------------------------------------------------------*/
ZIPIEXTRALIBS	= @EXTRALIBS@
ZIPIBIGLOOEXTRALIBS = @BIGLOOEXTRALIBS@
ZIPIAPPLIBS	=

#*---------------------------------------------------------------------*/
#*    REPOSITORY                                                       */
#*---------------------------------------------------------------------*/
ZIPITMPDIR	= /tmp
ZIPIDISTRIBDIR	= @ZIPIDISTRIBDIR@

#*---------------------------------------------------------------------*/
#*    Destinations                                                     */
#*---------------------------------------------------------------------*/
ZIPIPREFIX	= @PREFIX@
ZIPIETCDIR	= @ETCDIR@
ZIPIBINDIR	= @BINDIR@
ZIPILIBDIR	= @LIBDIR@
ZIPISHAREDIR	= @SHAREDIR@
ZIPIMANDIR	= @MANDIR@
ZIPIWEBLETSDIR	= @WEBLETSDIR@
ZIPICONTRIBSDIR	= @CONTRIBSDIR@
ZIPIDOCDIR	= @DOCDIR@

#*---------------------------------------------------------------------*/
#*    install                                                          */
#*---------------------------------------------------------------------*/
.PHONY: install.system.bigloo

install.bigloo:
	true

install.system.bigloo:
	$(INSTALL) $(BUILDLIBDIR)/pyc.init $(DESTDIR)$(ZIPILIBDIR)/$(ZIPIFILDIR)/pyc.init && \
        chmod $(MODFILE) $(DESTDIR)$(ZIPILIBDIR)/$(ZIPIFILDIR)/pyc.init;
	$(INSTALL) $(BUILDLIBDIR)/zipi.init $(DESTDIR)$(ZIPILIBDIR)/$(ZIPIFILDIR)/zipi.init && \
        chmod $(MODFILE) $(DESTDIR)$(ZIPILIBDIR)/$(ZIPIFILDIR)/zipi.init;

#*---------------------------------------------------------------------*/
#*    compile                                                          */
#*---------------------------------------------------------------------*/
.PHONY: compile compile2 link mkdir

COLOR		= yes

ifeq ($(COLOR),yes)
COLOR_STOP	= [0m
COLOR_CC	= [0m[1;30m
COLOR_OBJ	= [0m[1;31m
COLOR_DEST	= [0m[1;32m
endif

done = echo '$(COLOR_DEST)$(1)$(COLOR_STOP)...done.'
compile = echo '$(COLOR_CC)$(1)$(COLOR_STOP) $(2) $(3) $(COLOR_OBJ)$(4)$(COLOR_STOP)'; $(1) $(2) $(3) $(4)
compile2 = echo '$(COLOR_CC)$(1)$(COLOR_STOP) $(2) $(3) $(4) $(COLOR_OBJ)$(5)$(COLOR_STOP)'; $(1) $(2) $(3) $(4) $(5)
compile3 = echo '$(COLOR_CC)$(1)$(COLOR_STOP) $(5) $(COLOR_OBJ)$(6)$(COLOR_STOP) $(2) $(3) $(4)'; $(1) $(5) $(6) $(2) $(3) $(4)

heap = echo '$(COLOR_CC)$(1)$(COLOR_STOP) $(2) $(3) $(4) $(5) $(6) $(COLOR_DEST)$(7)$(COLOR_STOP)'; $(1) $(2) $(3) $(4) $(5) $(6) $(7)
link = echo '$(COLOR_CC)$(1)$(COLOR_STOP) $(2) $(3) $(4) $(5) $(COLOR_DEST)$(6)$(COLOR_STOP)'; $(1) $(2) $(3) $(4) $(5) $(6)

#*---------------------------------------------------------------------*/
#*    mkdir                                                            */
#*---------------------------------------------------------------------*/
mkdir:
	if [ ! -f $(DIR) ]; then \
	   if [ ! -d $(DIR) ]; then \
             $(MAKE) mkdir DIR=`dirname $(DIR)`; \
             mkdir $(DIR) && chmod $(MODDIR) $(DIR); \
           fi \
        fi
