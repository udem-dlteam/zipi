LD_LIBRARY_PATH=@BUILDLIBDIR@:$LD_LIBRARY_PATH
DYLD_LIBRARY_PATH=@BUILDLIBDIR@:$DYLD_LIBRARY_PATH

export LD_LIBRARY_PATH
export DYLD_LIBRARY_PATH

exec @BUILDBINDIR@/zpc.bigloo "$@"
