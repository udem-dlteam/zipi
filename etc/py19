#!/bin/bash

SCRIPT_DIR="$( cd "$( dirname "${BASH_SOURCE[0]}" )" >/dev/null 2>&1 && pwd )"
ETC_DIR="$SCRIPT_DIR/../etc"
LIB_DIR="$SCRIPT_DIR/../lib"
BIN_DIR="$SCRIPT_DIR/../bin"
RTS_DIR="$SCRIPT_DIR/../rts"
ZPC_DIR="$SCRIPT_DIR/../zpc"
PYC_DIR="$SCRIPT_DIR/../pyc"
if [ -z "$GAMBIT_DIR" ]; then
    GAMBIT_DIR="/usr/local/Gambit"
fi

$GAMBIT_DIR/bin/gsi -:~~=$GAMBIT_DIR,search=$SCRIPT_DIR,search=$PYC_DIR,darR-,t8,f8,-8 \
-e "(define (zipi-etc-dir) \"$ETC_DIR\")" \
-e "(define (zipi-lib-dir) \"$LIB_DIR\")" \
-e "(define (zipi-bin-dir) \"$BIN_DIR\")" \
-e "(define (zipi-rts-dir) \"$RTS_DIR\")" \
-e "(##import bigloo)" \
$PYC_DIR/ast.bgl \
-e "(##include \"$PYC_DIR/walk.sch\")" \
-e "(##include \"$PYC_DIR/new.sch\")" \
-e "(##include \"$PYC_DIR/sexp.scm\")" \
$PYC_DIR/symbol.bgl \
$PYC_DIR/symbol.scm \
$PYC_DIR/return.bgl \
$PYC_DIR/return.scm \
$PYC_DIR/locals.bgl \
$PYC_DIR/locals.scm \
$PYC_DIR/super.scm \
-e "(##include \"$RTS_DIR/hclass.bgl\")" \
-e "(##include \"$RTS_DIR/hclass.scm\")" \
-e "(##include \"$RTS_DIR/object.gambit\")" \
-e "(##include \"$RTS_DIR/object.scm\")" \
-e "(##include \"$RTS_DIR/iterator.bgl\")" \
-e "(##include \"$RTS_DIR/iterator.scm\")" \
$PYC_DIR/scheme.bgl \
$PYC_DIR/scheme.scm \
$PYC_DIR/break.bgl \
$PYC_DIR/break.scm \
$PYC_DIR/generator.bgl \
$PYC_DIR/generator.scm \
$PYC_DIR/cps.bgl \
$PYC_DIR/cps.scm \
$PYC_DIR/javascript.bgl \
$PYC_DIR/javascript.scm \
$PYC_DIR/dump.bgl \
$PYC_DIR/dump.scm \
$ZPC_DIR/main.bgl \
$ZPC_DIR/main.scm \
$PYC_DIR/compile.bgl \
$PYC_DIR/compile.scm \
$PYC_DIR/parse.bgl \
$PYC_DIR/parse.scm \
$ZPC_DIR/main-gambit.scm \
$*
