;*---------------------------------------------------------------------*/
;*    Library                                                          */
;*---------------------------------------------------------------------*/
(declare-library! 'zipi
		  :version "@RELEASE@"
		  :module-init '__py_object
		  :module-eval '__py_make_lib)

;*---------------------------------------------------------------------*/
;*    Link option                                                      */
;*---------------------------------------------------------------------*/
(cond-expand
   (bigloo-compile
    (set! *additional-bigloo-libraries* *additional-bigloo-libraries*))
   (bigloo-eval
    #unspecified))

;*---------------------------------------------------------------------*/
;*    & ...                                                            */
;*---------------------------------------------------------------------*/
(define-macro (& name)
   `',(string->symbol name))


