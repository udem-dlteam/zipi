;*    -------------------------------------------------------------    */
;*    ZIPI init file.                                                   */
;*=====================================================================*/

;*---------------------------------------------------------------------*/
;*    Library                                                          */
;*---------------------------------------------------------------------*/
(declare-library! 'zipi
		  :version "@RELEASE@"
		  :module-init '__zipi_compile
		  :module-eval '__zipi_makelib
		  :class-eval "bigloo.zipi.make_lib")

;*---------------------------------------------------------------------*/
;*    Link option                                                      */
;*---------------------------------------------------------------------*/
(cond-expand
   (bigloo-compile
    (set! *additional-bigloo-libraries* *additional-bigloo-libraries*))
   (bigloo-eval
    #unspecified))
