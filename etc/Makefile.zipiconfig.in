#*    The autoconf Makefile skeleton for ZIPI.                         */
#*=====================================================================*/

#*---------------------------------------------------------------------*/
#*    The version                                                      */
#*---------------------------------------------------------------------*/
ZIPIRELEASE	= @RELEASE@
ZIPIDEVEL	= @DEVEL@
ZIPIBRANCH	= @BRANCH@
ZIPIDATE	= @DATE@
ZIPIBUILDID	= @BUILDID@

ZIPISYSTEMS	= @SYSTEMS@

#*---------------------------------------------------------------------*/
#*    Tools, and misc configuration                                    */
#*---------------------------------------------------------------------*/
MODFILE		= 644
MODDIR		= 755
MODEXE		= 755

INSTALL		= @INSTALL@

#*---------------------------------------------------------------------*/
#*    Compilation flags                                                */
#*---------------------------------------------------------------------*/
DEBUG		= @DEBUG@
BCFLAGS		= @BCFLAGS@ -srfi ZIPI-$(LINK) $(EFLAGS)
BLDFLAGS	= @BLDFLAGS@
BTFLAGS		= @BTFLAGS@
BCFLAGSDEV	= @BCFLAGSDEV@
BCFLAGSRTS	= @BCFLAGSRTS@
FFLAGS		= @FFLAGS@
BLFLAGS         = @BLFLAGS@ $(BLIBFLAGS)
BJVMFLAGS	= @BCFLAGS@ -jvm $(EFLAGS)
BLJVMFLAGS      = @BLFLAGS@ -jvm-purify -unsafe
BEJVMFLAGS	= -jvm-jar
BHFLAGS		= @BHFLAGS@ -q -mkaddheap -mkaddlib $(EFLAGS)
BJFLAGS		= -j
CCFLAGS		= @CCFLAGS@
HFLAGS		= @HFLAGS@ --reset-bigloo-options --bigloo=$(BIGLOO) --bigloo-lib-dir=$(BIGLOOLIBDIR) --share-dir $(BUILDSHAREDIR) $(EFLAGS) --

BIGLOOPTHLIBS	= @BIGLOOPTHLIBS@
BIGLOOPTHLIBU	= @BIGLOOPTHLIBU@
BIGLOOSSLLIBS	= @BIGLOOSSLLIBS@
BIGLOOSSLLIBU	= @BIGLOOSSLLIBU@

BSCM2JSFLAGS	= @BSCM2JSFLAGS@
BZIPICFLAGS	= @BZIPICFLAGS@

#*---------------------------------------------------------------------*/
#*    Linking                                                          */
#*---------------------------------------------------------------------*/
BGLCLOSELIBS_S	= $(BIGLOOPTHLIBS) \
                  $(BIGLOOSSLLIBS) \
                  @BGLCLOSELIBS_S@

BGLCLOSELIBS_U	= $(BIGLOOPTHLIBU) \
                  $(BIGLOOSSLLIBU) \
                  @BGLCLOSELIBS_U@

#*---------------------------------------------------------------------*/
#*    Build                                                            */
#*---------------------------------------------------------------------*/
BUILDDIR	= @BUILDDIR@
BUILDETCDIR	= @BUILDETCDIR@
BUILDBINDIR	= @BUILDBINDIR@
BUILDLIBDIR	= @BUILDLIBDIR@
BUILDSHAREDIR	= @BUILDSHAREDIR@

BUILDSPECIFIC   = @BUILDSPECIFIC@
INSTALLSPECIFIC = @INSTALLSPECIFIC@

DISTRIBDIR	= @DISTRIBDIR@
REPODIR		= @REPODIR@

#*---------------------------------------------------------------------*/
#*    Destinations                                                     */
#*---------------------------------------------------------------------*/
ZIPIPREFIX	= @PREFIX@
ZIPIETCDIR	= @ETCDIR@
ZIPIBINDIR	= @BINDIR@
ZIPILIBDIR	= @LIBDIR@
ZIPISHAREDIR	= @SHAREDIR@
ZIPIMANDIR	= @MANDIR@
ZIPIWEBLETSDIR	= @WEBLETSDIR@
ZIPICONTRIBSDIR	= @CONTRIBSDIR@
ZIPIDOCDIR	= @DOCDIR@

ZIPIFILDIR	= ZIPI/$(ZIPIRELEASE)
ZIPIDEMOSDIR	= $(ZIPISHAREDIR)/demos

#*---------------------------------------------------------------------*/
#*    Runtime system                                                   */
#*---------------------------------------------------------------------*/
RTSCONFIG	= @RTSCONFIG@

#*---------------------------------------------------------------------*/
#*    REPOSITORY                                                       */
#*---------------------------------------------------------------------*/
ZIPITMPDIR	= /tmp
ZIPIDISTRIBDIR	= @ZIPIDISTRIBDIR@

#*---------------------------------------------------------------------*/
#*    compile                                                          */
#*---------------------------------------------------------------------*/
.PHONY: compile compile2 link mkdir

COLOR		= yes

ifeq ($(COLOR),yes)
COLOR_STOP	= [0m
COLOR_CC	= [0m[1;30m
COLOR_OBJ	= [0m[1;31m
COLOR_DEST	= [0m[1;32m
endif

done = echo '$(COLOR_DEST)$(1)$(COLOR_STOP)...done.'
compile = echo '$(COLOR_CC)$(1)$(COLOR_STOP) $(2) $(3) $(COLOR_OBJ)$(4)$(COLOR_STOP)'; $(1) $(2) $(3) $(4)
compile2 = echo '$(COLOR_CC)$(1)$(COLOR_STOP) $(2) $(3) $(4) $(COLOR_OBJ)$(5)$(COLOR_STOP)'; $(1) $(2) $(3) $(4) $(5)
compile3 = echo '$(COLOR_CC)$(1)$(COLOR_STOP) $(5) $(COLOR_OBJ)$(6)$(COLOR_STOP) $(2) $(3) $(4)'; $(1) $(5) $(6) $(2) $(3) $(4)

heap = echo '$(COLOR_CC)$(1)$(COLOR_STOP) $(2) $(3) $(4) $(5) $(6) $(COLOR_DEST)$(7)$(COLOR_STOP)'; $(1) $(2) $(3) $(4) $(5) $(6) $(7)
link = echo '$(COLOR_CC)$(1)$(COLOR_STOP) $(2) $(3) $(4) $(5) $(COLOR_DEST)$(6)$(COLOR_STOP)'; $(1) $(2) $(3) $(4) $(5) $(6)

#*---------------------------------------------------------------------*/
#*    mkdir                                                            */
#*---------------------------------------------------------------------*/
mkdir:
	if [ ! -f $(DIR) ]; then \
	   if [ ! -d $(DIR) ]; then \
             $(MAKE) mkdir DIR=`dirname $(DIR)`; \
             mkdir $(DIR) && chmod $(MODDIR) $(DIR); \
           fi \
        fi
