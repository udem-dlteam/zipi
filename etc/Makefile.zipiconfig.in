#*    The autoconf Makefile skeleton for ZIPI.                         */
#*=====================================================================*/

#*---------------------------------------------------------------------*/
#*    The version                                                      */
#*---------------------------------------------------------------------*/
ZIPIRELEASE	= @RELEASE@
ZIPIBRANCH	= @BRANCH@
ZIPIDATE	= @DATE@
ZIPIBUILDID	= @BUILDID@

ZIPISYSTEMS	= @SYSTEMS@

#*---------------------------------------------------------------------*/
#*    Compilers, tools, and misc configuration                         */
#*---------------------------------------------------------------------*/
# Compilers
BIGLOO          = @BIGLOO@
BACKEND		= native

#*---------------------------------------------------------------------*/
#*    Tools, and misc configuration                                    */
#*---------------------------------------------------------------------*/
MODFILE		= 644
MODDIR		= 755
MODEXE		= 755

INSTALL		= @INSTALL@

#*---------------------------------------------------------------------*/
#*    Build                                                            */
#*---------------------------------------------------------------------*/
BUILDDIR	= @BUILDDIR@
BUILDETCDIR	= @BUILDETCDIR@
BUILDBINDIR	= @BUILDBINDIR@
BUILDLIBDIR	= @BUILDLIBDIR@

BUILDSPECIFIC   = @BUILDSPECIFIC@
INSTALLSPECIFIC = @INSTALLSPECIFIC@

#*---------------------------------------------------------------------*/
#*    Destinations                                                     */
#*---------------------------------------------------------------------*/
ZIPIPREFIX	= @PREFIX@
ZIPIETCDIR	= @ETCDIR@
ZIPIBINDIR	= @BINDIR@
ZIPILIBDIR	= @LIBDIR@
ZIPIFILDIR	= zipi/$(ZIPIRELEASE)

#*---------------------------------------------------------------------*/
#*    REPOSITORY                                                       */
#*---------------------------------------------------------------------*/
ZIPITMPDIR	= /tmp

