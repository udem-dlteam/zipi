#*    The autoconf Makefile skeleton for ZIPI.                         */
#*=====================================================================*/

#*---------------------------------------------------------------------*/
#*    The version                                                      */
#*---------------------------------------------------------------------*/
ZIPIRELEASE	= @RELEASE@
ZIPIVERSION = @VERSION@
ZIPIBRANCH	= @BRANCH@
ZIPIDATE	= @DATE@
ZIPIBUILDID	= @BUILDID@
PYTHONVERSION = @PYTHONVERSION@

ZIPICONFIGUREARGS = @CONFIGUREARGS@

DEFAULT_SCHEME_SYSTEM = @DEFAULT_SCHEME_SYSTEM@
ZIPISYSTEMS	= @SYSTEMS@

#*---------------------------------------------------------------------*/
#*    Compilers, tools, and misc configuration                         */
#*---------------------------------------------------------------------*/
# Compilers
BIGLOO    = @BIGLOO@
BACKEND		= native

BUILDGAMBIT         = @BUILDGAMBIT@
BUILDGAMBITCOMPILER = @BUILDGAMBITCOMPILER@
BUILDGAMBITROOT     = @BUILDGAMBITROOT@
GAMBIT         = @GAMBIT@
GAMBITCOMPILER = @GAMBITCOMPILER@
GAMBITROOT     = @GAMBITROOT@
BUILDSCHEMESCRIPT = @BUILDSCHEMESCRIPT@

#*---------------------------------------------------------------------*/
#*    Tools, and misc configuration                                    */
#*---------------------------------------------------------------------*/
MODFILE		= 644
MODDIR		= 755
MODEXE		= 755

INSTALL		= @INSTALL@

#*---------------------------------------------------------------------*/
#*    Build                                                            */
#*---------------------------------------------------------------------*/
BUILDDIR	= @BUILDDIR@
BUILDETCDIR	= @BUILDETCDIR@
BUILDBINDIR	= @BUILDBINDIR@
BUILDLIBDIR	= @BUILDLIBDIR@
BUILDRTSDIR	= @BUILDRTSDIR@
BUILDPYCDIR	= @BUILDPYCDIR@
BUILDZPCDIR	= @BUILDZPCDIR@
BUILDSTDLIBDIR	= @BUILDSTDLIBDIR@
BUILDDEPDIR	= @BUILDDEPDIR@
BUILDBUILDDEPDIR	= @BUILDBUILDDEPDIR@

BUILDSPECIFIC   = @BUILDSPECIFIC@
INSTALLSPECIFIC = @INSTALLSPECIFIC@

BUILDPYTHON	     = @BUILDPYTHON@
PYTHON	         = @PYTHON@

#*---------------------------------------------------------------------*/
#*    Destinations                                                     */
#*---------------------------------------------------------------------*/
INSTALLBINDIR = @INSTALLBINDIR@
ZIPIPREFIX	= @PREFIX@
ZIPIROOT    = @ZIPIROOT@
ZIPIETCDIR	= @ETCDIR@
ZIPIPYCDIR	= @PYCDIR@
ZIPIBINDIR	= @BINDIR@
ZIPIZPCDIR	= @ZPCDIR@
ZIPISTDLIBDIR	= @STDLIBDIR@
ZIPILIBDIR	= @LIBDIR@
ZIPIRTSDIR  = @RTSDIR@
ZIPIDEPDIR  = @DEPDIR@
ZIPIFILDIR	= zipi/$(ZIPIRELEASE)

ZIPICACHE   = @ZIPICACHE@

#*---------------------------------------------------------------------*/
#*    REPOSITORY                                                       */
#*---------------------------------------------------------------------*/
ZIPITMPDIR	= /tmp
