#*    The autoconf Makefile skeleton for ZIPI.                         */
#*=====================================================================*/

#*---------------------------------------------------------------------*/
#*    The version                                                      */
#*---------------------------------------------------------------------*/
ZIPIRELEASE	= @RELEASE@
ZIPIDEVEL	= @DEVEL@
ZIPIBRANCH	= @BRANCH@
ZIPIDATE	= @DATE@
ZIPIBUILDID	= @BUILDID@

ZIPISYSTEMS	= @SYSTEMS@

#*---------------------------------------------------------------------*/
#*    Compilers, tools, and misc configuration                         */
#*---------------------------------------------------------------------*/
# Compilers
BIGLOO          = @BIGLOO@

#*---------------------------------------------------------------------*/
#*    Tools, and misc configuration                                    */
#*---------------------------------------------------------------------*/
MODFILE		= 644
MODDIR		= 755
MODEXE		= 755

INSTALL		= @INSTALL@

#*---------------------------------------------------------------------*/
#*    Build                                                            */
#*---------------------------------------------------------------------*/
BUILDDIR	= @BUILDDIR@
BUILDETCDIR	= @BUILDETCDIR@
BUILDBINDIR	= @BUILDBINDIR@
BUILDLIBDIR	= @BUILDLIBDIR@
BUILDSHAREDIR	= @BUILDSHAREDIR@

BUILDSPECIFIC   = @BUILDSPECIFIC@
INSTALLSPECIFIC = @INSTALLSPECIFIC@

DISTRIBDIR	= @DISTRIBDIR@
REPODIR		= @REPODIR@

#*---------------------------------------------------------------------*/
#*    Destinations                                                     */
#*---------------------------------------------------------------------*/
ZIPIPREFIX	= @PREFIX@
ZIPIETCDIR	= @ETCDIR@
ZIPIBINDIR	= @BINDIR@
ZIPILIBDIR	= @LIBDIR@
ZIPISHAREDIR	= @SHAREDIR@
ZIPIMANDIR	= @MANDIR@
ZIPIWEBLETSDIR	= @WEBLETSDIR@
ZIPICONTRIBSDIR	= @CONTRIBSDIR@
ZIPIDOCDIR	= @DOCDIR@

ZIPIIFILDIR	= zipi/$(ZIPIRELEASE)
ZIIPIDEMOSDIR	= $(ZIPISHAREDIR)/demos

#*---------------------------------------------------------------------*/
#*    Runtime system                                                   */
#*---------------------------------------------------------------------*/
RTSCONFIG	= @RTSCONFIG@

#*---------------------------------------------------------------------*/
#*    REPOSITORY                                                       */
#*---------------------------------------------------------------------*/
ZIPITMPDIR	= /tmp
ZIPIDISTRIBDIR	= @ZIPIDISTRIBDIR@

