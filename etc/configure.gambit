#!/bin/sh

#*---------------------------------------------------------------------*/
#*    Gambit configuration                                             */
#*    -------------------------------------------------------------    */
#*    The Gambit interpreter (gsi) and compiler (gsc) are, in order:   */
#*      - GSI/GSC (environment or ./configure GSI=... GSC=...);        */
#*      - --gambitroot=dir (uses dir/bin/gsi and dir/bin/gsc);         */
#*      - the version pinned in the Makefile ("make gambit").          */
#*---------------------------------------------------------------------*/
echo "*** Configuring Gambit"

if [ "$gsi " = " " ] && [ "$gsc " = " " ]; then
  if [ "$gambitroot " != " " ]; then
    gsi=$gambitroot/bin/gsi
    gsc=$gambitroot/bin/gsc
  else
    gsi=$deps_gambit_prefix/bin/gsi
    gsc=$deps_gambit_prefix/bin/gsc
    if [ ! -f $deps_gambit_prefix/.built ]; then
      install_dependency gambit
    else
      echo "***   Using Gambit $deps_gambit_version from $deps_gambit_prefix"
    fi
  fi
else
  # When only one of GSI/GSC is given, look for the other one next to it
  if [ "$gsi " = " " ]; then
    gsi=`dirname \`resolve_tool $gsc\``/gsi
  elif [ "$gsc " = " " ]; then
    gsc=`dirname \`resolve_tool $gsi\``/gsc
  fi
fi

buildgambit=`resolve_tool $gsi` || {
  echo "***   ERROR: cannot find the Gambit interpreter '$gsi'" >&2; exit 1; }
buildgambitcompiler=`resolve_tool $gsc` || {
  echo "***   ERROR: cannot find the Gambit compiler '$gsc'" >&2; exit 1; }

# The Gambit installation directory (i.e., "~~")
buildgambitroot=`$buildgambit -e '(display (path-strip-trailing-directory-separator (path-expand "~~")))'` || {
  echo "***   ERROR: '$buildgambit' does not run" >&2; exit 1; }

echo "***   gsi: $buildgambit (`$buildgambit -v | sed -e 's/ .*//'`)"
echo "***   gsc: $buildgambitcompiler"

# The installed Zipi uses the same Gambit
gambitroot=$buildgambitroot
gambit=$buildgambit
gambitcompiler=$buildgambitcompiler
