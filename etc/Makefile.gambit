.PHONY: install.system.gambit

#*---------------------------------------------------------------------*/
#*    Compilers, tools, and misc configuration                         */
#*---------------------------------------------------------------------*/
# Compilers
GAMBIT = @GAMBIT@

install.gambit:
	ln -sf $(ZIPIBINDIR)/zipi.gambit /usr/local/bin/zipi-gambit
	ln -sf $(ZIPIBINDIR)/zipi.gambit /usr/local/bin/zipi-$(PYTHONVERSION)-gambit

install.system.gambit:
