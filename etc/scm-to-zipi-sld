#!/bin/bash
target=${@:$#}
sources=${@:1:$#-1}

PROCEDURES=$(cat $sources | pcregrep -io1 '\(define (\([^)]*\))')
MACROS=$(cat $sources | pcregrep -io1 '\(define (\([^)]*\))')

SLD_LINENO=$(awk '/@SLD_NAMES@/{ print NR; exit }' $target)

awk "NR < $SLD_LINENO" $target
echo -e "${PROCEDURES}\n${MACROS}"
awk "NR > $SLD_LINENO" $target
