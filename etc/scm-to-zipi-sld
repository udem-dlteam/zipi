#!/bin/bash
target=${@:$#}
sources=${@:1:$#-1}

PROCEDURES=$(cat $sources | grep -oP '(?<=define \()[^\)\ ]*')
MACROS=$(cat $sources | grep -oP '(?<=define-macro \()[^\)\ ]*')

SLD_LINENO=$(awk '/@SLD_NAMES@/{ print NR; exit }' $target)

awk "NR < $SLD_LINENO" $target
echo -e "${PROCEDURES}\n${MACROS}"
awk "NR > $SLD_LINENO" $target
