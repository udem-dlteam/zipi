#!/bin/sh
#*=====================================================================*/
#*    serrano/prgm/project/zipi/etc/configure.bigloo                   */
#*    -------------------------------------------------------------    */
#*    Author      :  Manuel Serrano                                    */
#*    Creation    :  Tue Jul  2 07:46:27 2019                          */
#*    Last change :  Tue Nov 12 20:12:25 2019 (serrano)                */
#*    Copyright   :  2019-20 Manuel Serrano                            */
#*    -------------------------------------------------------------    */
#*    Bigloo specific configuration                                    */
#*=====================================================================*/

echo "configure bigloo..."

mode=$mode || "optimization"

link=dynamic
afile=bglafile
btags=bgltags
bdepend=bgldepend

bcflags="-O3 -fsharing -srfi bootstrap -L \$(BUILDLIBDIR) -srfi bigloo-compile"
blflags="-copt \$(CPICFLAGS) -L \$(BUILDLIBDIR) -srfi bigloo-compile"
bhflags=
btflags="-gtrace"
hflags="-O2"
bcflagsrts="-unsafe -safee"

if [ "$mode " = "debug " ]; then
  bcflags="-O2 -fsharing -L \$(BUILDLIBDIR) -srfi bigloo-compile"
  bcflagsrts="-safee -g"
  debug=yes
fi

bcflagsdev=""
bzipicflags=

zipisrfis="zipi-bigloo"

bglcloselibs=""

#*---------------------------------------------------------------------*/
#*    Private variables                                                */
#*---------------------------------------------------------------------*/
if [ "$USER " = "serrano " ]; then
  distribdir=$HOME/prgm/distrib
  repodir=$HOME/prgm/project/hop/repository
else
  distribdir=.
  repodir=.
fi

#*---------------------------------------------------------------------*/
#*    We are now able to set the correct value for cc since we know    */
#*    what Bigloo is.                                                  */
#*---------------------------------------------------------------------*/
if [ "$bigloolibdir " = " " ]; then
  bigloolibdir=`$bigloo -q -eval "(begin (print (bigloo-config 'library-directory)) (exit 0))"`
else
  bcflags="$bcflags -lib-dir $bigloolibdir"
fi

if [ "$cc " = " " ]; then
  cc=`$bigloo -lib-dir $bigloolibdir $bcflags -eval '(begin (print *cc*) (exit 0))'`
else
  bcflags="$bcflags -cc $cc"
fi

if [ "$ccflags " = " " ]; then
  ccflags=`grep '^CFLAGS=' $bigloolibdir/Makefile.config | sed 's/^[A-Z]*=//'`
  if [ "$mode " = "debug " ]; then
    ccflags=`echo $ccflags | sed 's/[-]O[0-9]//'`
  fi
  ccflags="$ccflags -I$bigloolibdir \$(CPICFLAGS) \$(CNANFLAGS)"
fi

if [ ! -f $bigloolibdir/Makefile.config ]; then
  echo "Bigloo not properly installed, file missing:" >&2;
  echo "  $bigloolibdir/Makefile.config" >&2;
  exit -1;
fi

#*---------------------------------------------------------------------*/
#*    Check that Bigloo compiles and binary runs                       */
#*---------------------------------------------------------------------*/
tmp=`$bigloo -eval '(begin (print (os-tmp)) (exit 0))'`
cat > $tmp/bigloo-test-zipi.scm <<EOF
(module test (main main))

(define (main args)
  (exit (-fx 1 (string->integer (cadr args)))))
EOF

$bigloo $tmp/bigloo-test-zipi.scm -o $tmp/bigloo-test-zipi || exit 1

$tmp/bigloo-test-zipi 1 || exit 1

rm -f $tmp/bigloo-test-zipi $tmp/bigloo-test-zipi.scm $tmp/bigloo-test-zipi.o

#*---------------------------------------------------------------------*/
#*    Check the Bigloo required libraries                              */
#*---------------------------------------------------------------------*/
if [ ! -f $bigloolibdir/web.heap ]; then
  echo "*** ERROR:configure:bigloo web." >&2;
  echo "" >&2;
  echo "This error is due to a bad Bigloo installation. It might be that" >&2;
  echo "you have installed Bigloo without the WEB support. Please" >&2;
  echo "check your Bigloo installation." >&2;
  echo "" >&2
  bglfail=true;
fi

if [ ! -f $bigloolibdir/multimedia.heap ]; then
  echo "*** ERROR:configure:bigloo multimedia." >&2;
  echo "" >&2;
  echo "This error is due to a bad Bigloo installation. It might be that" >&2;
  echo "you have installed Bigloo without the MULTIMEDIA support. Please" >&2;
  echo "check your Bigloo installation." >&2;
  echo "" >&2
  bglfail=true;
fi

#*---------------------------------------------------------------------*/
#*    Srfis                                                            */
#*---------------------------------------------------------------------*/
for srfi in $zipisrfis; do
    bcflags="$bcflags -srfi $srfi";
    bhflags="$bhflags -srfi $srfi";
done

#*---------------------------------------------------------------------*/
#*    rpath                                                            */
#*---------------------------------------------------------------------*/
if [ "$bldflags " = " " ]; then
  bldflags="-rpath \$(ZIPILIBDIR)/\$(ZIPIFILDIR)"
fi

#*---------------------------------------------------------------------*/
#*    Makefile.zipiconfig                                              */
#*---------------------------------------------------------------------*/
for file in Makefile.bigloo pyc.init zipi.init; do
  path=etc/$file

  rm -f $path 2> /dev/null
  echo "#* Automatically generated file (don't edit) */" > $path

  cat $path.in \
    | sed -e "s|@RELEASE@|$version|" \
          -e "s|@DATE@|$date|" \
          -e "s|@DEBUG@|$debug|" \
  	  -e "s|@SYSTEMS@|$systems|" \
          -e "s|@BINDIR@|$bindir|" \
          -e "s|@LIBDIR@|$libdir|" \
          -e "s|@PREFIX@|$prefix|" \
          -e "s|@ETCDIR@|$etcdir|" \
          -e "s|@RTSDIR@|$rtsdir|" \
          -e "s|@BUILDID@|$buildid|" \
          -e "s|@BUILDTAG@|$buildtag|" \
	  -e "s|@BUILDLIBDIR@|$buildlibdir|" \
          -e "s|@BIGLOO@|$bigloo|" \
          -e "s|@CCFLAGS@|$ccflags $ccflagsprofile $ccflagsdebug|" \
          -e "s|@INSTALL@|$install|" \
          -e "s|@BUILDDIR@|$PWD|" \
          -e "s|@LINK@|$link|" \
          -e "s|@BIGLOOLIBDIR@|$bigloolibdir|" \
          -e "s|@AFILE@|$afile|" \
          -e "s|@BTAGS@|$btags|" \
          -e "s|@BDEPEND@|$bdepend|" \
          -e "s|@BCFLAGS@|$bcflags $bcflagsprofile|" \
          -e "s|@BLDFLAGS@|$bldflags|" \
          -e "s|@BHFLAGS@|$bhflags|" \
          -e "s|@HFLAGS@|$hflags|" \
          -e "s|@BTFLAGS@|$btflags|" \
	  -e "s|@BLFLAGS@|$blflags|" \
          -e "s|@BCFLAGSRTS@|$bcflagsrts|" \
          -e "s|@EXTRALIBS@|$extralibs|" \
          -e "s|@BIGLOOEXTRALIBS@|$bglextralibs|" \
          -e "s|@BGLCLOSELIBS@|$bglcloselibs|" \
          -e "s|@BCFLAGSDEV@|$bcflagsdev|" \
          -e "s|@BZIPICFLAGS@|$bzipicflags|" \
	  -e "s|@ZIPIDISTRIBDIR@|$distribdir|" \
   	>> $path
done

for file in pyc.init zipi.init; do
  cat etc/$file \
    | sed -e "s|#[*] Automatically|;* Automatically|" \
    > $buildlibdir/$file

  rm etc/$file
done

# rts/hash/hash.scm
echo ";; rts/hash/hash.scm" >> $buildlibdir/zipi.init
echo "(eval '(begin" >> $buildlibdir/zipi.init
cat rts/hash/hash.scm >> $buildlibdir/zipi.init
echo "))" >> $buildlibdir/zipi.init

# rts/config/config.scm
echo ";; rts/config/config.scm" >> $buildlibdir/zipi.init
echo "(eval '(begin" >> $buildlibdir/zipi.init
cat rts/config/config.scm >> $buildlibdir/zipi.init
echo "))" >> $buildlibdir/zipi.init

# rts/bigloo/rts-call.sch
echo ";; rts/bigloo/call.sch" >> $buildlibdir/zipi.init
cat rts/bigloo/call_expd.sch >> $buildlibdir/zipi.init

# rts/bigloo/constants.sch
echo ";; rts/bigloo/constants.sch" >> $buildlibdir/zipi.init
cat rts/bigloo/constants_expd.sch >> $buildlibdir/zipi.init

# rts/bigloo/expanders.sch
cat rts/bigloo/expanders.sch >> $buildlibdir/zipi.init

echo "(zipi-install-expanders!)" >> $buildlibdir/zipi.init

pysexppp="['cat', '-']"
