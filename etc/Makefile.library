#*    -------------------------------------------------------------    */
#*    The common Makefile for building libraries                       */
#*=====================================================================*/

#*---------------------------------------------------------------------*/
#*    Compilers, Tools and Destinations                                */
#*---------------------------------------------------------------------*/
# The heap file
HEAPFILE	= $(BUILDLIBDIR)/$(TARGETNAME).heap
# the library version
LIBVERSION	= $(ZIPIRELEASE)

RPATH		+= $(ZIPILIBDIR)/$(ZIPIFILDIR)

#*---------------------------------------------------------------------*/
#*    Suffixes                                                         */
#*---------------------------------------------------------------------*/
.SUFFIXES:
.SUFFIXES: .scm .o .hop .js .bgl .py

#*---------------------------------------------------------------------*/
#*    The implicit rules                                               */
#*---------------------------------------------------------------------*/
o/%.o: %.bgl %.scm
	@ $(call compile2,$(BIGLOO),$(BCFLAGS),$(BLFLAGS),-c,$< $(<:%.bgl=%.scm) -o $@)

o/%.o: %.scm
	@ $(call compile2,$(BIGLOO),$(BCFLAGS),$(BLFLAGS),-c,$< -o $@)

%.scm: %.hop
	@ $(call compile3,$(ZIPIC),$(HFLAGS),$(BCFLAGS),$(BLFLAGS),-s,$< -o $@)

o/%.o: %.js
	@ $(call compile3,$(ZIPIC),$(HFLAGS),$(BCFLAGS),$(BLFLAGS),$(BZIPICFLAGS) -c --js-module-name __nodejs_$* --js-module-path $*,$< -o $@)

#*---------------------------------------------------------------------*/
#*    The heap construction                                            */
#*---------------------------------------------------------------------*/
.PHONY: heap-c

heap-c: .afile $(HEAPFILE)

$(HEAPFILE): make_lib.scm .afile
	@ $(RM) -f $(HEAPFILE)
	@ $(call heap,$(BIGLOO),$(BCFLAGS),$(BHFLAGS),$<,-heap-library $(TARGETNAME),-addheap, $@)

#*---------------------------------------------------------------------*/
#*    lib                                                              */
#*---------------------------------------------------------------------*/
.PHONY: lib-c

-include $(BIGLOOLIBDIR)/Makefile.misc

lib:

#*--- lib-c -----------------------------------------------------------*/
lib-c: $(TAGS) o lib-c-static lib-c-shared

o:
	mkdir -p $@

lib-c-static: .afile $(OBJECTS)
	$(MAKE) lib-c-static-sans-afile

lib-c-static-sans-afile: \
   $(BUILDLIBDIR)/lib$(TARGETNAME)_s-$(ZIPIRELEASE).a \
   $(BUILDLIBDIR)/lib$(TARGETNAME)_u-$(ZIPIRELEASE).a \
   $(BUILDLIBDIR)/lib$(TARGETNAME)_es-$(ZIPIRELEASE).a \
   $(BUILDLIBDIR)/lib$(TARGETNAME)_eu-$(ZIPIRELEASE).a

# lib-c-shared depends on lib-c-static only to force the compilation
# order when invoking make with --jobs N
lib-c-shared: lib-c-static
	@ if [ "$(SHAREDLIBRARYSUPPORT)" = "yes" ]; then \
	   if [ "$(THREADS)" = "yes" ]; then \
             $(MAKE) lib-c_mt.$(SHAREDSUFFIX); \
           else \
             $(MAKE) lib-c_st.$(SHAREDSUFFIX); \
           fi \
        fi

# we have 8 versions of each library:
# safe and unsafe, runtime and evaluation time
# evaltime libs have to link to runtime libs, but with matching safeness
lib-c_st.$(SHAREDSUFFIX):
	@ $(MAKE) one-lib-c.$(SHAREDSUFFIX) LIBSUFFIX=_s LIBSUFFIXTHREAD=
	@ $(MAKE) one-lib-c.$(SHAREDSUFFIX) LIBSUFFIX=_es LIBSUFFIXTHREAD=
	@ $(MAKE) one-lib-c.$(SHAREDSUFFIX) LIBSUFFIX=_u LIBSUFFIXTHREAD=
	@ $(MAKE) one-lib-c.$(SHAREDSUFFIX) LIBSUFFIX=_eu LIBSUFFIXTHREAD=

lib-c_mt.$(SHAREDSUFFIX):
	@ $(MAKE) one-lib-c.$(SHAREDSUFFIX) LIBSUFFIX=_s LIBSUFFIXTHREAD=_mt
	@ $(MAKE) one-lib-c.$(SHAREDSUFFIX) LIBSUFFIX=_es LIBSUFFIXTHREAD=_mt
	@ $(MAKE) one-lib-c.$(SHAREDSUFFIX) LIBSUFFIX=_u LIBSUFFIXTHREAD=_mt
	@ $(MAKE) one-lib-c.$(SHAREDSUFFIX) LIBSUFFIX=_eu LIBSUFFIXTHREAD=_mt

one-lib-c.$(SHAREDSUFFIX): \
  $(BUILDLIBDIR)/lib$(TARGETNAME)$(LIBSUFFIX)$(LIBSUFFIXTHREAD)-$(ZIPIRELEASE).$(SHAREDSUFFIX)   

$(BUILDLIBDIR)/lib$(TARGETNAME)_s$(LIBSUFFIXTHREAD)-$(ZIPIRELEASE).$(SHAREDSUFFIX): \
   .afile $(OBJECTS)
	$(MAKE) bigloo-shared-lib \
           LDINSTALLNAMEDIR=$(DESTDIR)$(ZIPILIBDIR)/$(ZIPIFILDIR) \
           BOOTLIBDIR=$(BUILDLIBDIR) \
           FORCELD=true \
           LIBDEST=$@ \
           LIBSUFFIXTHREAD=$(LIBSUFFIXTHREAD) \
           SONAME=lib$(TARGETNAME)_s$(LIBSUFFIXTHREAD)-$(ZIPIRELEASE).$(SHAREDSUFFIX) \
           LDOPTS="-L$(BUILDLIBDIR) $(LDZIPIOPTS) $(LDOPTS)" \
           EXTRALIBS="$(EXTRALIBS) $(ZIPIEXTRALIBS)" \
           BIGLOOEXTRALIBS="$(ZIPIBIGLOOEXTRALIBS)" \
           BIGLOOAPPLIBS="$(ZIPIAPPLIBS)" \
           APPRELEASE=$(ZIPIRELEASE)
	@ $(call done,$@)

$(BUILDLIBDIR)/lib$(TARGETNAME)_u$(LIBSUFFIXTHREAD)-$(ZIPIRELEASE).$(SHAREDSUFFIX): \
   .afile $(OBJECTS)
	$(MAKE) bigloo-shared-lib \
           LDINSTALLNAMEDIR=$(DESTDIR)$(ZIPILIBDIR)/$(ZIPIFILDIR) \
           BOOTLIBDIR=$(BUILDLIBDIR) \
           FORCELD=true \
           LIBDEST=$@ \
           LIBSUFFIXTHREAD=$(LIBSUFFIXTHREAD) \
           SONAME=lib$(TARGETNAME)_u$(LIBSUFFIXTHREAD)-$(ZIPIRELEASE).$(SHAREDSUFFIX) \
           LDOPTS="-L$(BUILDLIBDIR) $(LDZIPIOPTS) $(LDOPTS)" \
           EXTRALIBS="$(EXTRALIBS) $(ZIPIEXTRALIBS)" \
           BIGLOOEXTRALIBS="$(ZIPIBIGLOOEXTRALIBS)" \
           BIGLOOAPPLIBS="$(ZIPIAPPLIBS)" \
           APPRELEASE=$(ZIPIRELEASE)
	@ $(call done,$@)

$(BUILDLIBDIR)/lib$(TARGETNAME)_es$(LIBSUFFIXTHREAD)-$(ZIPIRELEASE).$(SHAREDSUFFIX): $(BUILDLIBDIR)/lib$(TARGETNAME)_s$(LIBSUFFIXTHREAD)-$(ZIPIRELEASE).$(SHAREDSUFFIX)
	$(MAKE) bigloo-shared-lib \
           OBJECTS="$(EOBJECTS)" \
           FORCELD=true \
           LIBDEST=$@ \
           LDINSTALLNAMEDIR=$(DESTDIR)$(ZIPILIBDIR)/$(ZIPIFILDIR) \
           LIBSUFFIXTHREAD=$(LIBSUFFIXTHREAD) \
           SONAME=lib$(TARGETNAME)_es$(LIBSUFFIXTHREAD)-$(ZIPIRELEASE).$(SHAREDSUFFIX) \
           LDOPTS="-L$(BUILDLIBDIR) -L$(BOOTLIBDIR) $(LDZIPIOPTS) $(LDOPTS)" \
           LIBSUFFIX=_s \
           EXTRALIBS="$(EXTRALIBS) $(ZIPIEXTRALIBS)" \
           BIGLOOEXTRALIBS="$(ZIPIBIGLOOEXTRALIBS)" \
           BIGLOOAPPLIBS="$(ZIPIAPPLIBS) $(TARGETNAME)" \
           APPRELEASE=$(ZIPIRELEASE)
	@ $(call done,$@)

$(BUILDLIBDIR)/lib$(TARGETNAME)_eu$(LIBSUFFIXTHREAD)-$(ZIPIRELEASE).$(SHAREDSUFFIX): $(BUILDLIBDIR)/lib$(TARGETNAME)_u$(LIBSUFFIXTHREAD)-$(ZIPIRELEASE).$(SHAREDSUFFIX)
	$(MAKE) bigloo-shared-lib \
           OBJECTS="$(EOBJECTS)" \
           FORCELD=true \
           LIBDEST=$@ \
           LDINSTALLNAMEDIR=$(DESTDIR)$(ZIPILIBDIR)/$(ZIPIFILDIR) \
           SONAME=lib$(TARGETNAME)_eu$(LIBSUFFIXTHREAD)-$(ZIPIRELEASE).$(SHAREDSUFFIX) \
           LIBSUFFIXTHREAD=$(LIBSUFFIXTHREAD) \
           LDOPTS="-L$(BUILDLIBDIR) -L$(BOOTLIBDIR) $(LDZIPIOPTS) $(LDOPTS)" \
           LIBSUFFIX=_u \
           EXTRALIBS="$(EXTRALIBS) $(ZIPIEXTRALIBS)" \
           BIGLOOEXTRALIBS="$(ZIPIBIGLOOEXTRALIBS)" \
           BIGLOOAPPLIBS="$(ZIPIAPPLIBS) $(TARGETNAME)" \
           APPRELEASE=$(ZIPIRELEASE)
	@ $(call done,$@)

# and the static versions
$(BUILDLIBDIR)/lib$(TARGETNAME)_s-$(ZIPIRELEASE).a: .afile $(OBJECTS)
	@ $(RM) -f $(BUILDLIBDIR)/lib$(TARGETNAME)_s-$(ZIPIRELEASE).a
	@ $(AR) $(ARFLAGS) $(BUILDLIBDIR)/lib$(TARGETNAME)_s-$(ZIPIRELEASE).a $(OBJECTS)
	@ $(RANLIB) $(BUILDLIBDIR)/lib$(TARGETNAME)_s-$(ZIPIRELEASE).a
	@ $(call done,$@)

$(BUILDLIBDIR)/lib$(TARGETNAME)_u-$(ZIPIRELEASE).a: \
   $(BUILDLIBDIR)/lib$(TARGETNAME)_s-$(ZIPIRELEASE).a
	@ cd $(BUILDLIBDIR) && \
        $(RM) -f lib$(TARGETNAME)_u-$(ZIPIRELEASE).a && \
        $(LN_S) lib$(TARGETNAME)_s-$(ZIPIRELEASE).a lib$(TARGETNAME)_u-$(ZIPIRELEASE).a
	@ $(call done,$@)

$(BUILDLIBDIR)/lib$(TARGETNAME)_es-$(ZIPIRELEASE).a: $(EOBJECTS)
	@ $(AR) $(ARFLAGS) $(BUILDLIBDIR)/lib$(TARGETNAME)_es-$(ZIPIRELEASE).a $(EOBJECTS)
	@ $(RANLIB) $(BUILDLIBDIR)/lib$(TARGETNAME)_es-$(ZIPIRELEASE).a
	@ $(call done,$@)

$(BUILDLIBDIR)/lib$(TARGETNAME)_eu-$(ZIPIRELEASE).a: \
   $(BUILDLIBDIR)/lib$(TARGETNAME)_es-$(ZIPIRELEASE).a
	@ cd $(BUILDLIBDIR) && \
        $(RM) -f lib$(TARGETNAME)_eu-$(ZIPIRELEASE).a && \
        $(LN_S) lib$(TARGETNAME)_es-$(ZIPIRELEASE).a lib$(TARGETNAME)_eu-$(ZIPIRELEASE).a
	@ $(call done,$@)

#*---------------------------------------------------------------------*/
#*    stdclean                                                         */
#*---------------------------------------------------------------------*/
stdclean:
	$(RM) -f $(OBJECTS) $(_BGL_OBJECTS:%=%.c)
	$(RM) -f $(EOBJECTS)
	$(RM) -f $(BUILDLIBDIR)/lib$(TARGETNAME)_s-$(ZIPIRELEASE).a
	$(RM) -f $(BUILDLIBDIR)/lib$(TARGETNAME)_u-$(ZIPIRELEASE).a
	$(RM) -f $(BUILDLIBDIR)/lib$(TARGETNAME)_es-$(ZIPIRELEASE).a
	$(RM) -f $(BUILDLIBDIR)/lib$(TARGETNAME)_eu-$(ZIPIRELEASE).a
	$(RM) -f $(BUILDLIBDIR)/lib$(TARGETNAME)_s-$(ZIPIRELEASE).$(SHAREDSUFFIX)
	$(RM) -f $(BUILDLIBDIR)/lib$(TARGETNAME)_u-$(ZIPIRELEASE).$(SHAREDSUFFIX)
	$(RM) -f $(BUILDLIBDIR)/lib$(TARGETNAME)_es-$(ZIPIRELEASE).$(SHAREDSUFFIX)
	$(RM) -f $(BUILDLIBDIR)/lib$(TARGETNAME)_eu-$(ZIPIRELEASE).$(SHAREDSUFFIX)
	$(RM) -f $(BUILDLIBDIR)/lib$(TARGETNAME)_s_mt-$(ZIPIRELEASE).$(SHAREDSUFFIX)
	$(RM) -f $(BUILDLIBDIR)/lib$(TARGETNAME)_u_mt-$(ZIPIRELEASE).$(SHAREDSUFFIX)
	$(RM) -f $(BUILDLIBDIR)/lib$(TARGETNAME)_es_mt-$(ZIPIRELEASE).$(SHAREDSUFFIX)
	$(RM) -f $(BUILDLIBDIR)/lib$(TARGETNAME)_eu_mt-$(ZIPIRELEASE).$(SHAREDSUFFIX)
	$(RM) -f $(BUILDLIBDIR)/$(TARGETNAME).heap
	$(RM) -f *~
	$(RM) -f *.mco
	$(RM) -f *.ast

udeclean:
	$(RM) -f .afile .etags

devclean: cleanall

#*---------------------------------------------------------------------*/
#*    clean                                                            */
#*---------------------------------------------------------------------*/
clean: stdclean
	$(RM) -rf o

cleanall: stdclean udeclean

distclean: cleanall

#*---------------------------------------------------------------------*/
#*    Installation                                                     */
#*---------------------------------------------------------------------*/
.PHONY: install-library install-c install-native uninstall

install-library: install-$(BACKEND)

install-native: install-native-heap install-native-libs

install-native-heap:
	$(INSTALL) $(BUILDLIBDIR)/$(TARGETNAME).heap $(DESTDIR)$(ZIPILIBDIR)/$(ZIPIFILDIR)/$(TARGETNAME).heap
	chmod $(MODFILE) $(DESTDIR)$(ZIPILIBDIR)/$(ZIPIFILDIR)/$(TARGETNAME).heap

install-native-libs:
	if [ "$(THREADS)" = "yes" ]; then \
          $(MAKE) LIBSUFFIXTHREAD=_mt install-native-libs-version; \
        else \
          $(MAKE) LIBSUFFIXTHREAD= install-native-libs-version; \
        fi

install-native-libs-version:
	$(MAKE) install-lib \
                INSTALL="$(INSTALL)" \
                BOOTLIBDIR=$(BUILDLIBDIR) \
                FILDIR=$(ZIPIFILDIR)\
                LIBDIR=$(ZIPILIBDIR)\
                LIB=lib$(TARGETNAME)_s$(LIBSUFFIXTHREAD)-$(ZIPIRELEASE)
	$(MAKE) install-lib \
                INSTALL="$(INSTALL)" \
                BOOTLIBDIR=$(BUILDLIBDIR) \
                FILDIR=$(ZIPIFILDIR) \
                LIBDIR=$(ZIPILIBDIR) \
                LIB=lib$(TARGETNAME)_es$(LIBSUFFIXTHREAD)-$(ZIPIRELEASE)
	$(MAKE) install-lib \
                INSTALL="$(INSTALL)" \
                BOOTLIBDIR=$(BUILDLIBDIR) \
                FILDIR=$(ZIPIFILDIR) \
                LIBDIR=$(ZIPILIBDIR) \
                LIB=lib$(TARGETNAME)_u$(LIBSUFFIXTHREAD)-$(ZIPIRELEASE)
	$(MAKE) install-lib \
                INSTALL="$(INSTALL)" \
                BOOTLIBDIR=$(BUILDLIBDIR) \
                FILDIR=$(ZIPIFILDIR) \
                LIBDIR=$(ZIPILIBDIR) \
                LIB=lib$(TARGETNAME)_eu$(LIBSUFFIXTHREAD)-$(ZIPIRELEASE)


uninstall: uninstall-native-heap uninstall-native-libs

uninstall-native-heap:
	-$(RM) -f $(DESTDIR)$(ZIPILIBDIR)/$(ZIPIFILDIR)/$(TARGETNAME).heap

uninstall-native-libs:
	if [ "$(THREADS)" = "yes" ]; then \
          $(MAKE) LIBSUFFIXTHREAD=_mt uninstall-native-libs-version; \
        else \
          $(MAKE) VERSOIN= uninstall-native-libs-version; \
        fi

uninstall-native-libs-version:
	-$(MAKE) uninstall-lib LIB=lib$(TARGETNAME)_s$(LIBSUFFIXTHREAD)-$(ZIPIRELEASE)
	-$(MAKE) uninstall-lib LIB=lib$(TARGETNAME)_u$(LIBSUFFIXTHREAD)-$(ZIPIRELEASE)
	-$(MAKE) uninstall-lib LIB=lib$(TARGETNAME)_es$(LIBSUFFIXTHREAD)-$(ZIPIRELEASE)
	-$(MAKE) uninstall-lib LIB=lib$(TARGETNAME)_eu$(LIBSUFFIXTHREAD)-$(ZIPIRELEASE)

#*---------------------------------------------------------------------*/
#*    dep                                                              */
#*---------------------------------------------------------------------*/
.PHONY: dep
dep:
	@(num=`grep -n '^#bdepend start' Makefile | awk -F: '{ print $$1}' -`;\
          head -n `expr $$num - 1` Makefile > /tmp/Makefile.aux)
	@ $(DEPEND) -fno-mco \
                    -search-path . \
                    -strict-obj-dir o \
                    $(SOURCES) >> /tmp/Makefile.aux
	@ mv /tmp/Makefile.aux Makefile
