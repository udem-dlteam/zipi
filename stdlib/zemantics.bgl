(module __stdlib_zemantics

   (include
          "rts-macros.scm"
          "rts.sch"
	  "bigloo/include.sch"
	  "bigloo/call.sch"
	  "bigloo/constants.sch")

   (import __py_rts)

   (export (zipi-init name)
	   (py-getattribute-fallback obj80 attr81)
	   (py-getitem-fallback obj83 index84)
	   (py-setitem-fallback obj86 index87 value88)

	   (inline py-bitand-fallback x y)
	   (py-bitand-fallback:normal x y)

	   (inline py-bitor-fallback x y)
	   (py-bitor-fallback:normal x y)

	   (inline py-xor-fallback x y)
	   (py-xor-fallback:normal x y)

	   (inline py-ilshift-fallback x y)
	   (py-ilshift-fallback:normal x y)

	   (inline py-lshift-fallback x y)
	   (py-lshift-fallback:normal x y)

	   (inline py-rshift-fallback x y)
	   (py-rshift-fallback:normal x y)

	   (inline py-add-fallback x y)
	   (py-add-fallback:normal x y)

	   (inline py-sub-fallback x y)
	   (py-sub-fallback:normal x y)

	   (inline py-mul-fallback x y)
	   (py-mul-fallback:normal x y)

	   (inline py-floordiv-fallback x y)
	   (py-floordiv-fallback:normal x y)

	   (inline py-truediv-fallback x y)
	   (py-truediv-fallback:normal x y)

	   (inline py-mod-fallback x y)
	   (py-mod-fallback:normal x y)

	   (inline py-iadd-fallback x y)
	   (py-iadd-fallback:normal x y)

	   (inline py-isub-fallback x y)
	   (py-isub-fallback:normal x y)

	   (inline py-imul-fallback x y)
	   (py-imul-fallback:normal x y)

	   (inline py-ifloordiv-fallback x y)
	   (py-ifloordiv-fallback:normal x y)

	   (inline py-imod-fallback x y)
	   (py-imod-fallback:normal x y)))

(define-inline (py-bitand-fallback x y) (py-bitand-fallback:normal x y))
(define-inline (py-bitor-fallback x y) (py-bitor-fallback:normal x y))
(define-inline (py-xor-fallback x y) (py-xor-fallback:normal x y))
(define-inline (py-ilshift-fallback x y) (py-ilshift-fallback:normal x y))
(define-inline (py-lshift-fallback x y) (py-lshift-fallback:normal x y))
(define-inline (py-rshift-fallback x y) (py-rshift-fallback:normal x y))

(define-inline (py-add-fallback x y) (py-add-fallback:normal x y))
(define-inline (py-sub-fallback x y) (py-sub-fallback:normal x y))
(define-inline (py-floordiv-fallback x y) (py-floordiv-fallback:normal x y))
(define-inline (py-truediv-fallback x y) (py-truediv-fallback:normal x y))
(define-inline (py-mod-fallback x y) (py-mod-fallback:normal x y))
(define-inline (py-mul-fallback x y) (py-mul-fallback:normal x y))
(define-inline (py-iadd-fallback x y) (py-iadd-fallback:normal x y))
(define-inline (py-isub-fallback x y) (py-isub-fallback:normal x y))
(define-inline (py-ifloordiv-fallback x y) (py-ifloordiv-fallback:normal x y))
(define-inline (py-imod-fallback x y) (py-imod-fallback:normal x y))
(define-inline (py-imul-fallback x y) (py-imul-fallback:normal x y))
