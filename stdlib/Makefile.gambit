do.gambit: zemantics.scm behaviors.scm builtins.sld

install.gambit:

zemantics.scm:
	../bin/zpc.gambit zemantics.py > zemantics.scm

behaviors.scm:
	../bin/zpc.gambit behaviors.py > behaviors.scm

builtins.sld: builtins.py
	../bin/zpc.gambit builtins.py > builtins.sld

clean.gambit:

distclean.gambit:
	rm -f builtins.sld
