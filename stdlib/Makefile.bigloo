do.bigloo: builtins.bgl zemantics.bgl behaviors.bgl

builtins.bgl:
	../bin/zpc.bigloo.sh -s -fglobals -o builtins.bgl ./builtins.py -m __stdlib_builtins --bootstrap --bin-dir=$(BUILDETCDIR)

zemantics.bgl: zemantics.scm
	$(BUILDPYTHON) ../etc/scm_to_zipi.py -b bigloo -s zemantics.scm -t zemantics.bgl.in -p @BGL_EXPORTS@ -i 3 > zemantics.bgl

behaviors.bgl: behaviors.scm
	$(BUILDPYTHON) ../etc/scm_to_zipi.py -b bigloo -s behaviors.scm -t behaviors.bgl.in -p @BGL_EXPORTS@ -i 3 > behaviors.bgl

clean.bigloo:

distclean.bigloo:
	rm -f zemantics.bgl
	rm -f behaviors.bgl
	rm -f builtins.bgl
