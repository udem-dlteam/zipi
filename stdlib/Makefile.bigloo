do.bigloo: builtins.bgl

builtins.bgl:
	../bin/zpc.bigloo -t bigloo ./builtins.py --bootstrap > ./builtins.bgl
	# Temporary way for the builtins' scope to use pre-bootstrap py-make-simple-global
	sed -i -- 's/py-make-global/py-make-base-global/g' ./builtins.bgl

clean.bigloo:

distclean.bigloo:
	rm -f builtins.bgl
