do.bigloo: builtins.bgl zemantics.bgl behaviors.bgl

builtins.bgl:
	../bin/zpc.bigloo.sh -s -fglobals -o builtins.bgl ./builtins.py -m __stdlib_builtins --bootstrap --bin-dir=$(BUILDBINDIR)

zemantics.bgl: zemantics.scm
	$(BIGLOO) ../etc/scm-to-zipi.scm -- bigloo zemantics.bgl.in zemantics.scm > zemantics.bgl

behaviors.bgl: behaviors.scm
	$(BIGLOO) ../etc/scm-to-zipi.scm -- bigloo behaviors.bgl.in behaviors.scm > behaviors.bgl

clean.bigloo:

distclean.bigloo:
	rm -f zemantics.bgl
	rm -f behaviors.bgl
	rm -f builtins.bgl
