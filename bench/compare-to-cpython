#!/bin/sh

bench="$1"
shift
systems="$*"

if test -z "$systems"; then
   systems="gambit bigloo"
fi

cpython3_output=`python3 $bench`
cpython3_time=`echo "$cpython3_output" | sed -e "s/ .*//g"`
code=`echo "$cpython3_output" | sed -e "s/^.*: //"`

cpython2_output=`python2 $bench`
cpython2_time=`echo "$cpython2_output" | sed -e "s/ .*//g"`

for system in $systems; do
  case "$system" in
    
    gambit)
      bench_output=`../bin/zipi.gambit $bench`
      bench_time=`echo "$bench_output" | sed -e "s/ .*//g"`

      python3 -c "t=$bench_time;cp2=$cpython2_time;cp3=$cpython3_time;system='[$system]';code='$code';bench='$bench';speedup2=cp2/t;speedup3=cp3/t;print(f'{system:8s}{speedup2:8.4f}x{speedup3:9.4f}x {code:s} ({bench:s})')"
      ;;

    bigloo)
      bench_output=`../bin/zipi.bigloo $bench`
      bench_time=`echo "$bench_output" | sed -e "s/ .*//g"`

      python3 -c "t=$bench_time;cp2=$cpython2_time;cp3=$cpython3_time;system='[$system]';code='$code';bench='$bench';speedup2=cp2/t;speedup3=cp3/t;print(f'{system:8s}{speedup2:8.4f}x{speedup3:9.4f}x {code:s} ({bench:s})')"
      ;;
    
    pypy2)
      bench_output=`pypy2 $bench`
      bench_time=`echo "$bench_output" | sed -e "s/ .*//g"`

      python3 -c "t=$bench_time;cp2=$cpython2_time;cp3=$cpython3_time;system='[$system]';code='$code';bench='$bench';speedup2=cp2/t;speedup3=cp3/t;print(f'{system:8s}{speedup2:8.4f}x{speedup3:9.4f}x {code:s} ({bench:s})')"
      ;;
    
    pypy)
      bench_output=`pypy $bench`
      bench_time=`echo "$bench_output" | sed -e "s/ .*//g"`

      python3 -c "t=$bench_time;cp2=$cpython2_time;cp3=$cpython3_time;system='[$system]';code='$code';bench='$bench';speedup2=cp2/t;speedup3=cp3/t;print(f'{system:8s}{speedup2:8.4f}x{speedup3:9.4f}x {code:s} ({bench:s})')"
      ;;
    
    *)
      echo "Unknown system $system"
  esac

done
