#!/bin/sh

DIR=`dirname "$1"`
BASE=`basename "$1" ".py"`

cd "$DIR"

DIR=`pwd`

C_FILE="$HOME/.zipicache/cache@zipi_0_0_1$DIR/$BASE/$BASE@gambit409003@C/$BASE.c"
MODULE_NAMESPACE="`echo \"$DIR/$BASE\" | sed -e s,^/,, -e s,_,__,g -e s,/,_2f_,g`"

#echo "$MODULE_NAMESPACE"

#exit

#Users_2f_feeley_2f_python_2f_fixzipi2_2f_zipi_2f_bench_2f_micro__var__int__add__1_23_py_2d_module

sed -n '/BEGIN-BENCH-FIRST-STMT/,/END-BENCH-FIRST-STMT/p' "$C_FILE" | tail +3 | sed '$d' | sed '$d' | sed -e "s/$MODULE_NAMESPACE//g"
