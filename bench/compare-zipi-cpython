#!/bin/sh

bench="$1"
shift
systems="$*"

if test -z "$systems"; then
   systems="gambit bigloo"
fi

cpython_output=`python3 $bench`
cpython_time=`echo "$cpython_output" | sed -e "s/ .*//g"`
code=`echo "$cpython_output" | sed -e "s/^.*: //"`

for system in $systems; do
  case "$system" in
    
    gambit)
      zipi_output=`../bin/zipi.gambit $bench`
      zipi_time=`echo "$zipi_output" | sed -e "s/ .*//g"`

      python3 -c "a=$cpython_time;b=$zipi_time;system='$system';code='$code';bench='$bench';speedup=a/b;print(f'[{system:s}] {speedup:7.4f}x on {code:s} ({bench:s})')"
      ;;

    bigloo)
      zipi_output=`../bin/zipi.bigloo $bench`
      zipi_time=`echo "$zipi_output" | sed -e "s/ .*//g"`

      python3 -c "a=$cpython_time;b=$zipi_time;system='$system';code='$code';bench='$bench';speedup=a/b;print(f'[{system:s}] {speedup:7.4f}x on {code:s} ({bench:s})')"
      ;;
    
    pypy)
      zipi_output=`pypy $bench`
      zipi_time=`echo "$zipi_output" | sed -e "s/ .*//g"`

      python3 -c "a=$cpython_time;b=$zipi_time;system='$system';code='$code';bench='$bench';speedup=a/b;print(f'[{system:s}] {speedup:7.4f}x on {code:s} ({bench:s})')"
      ;;
    
    *)
      echo "Unknown system $2"
  esac

done
