;*---------------------------------------------------------------------*/
;*    The module                                                       */
;*---------------------------------------------------------------------*/
(module zpc

   (import zpc_configure zpc_param zpc_parseargs zpc_driver)

   (library pyc)

   (main main))

;*---------------------------------------------------------------------*/
;*    main ...                                                         */
;*---------------------------------------------------------------------*/
(define (main args)
   ;; no debug by default
   (bigloo-warning-set! 0)
   (bigloo-debug-set! 0)
   ;; set the Zipi cond-expand identification
   (register-srfi! 'zpc)
   (for-each register-eval-srfi! (zipi-srfis))
   ;; set the library load path
   (bigloo-library-path-set!
      (cons (zipi-lib-dir) (bigloo-library-path)))
   ;; parse the command line
   (let ((exprs (parse-args args)))
      ;; access file
      (cond
         ((string? (zpc-access-file))
          (module-load-access-file (zpc-access-file)))
         ((file-exists? ".afile")
          (module-load-access-file ".afile")))
      ;; evaluate the command line expressions
      (for-each (lambda (expr)
                   (with-input-from-string expr
                      (lambda ()
                         (let ((sexp (read (current-input-port))))
                            (with-handler
                               (lambda (e)
                                  (if (isa? e &eval-warning)
                                      (begin
                                         (warning-notify e)
                                         #unspecified)
                                      (raise e)))
                               (eval sexp))))))
         exprs)
      ;; start the compilation stage
      (with-handler
         (lambda (e)
            (exception-notify e)
            (exit 1))
	 ;; compile the source file
	 (compile-sources))))
