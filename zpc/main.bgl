;*---------------------------------------------------------------------*/
;*    The module                                                       */
;*---------------------------------------------------------------------*/
(module zpc

   (import zpc_configure)
   
   (library pyc)
   
   (main main))

;*---------------------------------------------------------------------*/
;*    main ...                                                         */
;*---------------------------------------------------------------------*/
(define (main args)
   (let ((verb 0)
	 (tgt 'scheme)
	 (generate-main #t)
	 (dir #f)
	 (src #f)
	 (libdir (zipi-lib-dir))
	 (bindir (zipi-bin-dir))
	 (conf '()))
      (args-parse (cdr args)
	 ((("-h" "--help") (help "This message"))
	  (usage args-parse-usage)
	  (exit 0))
	 ((("-t" "--target") ?target (help "Set target language"))
	  (set! tgt (string->symbol target)))
	 ((("-n" "--no-main") (help "Donot generate main entry point"))
	  (set! generate-main #f))
	 ((("-d" "--dir") ?d (help "Root import directory"))
	  (set! dir d))
	 (("-v?level" (help "Increase/set verbosity level (-v0 crystal silence)"))
	  (if (string=? level "")
	      (set! verb (+fx 1 verb))
	      (set! verb (string->integer level))))
	 (else
	  (unless (string=? else "--")
	     (set! src else))))
      (pyc (target-driver tgt)
	 (cons*
	    verbose: verb
	    target: tgt
	    lib-dir: libdir
	    bind-dir: libdir
	    dir: (or dir (if src (absolute (dirname src)) (pwd)))
	    src: src
	    conf))))

;*---------------------------------------------------------------------*/
;*    absolute ...                                                     */
;*---------------------------------------------------------------------*/
(define (absolute path)
   (file-name-canonicalize
      (if (char=? (string-ref path 0) #\/)
	  path
	  (make-file-name (pwd) path))))

;*---------------------------------------------------------------------*/
;*    usage ...                                                        */
;*---------------------------------------------------------------------*/
(define (usage args-parse-usage)
   (print "zpc")
   (print "usage: zpc [options] -- [bigloo-options]")
   (args-parse-usage #f)
   (newline)
   (print "Shell Variables:")
   (print "   - PYTRACE: hop internal trace [PYTRACE=\"key1, key2, ...\"]")
   (print "      pyc:dump")
   (newline))

