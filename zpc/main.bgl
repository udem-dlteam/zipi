;*---------------------------------------------------------------------*/
;*    The module                                                       */
;*---------------------------------------------------------------------*/
(module zpc

   (import zpc_configure)
   
   (library pyc)
   
   (main main))

;*---------------------------------------------------------------------*/
;*    main ...                                                         */
;*---------------------------------------------------------------------*/
(define (main args)
   (let ((verb 0)
	 (tgt 'bigloo)
	 (main #t)
	 (dir #f)
	 (src #f)
	 (dest #f)
	 (libdir (zipi-lib-dir))
	 (bindir (zipi-bin-dir))
	 (conf '()))
      (args-parse (cdr args)
	 ((("-h" "--help") (help "This message"))
	  (usage args-parse-usage)
	  (exit 0))
	 ((("-t" "--target") ?target (help "Set target language"))
	  (set! tgt (string->symbol target)))
	 ((("-d" "--dir") ?path (help "Root import directory"))
	  (set! dir path))
	 ((("-o" "--output") ?path (help "Destination"))
	  (set! dest path))
	 ((("--py-module-main") (help "Generate a main module clause"))
	  (set! main #t))
	 ((("--no-py-module-main") (help "Do not generate a main module clause"))
	  (set! main #f))
	 (("-v?level" (help "Increase/set verbosity level (-v0 crystal silence)"))
	  (if (string=? level "")
	      (set! verb (+fx 1 verb))
	      (set! verb (string->integer level))))
	 (else
	  (unless (string=? else "--")
	     (set! src else))))
      (let ((port (if (string? dest)
		      (open-output-file dest)
		      (current-output-port))))
	 (for-each (lambda (x) (pp x port))
	    (pyc (target-driver tgt)
	       (cons*
		  verbose: verb
		  target: tgt
		  lib-dir: libdir
		  bind-dir: libdir
		  dir: (or dir (if src (absolute (dirname src)) (pwd)))
		  src: src
		  main: main
		  conf))))))

;*---------------------------------------------------------------------*/
;*    absolute ...                                                     */
;*---------------------------------------------------------------------*/
(define (absolute path)
  (cond-expand
    (bigloo
     (file-name-canonicalize
      (if (char=? (string-ref path 0) #\/)
	  path
	  (make-file-name (pwd) path))))
    (gambit
     (path-normalize path))))

;*---------------------------------------------------------------------*/
;*    usage ...                                                        */
;*---------------------------------------------------------------------*/
(define (usage args-parse-usage)
   (print "zpc")
   (print "usage: zpc [options] -- [bigloo-options]")
   (args-parse-usage #f)
   (newline)
   (print "Shell Variables:")
   (print "   - PYTRACE: hop internal trace [PYTRACE=\"key1, key2, ...\"]")
   (print "      pyc:dump")
   (newline))

