#!/usr/bin/env gsi

(define (config-version) "@VERSION@")
(define (config-branch) "@BRANCH@")

;; If the path is updated here, it should be changed in rts.scm
(define (cache-location) (path-expand "~~zipicache/cache@zipi_0_0_1"))

(define (reset-cache)
  (if (and (##file-info (cache-location) #t #f)
           (eq? 'directory (##file-info-type (file-info (cache-location)))))
      (if (fx= 1 (length (directory-files (path-normalize (path-expand ".." (cache-location))))))
          (begin
            (delete-file-or-directory (cache-location) #t)
            (println "*** Cache has been deleted: " (cache-location)))
          (error
            "Cannot delete zipicache. Your zipicache folder is at : "
            (cache-location)
            ". Please delete cache folder manually or change ~~zipicache location."))
      (println "*** WARNING -- Cache not found: " (cache-location))))

(define (main . args)
  (let ((help      #f)
        (compile   #t)
        (debug     #f)
        (profile   #f)
        (expansion #f)
        (reset     #f)
        (version   0) ;; count number of -V
        (file      #f)
        (argv      #f))

    (let loop ((args args))
      (if (pair? args)
          (let ((arg (car args))
                (rest (cdr args)))
            (cond ((and (pair? rest) (member arg '("-X")))
                   (let ((option (car rest)))
                     (cond ((string=? option "compile")
                            (set! compile #t))
                           ((string=? option "interpret")
                            (set! compile #f))
                           ((string=? option "debug")
                            (set! debug #t))
                           ((string=? option "flamegraph")
                            (let ((p (or profile '())))
                              (set! profile
                                (if (member 'flamegraph p)
                                    p
                                    (cons 'flamegraph p)))))
                           ((string=? option "profile")
                            (let ((p (or profile '())))
                              (set! profile
                                (if (member 'profile p)
                                    p
                                    (cons 'profile p)))))
                           ((string=? option "expansion")
                            (set! expansion #t))
                           ((string=? option "reset")
                            (set! reset #t))
                           (else
                            (println "*** ignoring option -X " option)))
                     (loop (cdr rest))))
                  ((member arg '("-h" "-?" "--help"))
                   (set! help #t)
                   (loop rest))
                  ((member arg '("-V"))
                   (set! version (+ version 1))
                   (loop rest))
                  ((member arg '("-VV"))
                   (set! version (+ version 2))
                   (loop rest))
                  (else
                   (if (and (>= (string-length arg) 1)
                            (char=? (string-ref arg 0) #\-))
                       (begin
                         (println "*** ignoring option " arg)
                         (loop rest))
                       (begin
                         (set! file arg)
                         (set! argv (cons arg rest)))))))))

    (cond (help
           (usage))
          ((>= version 1)
           (println "Zipi " (config-version))
           (if (>= version 2)
               (println "git branch: " (config-branch))))
          (else

           (if reset (reset-cache))

           (if (not file)
               (if (not reset) (usage))
               (let ((path (path-normalize file)))
                 (run-as-main path argv compile debug profile expansion)))))))

(define (usage)
  (print (string-append "usage: " (car (command-line)) #<<EOF
 [option] ... [file] [arg] ...
Options and arguments:
-h     : print this help message and exit (also --help)
-V     : print the zipi version number and exit (also --version)
         when given twice, print more information about the build
-X opt : system dependent option:
           compile     compile Scheme program
           interpret   interpret Scheme program
           debug       generate debugging information in compiled code
           flamegraph  generate statistical profile as a flamegraph
           profile     generate statistical profile as .html files
           expansion   show Scheme code of module after expansion
           reset       reset the zipi module cache

EOF
)))

(define (run-as-main path argv compile debug profile expansion)

  ;; use eval to delay processing of (import (zipi rts))

  ((eval '(lambda (path argv compile debug profile expansion)

            (import (zipi rts))

            (compile-flag-set! compile)
            (debug-flag-set! debug)
            (profile-flag-set! profile)
            (expansion-flag-set! expansion)
            (command-line-argv-set! argv)

            (run-as-main path)))
   path
   argv
   compile
   debug
   profile
   expansion))

(##main-set! main)
