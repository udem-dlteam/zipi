#!/bin/sh

if [ "$ZIPIROOT " = " " ]; then
  zipiroot="@ZIPIROOT@"
else
  zipiroot="$ZIPIROOT"
fi

if [ "$ZIPICACHE " = " " ]; then
  zipicache="@ZIPICACHE@"
else
  zipicache="$ZIPICACHE"
fi

if [ "$ZIPIDBG " = " " ]; then
  ZIPIROOT="$zipiroot" ZIPICACHE="$zipicache" @GAMBIT@ -:=@GAMBITROOT@,~~zipicache=@ZIPICACHE@,~~zipiroot=@ZIPIROOT@,search=@ZIPIROOT@ @ZIPIBIN@/zipi-compile-and-run.gambit "$@"
else
  if [ "$ZIPIDBG " = "lldb " ]; then
    DBGARGS="--"
  else
    DBGARGS="--args"
  fi
  ZIPIROOT="$zipiroot" ZIPICACHE="$zipicache" $ZIPIDBG $DBGARGS @GAMBIT@ -:=@GAMBITROOT@,~~zipicache=@ZIPICACHE@,~~zipiroot=@ZIPIROOT@,search=@ZIPIROOT@ @ZIPIBIN@/zipi-compile-and-run.gambit "$@"
fi
