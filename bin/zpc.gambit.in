#!/bin/sh

SCRIPT_DIR="$( cd "$( dirname "$0" )" >/dev/null 2>&1 && pwd )"
ZIPI_DIR="$( cd "$SCRIPT_DIR/.." >/dev/null 2>&1 && pwd )"

ETC_DIR="$ZIPI_DIR/etc"
LIB_DIR="$ZIPI_DIR/lib"
BIN_DIR="$ZIPI_DIR/bin"
RTS_DIR="$ZIPI_DIR/rts"
ZPC_DIR="$ZIPI_DIR/zpc"
PYC_DIR="$ZIPI_DIR/pyc"

# TODO: put this logic in the compiler's code generation
if [ "$ZPC_DEBUG" = true ]; then
    echo "(declare (debug) (debug-location))"
fi

gsi -:search=$SCRIPT_DIR,search=$PYC_DIR,darR-,t8,f8,-8 \
-e "(define (zipi-etc-dir) \"$ETC_DIR\")" \
-e "(define (zipi-lib-dir) \"$LIB_DIR\")" \
-e "(define (zipi-bin-dir) \"$BIN_DIR\")" \
-e "(define (zipi-rts-dir) \"$RTS_DIR\")" \
-e "(##import bigloo)" \
$PYC_DIR/ast.bgl \
-e "(##include \"$PYC_DIR/walk.sch\")" \
-e "(##include \"$PYC_DIR/new.sch\")" \
-e "(##include \"$PYC_DIR/sexp.scm\")" \
$PYC_DIR/symbol.bgl \
$PYC_DIR/symbol.scm \
$PYC_DIR/return.bgl \
$PYC_DIR/return.scm \
$PYC_DIR/locals.bgl \
$PYC_DIR/locals.scm \
$PYC_DIR/super.scm \
$PYC_DIR/scheme.bgl \
$PYC_DIR/scheme.scm \
$PYC_DIR/break.bgl \
$PYC_DIR/break.scm \
$PYC_DIR/usage.bgl \
$PYC_DIR/usage.scm \
$PYC_DIR/generator.bgl \
$PYC_DIR/generator.scm \
$PYC_DIR/cps.bgl \
$PYC_DIR/cps.scm \
$PYC_DIR/javascript.bgl \
$PYC_DIR/javascript.scm \
$PYC_DIR/dump.bgl \
$PYC_DIR/dump.scm \
$ZPC_DIR/main.scm \
$PYC_DIR/compile.bgl \
$PYC_DIR/compile.scm \
$PYC_DIR/parse.bgl \
$PYC_DIR/parse.scm \
$PYC_DIR/intrinsics.bgl \
$PYC_DIR/intrinsics.scm \
$PYC_DIR/simple-scoping.bgl \
$PYC_DIR/simple-scoping.scm \
$ZPC_DIR/main-gambit.scm \
$*
