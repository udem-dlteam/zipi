;*---------------------------------------------------------------------*/
;*    The module                                                       */
;*---------------------------------------------------------------------*/
(module __py_bigloo

   (import __py_rts
	   __py_configure)

   (export (macro let-values)

	   (object->serial-number ::obj)

	   (inline arithmetic-shift::long ::long ::long)
	   (inline bitwise-and::long ::long ::long)
	   (inline bitwise-ior::long ::long ::long)
	   (inline bitwise-xor::long ::long ::long)
	   (inline bitwise-not::long ::long)

	   (inline floor-quotient x y)
	   (inline inexact::double x)

	   (inline fx+::long ::long ::long)
	   (inline fx-::long ::long ::long)
	   (inline fx*::long ::long ::long)
	   (inline fx/::long ::long ::long)
	   (inline fx=::bool ::long ::long)
	   (inline fx>=::bool ::long ::long)
	   (inline fx<::bool ::long ::long)
	   (inline fx<=::bool ::long ::long)
	   (inline fx>::bool ::long ::long)
	   (inline fxmax::bool ::long ::long)
	   (inline fxquotient::long ::long ::long)

	   (inline u8+::uint8 ::uint8 ::uint8)
	   (inline u8-::uint8 ::uint8 ::uint8)
	   (inline u8*::uint8 ::uint8 ::uint8)
	   (inline u8/::uint8 ::uint8 ::uint8)
	   (inline u8=::bool ::uint8 ::uint8)
	   (inline u8>=::bool ::uint8 ::uint8)
	   (inline u8<::bool ::uint8 ::uint8)
	   (inline u8<=::bool ::uint8 ::uint8)
	   (inline u8>::bool ::uint8 ::uint8)

	   max-fixnum
	   (inline infinite?::bool ::double)
	   (inline flfinite?::bool ::double)
	   (inline flinfinite?::bool ::double)
	   (inline nan?::bool ::double)

	   (inline +fx/overflow::obj ::obj ::obj)
	   (inline -fx/overflow::obj ::obj ::obj)
	   (inline *fx/overflow::obj ::obj ::obj)

	   (inline u8vector-append . vecs)
	   (inline subu8vector vec start stop)
	   (u8vector-copy::u8vector ::u8vector)

	   (append-strings ::pair-nil)
	   (substring-move! src-string src-start src-end dst-string dst-start)

	   (inline current-second)
	   (inline current-time)
	   (time->seconds::double d)
	   (macro time->seconds)

	   (path-directory ::bstring)
	   (path-strip-extension ::bstring)
	   (path-strip-directory ::bstring)
	   (path-normalize ::bstring)
	   (path-expand ::bstring #!optional (origin (pwd)))
	   (path-strip-trailing-directory-separator::bstring ::bstring)

	   (create-directory ::bstring)

	   (file-info path . rest)
	   (file-info-last-modification-time info)
	   (file-info-type path)

	   (inline make-table #!key test weak-values)
	   (inline table-set! table key value)
	   (inline table-ref table key #!optional default)
	   (inline table->list table)
	   (inline table-length table)

	   (module-not-found-exception? e)

	   (shell-command ::bstring #!optional capture)

	   (getenv name #!optional default)

	   (module-search-order-add! dir)
	   (load-module-and-get-init name)
	   (compile-source ::bstring ::bstring)

	   (inline get-environment-variable ::bstring)
	   (fold ::procedure ::obj ::pair-nil)))

;*---------------------------------------------------------------------*/
;*    let-values ...                                                   */
;*---------------------------------------------------------------------*/
(define-macro (let-values bindings . body)
   (match-case bindings
      (((?bindings ?generator))
       `(multiple-value-bind ,bindings ,generator ,@body))
      (else
       (error "let-values" "Illegal form" `(let-values ,bindings ,@body)))))

;*---------------------------------------------------------------------*/
;*    object->serial-number ...                                        */
;*---------------------------------------------------------------------*/
(define (object->serial-number o)
   (object-hashnumber o))

;*---------------------------------------------------------------------*/
;*    bitwise operations ...                                           */
;*---------------------------------------------------------------------*/
(define-inline (arithmetic-shift x y) (if (>fx y 0) (bit-lsh x y) (bit-rsh x (negfx y))))
(define-inline (bitwise-and x y) (bit-and x y))
(define-inline (bitwise-ior x y) (bit-or x y))
(define-inline (bitwise-xor x y) (bit-xor x y))
(define-inline (bitwise-not x) (bit-not x))

;*---------------------------------------------------------------------*/
;*    floor-quotient ...                                               */
;*---------------------------------------------------------------------*/
(define-inline (floor-quotient x y)
   (floor (quotient x y)))

;*---------------------------------------------------------------------*/
;*    inexact ...                                                      */
;*---------------------------------------------------------------------*/
(define-inline (inexact v)
   (if (exact? v) (exact->inexact v) v))

;*---------------------------------------------------------------------*/
;*    max-fixnum ...                                                   */
;*---------------------------------------------------------------------*/
(define max-fixnum (maxvalfx))

;*---------------------------------------------------------------------*/
;*    infinite? ...                                                    */
;*---------------------------------------------------------------------*/
(define-inline (infinite? n)
   (or (=fl n +inf.0) (=fl n -inf.0)))

(define-inline (flfinite? n)
  (finitefl? n))

(define-inline (flinfinite? n)
  (infinitefl? n))

;*---------------------------------------------------------------------*/
;*    nan? ...                                                         */
;*---------------------------------------------------------------------*/
(define-inline (nan? n)
   (nanfl? n))

;*---------------------------------------------------------------------*/
;*    fx operations ...                                                */
;*---------------------------------------------------------------------*/
(define-inline (fx+ x y) (+fx x y))
(define-inline (fx- x y) (-fx x y))
(define-inline (fx* x y) (*fx x y))
(define-inline (fx/ x y) (/fx x y))
(define-inline (fx= x y) (=fx x y))
(define-inline (fx< x y) (<fx x y))
(define-inline (fx> x y) (>fx x y))
(define-inline (fx<= x y) (<=fx x y))
(define-inline (fx>= x y) (>=fx x y))
(define-inline (fxmax x y) (maxfx x y))
(define-inline (fxquotient x y) (quotientfx x y))

;*---------------------------------------------------------------------*/
;*    u8 operations                                                    */
;*---------------------------------------------------------------------*/
(define-inline (u8+ x y) (+u8 x y))
(define-inline (u8- x y) (-u8 x y))
(define-inline (u8* x y) (*u8 x y))
(define-inline (u8/ x y) (/u8 x y))
(define-inline (u8= x y) (=u8 x y))
(define-inline (u8< x y) (<u8 x y))
(define-inline (u8> x y) (>u8 x y))
(define-inline (u8<= x y) (<=u8 x y))
(define-inline (u8>= x y) (>=u8 x y))

;*---------------------------------------------------------------------*/
;*    +fx/overflow ...                                                 */
;*---------------------------------------------------------------------*/
(define-inline (+fx/overflow::obj x::obj y::obj)
   (cond-expand
      ((and bigloo-c (config have-overflow #t) (config nan-tagging #t))
       (let ((res::int 0))
	  (if (pragma::bool "__builtin_sadd_overflow((int)((long)$1), (int)((long)$2), &$3)"
		 x y (pragma res))
	      (+bx (fixnum->bignum x) (fixnum->bignum y))
	      (pragma::bint "BINT($1)" res))))
      ((and bigloo-c (config have-overflow #t))
       (let ((res::long 0))
	  (if (pragma::bool "__builtin_saddl_overflow((long)$1, (long)$2-TAG_INT, &$3)"
		 x y (pragma res))
	      (-bx (fixnum->bignum x) (fixnum->bignum y))
	      (pragma::bint "(obj_t)($1)" res))))
      (else
       (+fx x y))))

;*---------------------------------------------------------------------*/
;*    -fx/overflow ...                                                 */
;*---------------------------------------------------------------------*/
(define-inline (-fx/overflow x::obj y::obj)
   (cond-expand
      ((and bigloo-c (config have-overflow #t) (config nan-tagging #t))
       (let ((res::int 0))
	  (if (pragma::bool "__builtin_ssub_overflow((int)((long)$1), (int)((long)$2), &$3)"
		 x y (pragma res))
	      (-bx (fixnum->bignum x) (fixnum->bignum y) )
	      (pragma::bint "BINT($1)" res))))
      ((and bigloo-c (config have-overflow #t))
       (let ((res::long 0))
	  (if (pragma::bool "__builtin_ssubl_overflow((long)$1, (long)$2-TAG_INT, &$3)"
		 x y (pragma res))
	      (-bx (fixnum->bignum x) (fixnum->bignum y))
	      (pragma::bint "(obj_t)($1)" res))))
      (else
       (-fx x y))))

;*---------------------------------------------------------------------*/
;*    *fx/overflow ...                                                 */
;*---------------------------------------------------------------------*/
(define-inline (*fx/overflow x::obj y::obj)
   (cond-expand
      ((and bigloo-c (config have-overflow #t) (config nan-tagging #t))
       (let ((res::int 0))
	  (if (pragma::bool "__builtin_smul_overflow((int)((long)$1), (int)((long)$2), &$3)"
		 x y (pragma res))
	      (*bx (fixnum->bignum x) (fixnum->bignum y))
	      (pragma::bint "BINT($1)" res))))
      ((and bigloo-c (config have-overflow #t))
       (let ((res::int 0))
	  (if (pragma::bool "__builtin_smul_overflow((int)(CINT($1)), (int)(CINT($2)), &$3)"
		 x y (pragma res))
	      (*bx (fixnum->bignum x) (fixnum->bignum y))
	      (pragma::bint "BINT($1)" res))))
      (else
       (*fx x y))))

;*---------------------------------------------------------------------*/
;*    u8vector functions ...                                           */
;*---------------------------------------------------------------------*/
(define-inline (u8vector-append . vecs)
  (let* ((nvec (length vecs))
         (new-vec-len
          (let loop ((vecs vecs) (acc 0))
            (if (null? vecs)
                acc
                (loop (cdr vecs) (+ acc (u8vector-length (car vecs)))))))
         (new-vec (make-u8vector new-vec-len)))
    (let loop ((i 0) (vecs vecs))
      (if (null? vecs)
          new-vec
          (let inner-loop ((i i) (j 0) (current (car vecs)))
            (if (< j (u8vector-length current))
                (begin
                  (u8vector-set! new-vec i (u8vector-ref current j))
                  (inner-loop (+ i 1) (+ j 1) current))
                (loop i (cdr vecs))))))))

(define-inline (subu8vector vec start stop)
  (let* ((len (u8vector-length vec))
         (stop (if (< stop len) stop len))
         (subvec (make-u8vector (- stop start))))
    (let loop ((vec_i start) (subvec_i 0) (stop stop) (vec vec) (subvec subvec))
      (if (< vec_i stop)
          (begin
            (u8vector-set! subvec subvec_i (u8vector-ref vec vec_i))
            (loop (+ vec_i 1) (+ subvec_i 1) stop vec subvec))
          subvec))))

(define (u8vector-copy ov)
   (let ((nv (make-u8vector (u8vector-length ov))))
      (u8vector-copy! nv 0 ov)
      nv))

;*---------------------------------------------------------------------*/
;*    strings                                                          */
;*---------------------------------------------------------------------*/
(define (append-strings lst)
   (apply string-append lst))

(define (substring-move! src-string src-start src-end dst-string dst-start)
  (let ((len (- src-end src-start)))
    (let loop ((i 0))
      (if (< i len)
        (string-set!
          dst-string
          (+ dst-start i)
          (string-ref src-string (+ src-start i)))))))

;*---------------------------------------------------------------------*/
;*    dates                                                            */
;*---------------------------------------------------------------------*/
(define-inline (current-second) (current-seconds))
(define-inline (current-time) (current-date))
(define (time->seconds::double d)
   (if (date? d) (/fl (llong->flonum (date->milliseconds d)) 1000.) d))

(define-macro (time->seconds a)
   (let ((tmp (gensym)))
      (match-case a
	 ((current-time)
	  '(/fl (llong->flonum (current-milliseconds)) 1000.))
	 (else
	  `(let ((,tmp ,a))
	      (if (date? ,a)
		  (/fl (llong->flonum (date->milliseconds ,a)) 1000.0)
		  ,a))))))

;*---------------------------------------------------------------------*/
;*    files and directories                                            */
;*---------------------------------------------------------------------*/
(define zipidir (make-file-path (zipi-lib-dir) "zipi" (zipi-release)))
(define zipicache (make-file-path "/tmp" "zipi" (zipi-release) "cache"))

(define (path-directory path)
   (dirname path))

(define (path-strip-extension path)
   (prefix path))

(define (path-strip-directory path)
   (basename path))

(define (path-normalize path)
   (let ((name (if (char=? (string-ref path 0) (file-separator))
		   (file-name-canonicalize path)
		   (file-name-canonicalize (make-file-name (pwd) path)))))
      (if (directory? name)
	  (string-append (string (file-separator)))
	  name)))

(define (path-expand path #!optional (origin (pwd)))
   (let ((p (pregexp-replace "^~~zipicache" path zipicache)))
      (cond
	 ((string=? origin "~~zipidir")
	  (make-file-name zipidir p))
	 (else
	  (make-file-name origin p)))))

(define (create-directory path)
   (make-directories path))

(define (path-strip-trailing-directory-separator path)
   (let ((len (string-length path)))
      (if (=fx len 0)
	  path
	  (let ((c (string-ref path (-fx len 1))))
	     (if (char=? c (file-separator))
		 (substring path 0 (-fx len 1))
		 path)))))

(define (file-info path . rest)
   path)

(define (file-info-last-modification-time info)
   (file-modification-time info))

(define (file-info-type info)
   (file-type info))

;*---------------------------------------------------------------------*/
;*    hash tables                                                      */
;*---------------------------------------------------------------------*/
(define-inline (make-table #!key test weak-values)
   (create-hashtable :eqtest test))

(define-inline (table-set! table key value)
   (hashtable-put! table key value))

(define-inline (table-ref table key #!optional default)
   (or (hashtable-get table key)
       (unless (hashtable-contains? table key)
	  default)))

(define-inline (table->list table)
   (hashtable-map table cons))

(define-inline (table-length table)
  #f)

;*---------------------------------------------------------------------*/
;*    module-not-found-exception? ...                                  */
;*---------------------------------------------------------------------*/
(define (module-not-found-exception? exn)
   (isa? exn &io-file-not-found-error))

;*---------------------------------------------------------------------*/
;*    shell-command ...                                                */
;*---------------------------------------------------------------------*/
(define (shell-command cmd #!optional capture)
   (if capture
       (system->string cmd)
       (system cmd)))

;*---------------------------------------------------------------------*/
;*    getenv ...                                                       */
;*---------------------------------------------------------------------*/
(define (getenv name #!optional default)
   (or ((@ getenv __os) name)
       (cond
	  ((equal? default "~~zipidir") zipidir)
	  (else #f))))

;*---------------------------------------------------------------------*/
;*    module-search-order-add! ...                                     */
;*---------------------------------------------------------------------*/
(define (module-search-order-add! dir)
   #f)

;*---------------------------------------------------------------------*/
;*    shared-lib-suffix ...                                            */
;*---------------------------------------------------------------------*/
(define shared-lib-suffix (bigloo-config 'shared-lib-suffix))

;*---------------------------------------------------------------------*/
;*    name->library-name ...                                           */
;*---------------------------------------------------------------------*/
(define (name->library-name name)
   (string-append name "." shared-lib-suffix))

;*---------------------------------------------------------------------*/
;*    load-module-and-get-init ...                                     */
;*---------------------------------------------------------------------*/
(define (load-module-and-get-init name)
   (let ((libname (name->library-name name)))
      (dynamic-load libname)
      (let ((dlsym (dynamic-load-symbol libname "init")))
	 (when dlsym
	    (dynamic-load-symbol-get dlsym)))))

;*---------------------------------------------------------------------*/
;*    compile-source ...                                               */
;*---------------------------------------------------------------------*/
(define (compile-source source target)
   (system
      (format "~a/zpc --no-py-module-name -t bigloo ~a -o ~a -y" (zipi-bin-dir) source target)))

;*---------------------------------------------------------------------*/
;*    get-environment-variable ...                                     */
;*---------------------------------------------------------------------*/
(define-inline (get-environment-variable var)
   (getenv var))

;*---------------------------------------------------------------------*/
;*    fold ...                                                         */
;*---------------------------------------------------------------------*/
(define (fold kons knil lis)
   (let lp ((lis lis) (ans knil))
      (if (null? lis)
	  ans
	  (lp (cdr lis) (kons (car lis) ans)))))
