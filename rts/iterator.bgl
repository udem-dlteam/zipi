;*---------------------------------------------------------------------*/
(module __py_iterator

   (include "iterator.sch")
   
   (import __py_object
	   __py_hclass)

   (export (class PyGenerator::PyObject
	      %next)

	   (py-make-generator ::procedure)
	   (py-generator-yield ::PyGenerator ::obj ::procedure)
	   (py-for-next ::obj))

   (eval   (export-exports)))

   
	      
   
