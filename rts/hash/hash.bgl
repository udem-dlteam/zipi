;*---------------------------------------------------------------------*/
;*    The module                                                       */
;*---------------------------------------------------------------------*/
(module __py_hash
   
   (import __py_bigloo)
   
   (export (fast-range-hash ::long ::long)
           (truncate-hash ::long)
           (hash-FNV1a::long ::bstring)))

;*---------------------------------------------------------------------*/
;*    fxwrap* ...                                                      */
;*---------------------------------------------------------------------*/
(define (fxwrap* x::long y::long)
   (*fx x y))

;*---------------------------------------------------------------------*/
;*    fxand ...                                                        */
;*---------------------------------------------------------------------*/
(define (fxand x::long y::long)
   (bit-and x y))

;*---------------------------------------------------------------------*/
;*    fxxor ...                                                        */
;*---------------------------------------------------------------------*/
(define (fxxor x::long y::long)
   (bit-xor x y))

;*---------------------------------------------------------------------*/
;*    fxarithmetic-shift-left ...                                      */
;*---------------------------------------------------------------------*/
(define (fxarithmetic-shift-left x::long y::long)
   (bit-lsh x y))

;*---------------------------------------------------------------------*/
;*    fxarithmetic-shift-right ...                                     */
;*---------------------------------------------------------------------*/
(define (fxarithmetic-shift-right x::long y::long)
   (bit-rsh x y))
