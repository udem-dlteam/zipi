.PHONY: do.gambit build.gambit builtins

do.gambit: build.gambit

zemantics.scm: ../stdlib/zemantics.scm
	cp ../stdlib/zemantics.scm zemantics.scm

behaviors.scm: ../stdlib/behaviors.scm
	cp ../stdlib/behaviors.scm behaviors.scm

rts.sld: zemantics.scm behaviors.scm
	gsi ../etc/scm-to-zipi.scm gambit rts.sld.in ../stdlib/zemantics.scm ../stdlib/behaviors.scm > rts.sld

builtins: ../stdlib/builtins.sld
	mkdir -p builtins
	cp ../stdlib/builtins.sld ./builtins/builtins.sld

build.gambit: rts.sld rts.sld.in builtins
	$(GAMBITCOMPILER) -:search=$(BUILDDIR)/.. zipi/rts

install.gambit:
	cp -a $(BUILDRTSDIR) $(ZIPIRTSDIR)

clean.gambit:
	rm -rf rts\@gambit*@C
	rm -rf builtins
