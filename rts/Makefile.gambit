.PHONY: do.gambit build.gambit builtins zipi-symlink

do.gambit: build.gambit

zemantics.scm: ../stdlib/zemantics.scm
	cp ../stdlib/zemantics.scm zemantics.scm

behaviors.scm: ../stdlib/behaviors.scm
	cp ../stdlib/behaviors.scm behaviors.scm

rts.sld: zemantics.scm behaviors.scm
	$(BUILDGAMBIT) ../etc/scm-to-zipi.scm gambit rts.sld.in ../stdlib/zemantics.scm ../stdlib/behaviors.scm > rts.sld

builtins: ../stdlib/builtins.sld
	mkdir -p builtins
	cp ../stdlib/builtins.sld ./builtins/builtins.sld

zipi-build-symlink:
	cd $(BUILDDIR); rm -f zipi; ln -s . zipi

zipi-install-symlink:
	cd $(ZIPIROOT); rm -f zipi; ln -s . zipi

build.gambit: zipi-build-symlink rts.sld rts.sld.in builtins
	$(BUILDGAMBITCOMPILER) -:search=$(BUILDDIR) zipi/rts/hash
	$(BUILDGAMBITCOMPILER) -:search=$(BUILDDIR) zipi/rts/builtins
	# $(BUILDGAMBITCOMPILER) -:search=$(BUILDDIR) zipi/rts

install.gambit: zipi-install-symlink
	rm -rf $(ZIPIRTSDIR)
	cp -r $(BUILDRTSDIR) $(ZIPIRTSDIR)

clean.gambit:
	rm -rf hash/hash\@gambit*@C
	rm -rf rts\@gambit*@C
	rm -rf builtins
	rm -f $(BUILDDIR)/zipi
