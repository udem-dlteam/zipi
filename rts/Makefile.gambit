.PHONY: do.gambit build.gambit builtins

do.gambit: build.gambit

rts.sld: ../stdlib/zemantics.scm ../stdlib/behaviors.scm
	$(BUILDPYTHON) ../etc/scm_to_zipi.py -b gambit -s ../stdlib/zemantics.scm ../stdlib/behaviors.scm -t rts.sld.in -p @SLD_NAMES@ -i 4 > rts.sld

builtins: ../stdlib/builtins.sld
	mkdir -p builtins
	cp ../stdlib/builtins.sld ./builtins/builtins.sld

build.gambit: rts.sld rts.sld.in builtins
	gsc . zipi/rts

install.gambit:
	echo "install.gambit TODO"

clean.gambit:
	rm -rf rts\@gambit*@C
	rm -rf builtins
