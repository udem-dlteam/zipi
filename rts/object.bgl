;*---------------------------------------------------------------------*/
;*    & ...                                                            */
;*---------------------------------------------------------------------*/
(define-macro (& name)
   `',(string->symbol name))

;*---------------------------------------------------------------------*/
;*    PyObject-elements-ref ...                                        */
;*---------------------------------------------------------------------*/
(define-inline (PyObject-elements-ref obj offset)
   (with-access::PyObject obj (%elements)
      (vector-ref %elements offset)))

;*---------------------------------------------------------------------*/
;*    PyObject-elements-set! ...                                       */
;*---------------------------------------------------------------------*/
(define (PyObject-elements-set! obj offset val)
   (with-access::PyObject obj (%elements)
      (let ((len (vector-length %elements)))
	 (when (>= offset len)
	    (set! %elements (copy-vector %elements (*fx 2 (max 1 len)))))
	 (vector-set! %elements offset val))))

;*---------------------------------------------------------------------*/
;*    current-second ...                                               */
;*---------------------------------------------------------------------*/
(define-inline (current-second)
   (current-seconds))

;*---------------------------------------------------------------------*/
;*    object-repr ...                                                  */
;*---------------------------------------------------------------------*/
(define (object-repr self)
   (let* ((self-type (py-type self))
	  (self-type-name (py-str-to-scheme (type-name-fast-get self-type)))
	  (addr (object-hashnumber self))
	  (result (string-append "<" self-type-name " object at " addr ">")))
      (py-str-from-scheme result)))

;*---------------------------------------------------------------------*/
;*    bigloo-compatibility                                             */
;*---------------------------------------------------------------------*/
(define-macro (define-flop op x . y)
   `(define-inline (,(symbol-append 'fl op) ,x ,@y)
       (,(symbol-append op 'fl) ,x ,@y)))

(define-flop + x y)
(define-flop * x y)
(define-flop / x y)
(define-flop > x y)
(define-flop = x y)
(define-flop >= x y)
(define-flop < x y)
(define-flop <= x y)
(define-flop expt x y)
(define-flop round x)
(define-flop truncate x)
(define-flop floor x)
(define-flop ceiling x)

(define-inline (fl!= x y) (not (=fx x y)))

(define-inline (fl- x . y)
   (cond
      ((null? y) (negfl x))
      ((null? (cdr y)) (-fl x y))
      ((null? (cddr y)) (-fl x (+fl (car y) (cadr y))))
      ((null? (cdddr y)) (-fl x (+fl (car y) (+fl (cadr y) (caddr y)))))
      (else (-fl x (apply + y)))))

(define-macro (fl- x . y)
   (cond
      ((null? y) `(negfl ,x))
      ((null? (cdr y)) `(-fl ,x ,@y))
      (else ((@ fl- __py_object) ,x ,@y))))

(define-expander error
   (lambda (x e)
      (match-case x
	 ((?- ?msg)
	  (e `((@ error __error) "zipi" ,msg #f) e))
	 ((?- ?msg ?obj)
	  (e `((@ error __error) "zipi" ,msg ,obj) e))
	 ((?- ?proc ?msg ?obj)
	  (e `((@ error __error) (format "zipi(~a)" ,proc) ,msg ,obj) e))
	 ((?- ?proc ?msg ?obj . ?rest)
	  (e `((@ error __error) (format "zipi(~a)" ,proc) ,msg ,(format "~(, )" ,@rest)) e)))))

(define-inline (subvector vec start stop)
   (vector-copy vec start stop))

(define-inline (exact x)
   (cond
      ((fixnum? x) x)
      ((flonum? x) (flonum->fixnum x))
      (else (error "exact" (format "unexpected number type (~a)" (typeof x)) x))))

(define-inline (open-file name)
   (open-input-file name))

(define (close-port obj)
   (cond
      ((input-port? obj) (close-input-port obj))
      ((output-port? obj) (close-output-port obj))
      (else (bigloo-type-error "close-port" "port" obj))))

;*---------------------------------------------------------------------*/
;*    optimizations                                                    */
;*---------------------------------------------------------------------*/
(define-macro (result-to-float op)
   `(lambda (x y) (py-float-from-scheme (,op x y))))

