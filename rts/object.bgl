	   (py-delitem ::PyObject ::obj ::obj)
	   (py-setitem ::PyObject ::obj ::obj ::obj)

	   (inline PyObject-elements-ref ::PyObject ::long)
	   (PyObject-elements-set! ::PyObject ::long ::obj)
;*                                                                     */
;* 	   (PyObject-find-prop ::PyObject ::obj)                       */
;*                                                                     */
;* 	   (PyFunction-default-hclass)                                 */
;*                                                                     */

	   (py-call obj . args)
	   (py-call0 ::obj)
	   (py-call1 ::obj ::obj)
	   (py-call2 ::obj ::obj ::obj)
	   (py-call3 ::obj ::obj ::obj ::obj)
	   (py-call4 ::obj ::obj ::obj ::obj ::obj)
	   (py-call5 ::obj ::obj ::obj ::obj ::obj ::obj)

	   (py-make-global)
	   (py-make-base-global)
	   (py-make-caches ::int)

	   (py-make-class name module bases . atrs)

	   (py-throw ::obj)
;*                                                                     */
;* 	   (pyis?::bool x y)                                           */
	   (py-add x y cache)
	   (py-iadd x y cache)
	   (py-and x y cache)
	   (py-sub x y cache)
	   (py-div x y cache)
	   (py-mod x y cache)
	   (py-floordiv x y cache)
