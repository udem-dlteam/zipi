(include "rts-macros.scm")

;*---------------------------------------------------------------------*/
;*    object-print ::PyObject ...                                      */
;*---------------------------------------------------------------------*/
(define-method (object-print obj::PyObject op proc)
   (display "<" op)
   (display (typeof obj) op)
   (display ">" op))

;*---------------------------------------------------------------------*/
;*    display-py-string ...                                            */
;*---------------------------------------------------------------------*/
(define (display-py-string pystr::PyObjectStr op)
   (with-access::PyObjectStr pystr (part1-or-string)
      (display "<PyObjectStr:" op)
      (display
	 (if (string? part1-or-string) part1-or-string (typeof part1-or-string))
	 op)
      (display ">" op)))

;*---------------------------------------------------------------------*/
;*    object-print ::PyObjectStr ...                                   */
;*---------------------------------------------------------------------*/
(define-method (object-print obj::PyObjectStr op proc)
   (display-py-string obj op))

;*---------------------------------------------------------------------*/
;*    PyObject-type-get ...                                            */
;*---------------------------------------------------------------------*/
(define-inline (PyObject-type-get o)
   (object-class o))

;*---------------------------------------------------------------------*/
;*    PyObjectStr-type-get ...                                         */
;*---------------------------------------------------------------------*/
(define-inline (PyObjectStr-type-get o)
   (object-class o))

;*---------------------------------------------------------------------*/
;*    PyObject-elements-ref ...                                        */
;*---------------------------------------------------------------------*/
(define-inline (PyObject-elements-ref obj offset)
   (with-access::PyObject obj (%elements)
      (vector-ref %elements offset)))

;*---------------------------------------------------------------------*/
;*    PyObject-elements-set! ...                                       */
;*---------------------------------------------------------------------*/
(define (PyObject-elements-set! obj offset val)
   (with-access::PyObject obj (%elements)
      (let ((len (vector-length %elements)))
         (when (>= offset len)
            (set! %elements (copy-vector %elements (*fx 2 (max 1 len)))))
         (vector-set! %elements offset val))))

;*---------------------------------------------------------------------*/
;*    bigloo-compatibility                                             */
;*---------------------------------------------------------------------*/
(define-macro (define-flop op x . y)
   `(define-inline (,(symbol-append 'fl op) ,x ,@y)
       (,(symbol-append op 'fl) ,x ,@y)))

(define-flop + x y)
(define-flop * x y)
(define-flop / x y)
(define-flop > x y)
(define-flop = x y)
(define-flop >= x y)
(define-flop < x y)
(define-flop <= x y)
(define-flop expt x y)
(define-flop round x)
(define-flop truncate x)
(define-flop floor x)
(define-flop ceiling x)

(define-macro (current-directory) (pwd))

(define-inline (fl- x . y)
   (cond
      ((null? y) (negfl x))
      ((null? (cdr y)) (-fl x y))
      ((null? (cddr y)) (-fl x (+fl (car y) (cadr y))))
      ((null? (cdddr y)) (-fl x (+fl (car y) (+fl (cadr y) (caddr y)))))
      (else (-fl x (apply + y)))))

(define-macro (fl- x . y)
   (cond
      ((null? y) `(negfl ,x))
      ((null? (cdr y)) `(-fl ,x ,@y))
      (else ((@ fl- __py_rts) ,x ,@y))))

(define-expander error
   (lambda (x e)
      (match-case x
         ((?- ?msg)
          (e `((@ error __error) "zipi" ,msg #f) e))
         ((?- ?msg ?obj)
          (e `((@ error __error) "zipi" ,msg ,obj) e))
         ((?- ?proc ?msg ?obj)
          (e `((@ error __error) (format "zipi(~a)" ,proc) ,msg ,obj) e))
         ((?- ?proc ?msg ?obj . ?rest)
          (e `((@ error __error) (format "zipi(~a)" ,proc) ,msg ,(format "~(, )" ,@rest)) e)))))

(define-inline (subvector vec start stop)
   (vector-copy vec start stop))

(define-inline (exact x)
   (cond
      ((fixnum? x) x)
      ((flonum? x) (flonum->fixnum x))
      (else (error "exact" (format "unexpected number type (~a)" (typeof x)) x))))

(define-inline (exact-integer? x)
   (or (fixnum? x) (bignum? x)))

(define-inline (open-file name)
   (open-input-file name))

(define (close-port obj)
   (cond
      ((input-port? obj) (close-input-port obj))
      ((output-port? obj) (close-output-port obj))
      (else (bigloo-type-error "close-port" "port" obj))))

(define-inline (fxarithmetic-shift num shift)
   (bit-lsh num shift))

(define-inline (fxarithmetic-shift-right num shift)
   (bit-rsh num shift))

(define-inline (fxarithmetic-shift-left num shift)
   (bit-lsh num shift))

(define (integer-length n)
   (cond
      ((=fx n 0)
       0)
      ((>fx n 0)
       (let loop ((l 1)
                  (n (bit-rsh n 1)))
          (if (=fx n 0)
              l
              (loop (+fx l 1) (bit-ursh n 1)))))
      (else
       (integer-length (bit-not n)))))

(define-inline (box v)
   (make-cell v))

(define-inline (set-box! b v)
   (cell-set! b v))

(define-inline (unbox b)
   (cell-ref b))

(define-macro (define-type . args)
   `(define-struct ,@args))

;*---------------------------------------------------------------------*/
;*    optimizations                                                    */
;*---------------------------------------------------------------------*/
(define-macro (result-to-float op)
   `(lambda (x y) (py-float-from-scheme (,op x y))))

;*---------------------------------------------------------------------*/
;*    compile ...                                                      */
;*---------------------------------------------------------------------*/
(cond-expand
 (bigloo

  (define (compile-to-scheme root source target)

    (define-macro (get-build-path) (pwd))

    (define (root-dir)
      (get-build-path))

    (tprint "compile-to-scheme root=" root " source=" source " target=" target)
    (when (or (not (file-exists? target))
               (> (file-modification-time source)
                  (file-modification-time target)))
      (system (format "~a/pyc -t bigloo --no-main -d ~a ~a > ~a" (root-dir) root source target)))))

 (gambit

  (define (compile-to-scheme root source target)

    (define (root-dir)
      (path-expand ".." (path-directory (car (command-line)))))

    (when (or (not (file-exists? target))
               (> (time->seconds (file-last-modification-time source))
                  (time->seconds (file-last-modification-time target))))

      (shell-command
       (string-append
        (root-dir)
        "/py19 -t gambit --no-main -d "
        root
        " "
        source
        " > "
        target))))))

(define-rts (ensure-parent-dir-exists path)

  (define (wind path todo)
    (let* ((dir (path-strip-trailing-directory-separator
                 (path-directory path)))
           (fi (if (file-exists? dir)
                   dir
                   #f)))
      (if fi
          (if (eq? (file-type fi) 'directory)
              (unwind todo)
              (error (string-append "directory component can't be created: " fi)))
          (wind dir (cons dir todo)))))

  (define (unwind todo)
    (if (pair? todo)
        (begin
          (make-directory (car todo))
          (unwind (cdr todo)))))

  (wind path '()))


(define-rts (compile-to-cache path path-info path-in-cache)
  (let* ((path-cache
           (string-append
             (cache-location-get)
             "/"
             path-in-cache
             "/"
             (path-strip-directory path-in-cache)
             ".so"))
         )

    ;; compile file and return #f if compilation failed
    (define (compile)
      (ensure-parent-dir-exists path-cache)
      (and (file-exists? path)
           (fx= 0 (compile-source path path-cache))))


    (if (file-exists? path-cache)
        ;; check according to modified date
        (if (< (time->seconds (file-modification-time path-info))
               (time->seconds (file-modification-time path-cache)))
            (begin
              (possible-error 1 "skipping compilation of unmodified file at " path ", compiled file found : " path-cache "\n")
              #t) ;; compilation "successful" (file already compiled)
            (compile))
        (compile)))) ;; compiled file does not exist (must compile)

;*---------------------------------------------------------------------*/
;*    load-module-and-get-init ...                                     */
;*---------------------------------------------------------------------*/
(define (load-module-and-get-init path-in-cache)
  (let* ((libname
          (string-append
           (cache-location-get)
           "/"
           path-in-cache
           "/"
           (path-strip-directory path-in-cache)
           ".so"))
         (module-name
          (string-append "%%/" path-in-cache)))

    (dynamic-load libname)
    ;; should be changed
    #;init
    #;(let ((dlsym (dynamic-load-symbol libname "init" module-name)))
      (when dlsym
        (dynamic-load-symbol-get dlsym)))))

;*---------------------------------------------------------------------*/
;*    PCache-set! ...                                                  */
;*---------------------------------------------------------------------*/
(define-inline (PCache-set! pc hc i)
   (with-access::PCache pc (hclass index)
      (set! hclass hc)
      (set! index i)))

;*---------------------------------------------------------------------*/
;*    HClass-transition-add! ...                                       */
;*---------------------------------------------------------------------*/
(define (HClass-transition-add! hc tran target)
   (with-access::HClass hc (transitions)
      (set! transitions (cons (cons tran target) transitions))))

;*---------------------------------------------------------------------*/
;*    HClass-last-index ...                                            */
;*---------------------------------------------------------------------*/
(define-inline (HClass-last-index hclass)
   (-fx (vector-length (HClass-names hclass)) 1))

(define-macro (make-pcache)
 `(make-PCache '() -1))

(define-macro (pcache-hclass pc)
 `(PCache-hclass ,pc))

(define-macro (pcache-index pc)
 `(PCache-index ,pc))

(define-macro (pcache-set! pc hc i)
 `(let (($pc ,pc))
    (PCache-hclass-set! $pc ,hc)
    (PCache-index-set! $pc ,i)))

(define-macro (make-hclass names)
 `(make-HClass ,names '()))

(define-macro (hclass-names hclass)
 `(HClass-names ,hclass))

(define-macro (hclass-transitions hclass)
 `(HClass-transitions ,hclass))

(define (make-still-copy o)
   o)

(define-inline (subvector-move! src-vector src-start src-end dst-vector dst-start)
   (vector-copy! dst-vector dst-start src-vector src-start src-end))

;*---------------------------------------------------------------------*/
;*    registered-constants-table ...                                   */
;*---------------------------------------------------------------------*/
(define registered-constants-table
   (let ((table (create-hashtable :eqtest string=?)))
      table))

;*---------------------------------------------------------------------*/
;*    get-registered-constants-table ...                               */
;*---------------------------------------------------------------------*/
(define (get-registered-constants-table)
   registered-constants-table)

;*---------------------------------------------------------------------*/
;*    &pystring-init ...                                               */
;*---------------------------------------------------------------------*/
(define (&pystring-init str)
   (string->obj str))

;*---------------------------------------------------------------------*/
;*    profiling                                                        */
;*---------------------------------------------------------------------*/
(define (statprof-begin kind)
   #unspecified)

(define (statprof-end dir)
   #unspecified)

;*---------------------------------------------------------------------*/
;*    py-init-registered-constants ...                                 */
;*---------------------------------------------------------------------*/
(define (py-init-registered-constants strings)
   (cond
      ((not py-str-class)
       (error "py-init-registered-constants"
	  "py-str-class not inialized" py-str-class))
      ((not py-str-hclass-of-instances)
       (error "py-init-registered-constants"
	  "py-str-class not inialized"
	  py-str-hclass-of-instances))
      (else
       (vector-map! (lambda (s)
		       (let ((str (vector-ref s 1)))
			  (or (table-ref (get-registered-constants-table) str)
			      (let ((o (instantiate::PyObjectStrRep
					  (len (string-length str))
					  (part1-or-string str)
					  (part2-or-rep #f)
					  (hash 0)
					  (magic-index #f)
					  (hclass py-str-hclass-of-instances)
					  (class py-str-class))))
				 (with-access::PyObjectStrRep o (part2-or-rep)
				    (set! part2-or-rep o))
				 (table-set! (get-registered-constants-table)
				    str o)
				 o))))
	  strings))))

;*---------------------------------------------------------------------*/
;*    string-split ...                                                 */
;*---------------------------------------------------------------------*/
(define-macro (string-split str delim)
   `((@ string-split __r4_strings_6_7)
     ,str
     ,(if (char? delim)
          (string delim)
          `(if (string? ,delim) ,delim (string ,delim)))))

;*---------------------------------------------------------------------*/
;*    native-builtin-__import__ ...                                    */
;*---------------------------------------------------------------------*/
(define (native-builtin-__import__ name)
  (if (string=? name "builtins")
      ((@ init __stdlib_builtins)
       (& "builtins")
       (& "")
       #f)
      #f))

;*---------------------------------------------------------------------*/
;*    constants                                                        */
;*---------------------------------------------------------------------*/
(start-registering-constants)

;*---------------------------------------------------------------------*/
