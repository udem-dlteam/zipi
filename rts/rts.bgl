;*---------------------------------------------------------------------*/
;*    The module                                                       */
;*---------------------------------------------------------------------*/
(module __py_rts
   
   (include "rts.sch"
	    "constants.sch"
	    "names.sch")
   
   (import __py_bigloo
	   __py_configure
           ./builtins.py)
   
   (export (class PyObject
	      (hclass (default #f))
	      (%elements (default (make-vector 4)))
	      class)
	   
	   (class PyFunction::PyObject
	      (procedure read-only))

	   (class PyObjectType::PyObject
	      bases
	      mro
	      hclass-of-instances)

	   (abstract-class PyObjectNumber::PyObject
	      value)
	   
	   (class PyObjectInt::PyObjectNumber)
	   (class PyObjectFloat::PyObjectNumber)
	   (class PyObjectComplex::PyObjectNumber)

	   (class PyObjectList::PyObject
	      value)

	   (class PyObjectListIterator::PyObject
	      index
	      list)
	   
	   (class PyObjectBytearray::PyObject
	      value)

	   (class PyObjectBytearrayIterator::PyObject
	      index
	      bytearray)

	   (class PyObjectStr::PyObject
	      value
	      representative)

	   (class PyObjectFunction::PyObject
	      procedure
	      arity
	      signature)

	   (class PyObjectMethod::PyObject
	      procedure
	      arity
	      signature)

	   (class PyObjectDict::PyObject
	      value)

	   (class PyObjectSet::PyObject
	      value)
	   
	   (class PyObjectTuple::PyObject
	      value)
	   
	   (class PyObjectTupleIterator::PyObject
	      index
	      vec)
	   
	   (class PyObjectDictKeyIterator::PyObject
	      node
	      iterator-token)
	   
	   (class PyObjectSlice::PyObject
	      start
	      stop
	      step)
	   
	   (class PyObjectTextIOWrapper::PyObject
	      port
	      mode
	      encoding)
	   
	   (macro & name)
	   (macro &&)
	   (macro start-registering-constants)
	   
	   (inline PyObject-type-get o)
	   (inline PyObjectStr-type-get o)
	   
	   (global-get ::PyObject ::obj ::obj)
	   (global-put! global name val cache)

	   (object-get ::obj ::obj ::obj)
	   (object-put! ::PyObject ::obj ::obj ::obj)
	   (getattribute-from-obj-mro ::obj ::obj)
	   
	   (py-make-list . elements)

	   (py-getitem ::PyObject ::obj ::obj)
	   (py-delitem ::PyObject ::obj ::obj)
	   (py-setitem ::PyObject ::obj ::obj ::obj)
	   
	   (inline PyObject-elements-ref ::PyObject ::long)
	   (PyObject-elements-set! ::PyObject ::long ::obj)
	   
	   (py-call obj . args)
	   (py-call0 ::obj)
	   (py-call1 ::obj ::obj)
	   (py-call2 ::obj ::obj ::obj)
	   (py-call3 ::obj ::obj ::obj ::obj)
	   (py-call4 ::obj ::obj ::obj ::obj ::obj)
	   (py-call5 ::obj ::obj ::obj ::obj ::obj ::obj)
	   
	   (py-make-global)
	   (py-make-caches ::int)
	   
	   (py-make-class name module bases . atrs)
	   
	   (py-throw ::obj)
	   
	   (py-add x y cache)
	   (py-iadd x y cache)
	   (py-and x y cache)
	   (py-sub x y cache)
	   (py-div x y cache)
	   (py-mod x y cache)
	   (py-floordiv x y cache)
	   (py-eq x y cache)
	   (py-ne x y cache)
	   (py-lt x y cache)
	   (py-le x y cache)
	   (py-gt x y cache)
	   (py-ge x y cache)
	   (py-is x y cache)
	   (py-isnot x y cache)
	   (py-in x y cache)
	   (py-notin x y cache)
	   (py-neg x cache)
	   (py-not x cache)

	   py-None
           py-absent
	   
	   py-True
	   py-False
	   
	   (py-test obj)
	   
	   py-object-class
	   py-module-class
	   
	   (py-isinstance? ::PyObject ::PyObject)
	   
	   py-builtin-StopIteration
	   
	   (py-slice-from-scheme ::obj ::obj ::obj)
	   
           (py-obj-alloc cls hclass-of-instances)
	   (py-str-from-scheme::PyObject ::bstring)
	   (py-str-to-scheme::bstring ::PyObject)
	   
	   procedure->py-function
	   
	   (py-int-from-scheme value)
	   (py-float-from-scheme value)
	   
	   (py-import path depth)
	   py-import-root
	   
	   (class PyGenerator::PyObject %next)
	   (py-make-generator ::procedure)
	   (py-generator-yield ::PyGenerator ::obj ::procedure)
	   (py-next ::obj)
	   
	   (class PCache
	      (hclass (default (class-nil HClass)))
	      (index::long (default -1)))
	   
	   (class HClass
	      (names::vector (default '#()))
	      (transitions::pair-nil (default '())))

	   (inline PCache-set! ::PCache ::HClass ::long)
	   (inline HClass-last-index::long ::HClass)
	   )
      
   (eval   (export-all)))

;*---------------------------------------------------------------------*/
;*    & ...                                                            */
;*---------------------------------------------------------------------*/
(define-macro (& name)
   `',(string->symbol name))

;*---------------------------------------------------------------------*/
;*    && ...                                                           */
;*---------------------------------------------------------------------*/
(define-macro (&& e)
   `(& ,e))

;*---------------------------------------------------------------------*/
;*    start-registering-constants ...                                  */
;*---------------------------------------------------------------------*/
(define-macro (start-registering-constants . l)
   '(define __js_strings (&begin!)))

;*---------------------------------------------------------------------*/
;*    end-registering-constants ...                                    */
;*---------------------------------------------------------------------*/
(define-macro (end-registering-constants)
   '(&end!))

;*---------------------------------------------------------------------*/
;*    init-registered-constants ...                                    */
;*---------------------------------------------------------------------*/
(define-macro (init-registered-constants)
   '(&init!))
   
;*---------------------------------------------------------------------*/
;*    PyObject-type-get ...                                            */
;*---------------------------------------------------------------------*/
(define-inline (PyObject-type-get o)
   (object-class o))

;*---------------------------------------------------------------------*/
;*    PyObjectStr-type-get ...                                         */
;*---------------------------------------------------------------------*/
(define-inline (PyObjectStr-type-get o)
   (object-class o))

;*---------------------------------------------------------------------*/
;*    PyObject-elements-ref ...                                        */
;*---------------------------------------------------------------------*/
(define-inline (PyObject-elements-ref obj offset)
   (with-access::PyObject obj (%elements)
      (vector-ref %elements offset)))

;*---------------------------------------------------------------------*/
;*    PyObject-elements-set! ...                                       */
;*---------------------------------------------------------------------*/
(define (PyObject-elements-set! obj offset val)
   (with-access::PyObject obj (%elements)
      (let ((len (vector-length %elements)))
	 (when (>= offset len)
	    (set! %elements (copy-vector %elements (*fx 2 (max 1 len)))))
	 (vector-set! %elements offset val))))

;*---------------------------------------------------------------------*/
;*    bigloo-compatibility                                             */
;*---------------------------------------------------------------------*/
(define-macro (define-flop op x . y)
   `(define-inline (,(symbol-append 'fl op) ,x ,@y)
       (,(symbol-append op 'fl) ,x ,@y)))

(define-flop + x y)
(define-flop * x y)
(define-flop / x y)
(define-flop > x y)
(define-flop = x y)
(define-flop >= x y)
(define-flop < x y)
(define-flop <= x y)
(define-flop expt x y)
(define-flop round x)
(define-flop truncate x)
(define-flop floor x)
(define-flop ceiling x)

(define-macro (current-directory) (pwd))

(define-inline (fl- x . y)
   (cond
      ((null? y) (negfl x))
      ((null? (cdr y)) (-fl x y))
      ((null? (cddr y)) (-fl x (+fl (car y) (cadr y))))
      ((null? (cdddr y)) (-fl x (+fl (car y) (+fl (cadr y) (caddr y)))))
      (else (-fl x (apply + y)))))

(define-macro (fl- x . y)
   (cond
      ((null? y) `(negfl ,x))
      ((null? (cdr y)) `(-fl ,x ,@y))
      (else ((@ fl- __py_rts) ,x ,@y))))

(define-expander error
   (lambda (x e)
      (match-case x
	 ((?- ?msg)
	  (e `((@ error __error) "zipi" ,msg #f) e))
	 ((?- ?msg ?obj)
	  (e `((@ error __error) "zipi" ,msg ,obj) e))
	 ((?- ?proc ?msg ?obj)
	  (e `((@ error __error) (format "zipi(~a)" ,proc) ,msg ,obj) e))
	 ((?- ?proc ?msg ?obj . ?rest)
	  (e `((@ error __error) (format "zipi(~a)" ,proc) ,msg ,(format "~(, )" ,@rest)) e)))))

(define-inline (subvector vec start stop)
   (vector-copy vec start stop))

(define-inline (exact x)
   (cond
      ((fixnum? x) x)
      ((flonum? x) (flonum->fixnum x))
      (else (error "exact" (format "unexpected number type (~a)" (typeof x)) x))))

(define-inline (open-file name)
   (open-input-file name))

(define (close-port obj)
   (cond
      ((input-port? obj) (close-input-port obj))
      ((output-port? obj) (close-output-port obj))
      (else (bigloo-type-error "close-port" "port" obj))))

(define-inline (fxarithmetic-shift num shift)
   (bit-lsh num shift))

(define (integer-length n)
   (cond
      ((=fx n 0)
       0)
      ((>fx n 0)
       (let loop ((l 1)
		  (n (bit-rsh n 1)))
	  (if (=fx n 0)
	      l
	      (loop (+fx l 1) (bit-ursh n 1)))))
      (else
       (integer-length (bit-not n)))))

(define-inline (box v)
   (make-cell v))

(define-inline (set-box! b v)
   (cell-set! b v))

(define-inline (unbox b)
   (cell-ref b))

(define-macro (define-type . args)
   `(define-struct ,@args))

;*---------------------------------------------------------------------*/
;*    optimizations                                                    */
;*---------------------------------------------------------------------*/
(define-macro (result-to-float op)
   `(lambda (x y) (py-float-from-scheme (,op x y))))

;*---------------------------------------------------------------------*/
;*    compile ...                                                      */
;*---------------------------------------------------------------------*/
(cond-expand
 (bigloo

  (define (compile-to-scheme root source target)

    (define-macro (get-build-path) (pwd))

    (define (root-dir)
      (or (getenv "ZIPIROOT")
          (get-build-path)))

    (when (or (not (file-exists? target))
	       (> (file-modification-time source)
		  (file-modification-time target)))
      (system (format "~a/pyc -t bigloo --no-main -d ~a ~a > ~a" (root-dir) root source target)))))

 (gambit

  (define (compile-to-scheme root source target)

    (define (root-dir)
      (or (getenv "ZIPIROOT")
          (path-expand ".." (path-directory (car (command-line))))))

    (when (or (not (file-exists? target))
	       (> (time->seconds (file-last-modification-time source))
		  (time->seconds (file-last-modification-time target))))

      (shell-command
       (string-append
        (root-dir)
        "/py19 -t gambit --no-main -d "
        root
        " "
        source
        " > "
        target))))))

;*---------------------------------------------------------------------*/
;*    PCache-set! ...                                                  */
;*---------------------------------------------------------------------*/
(define-inline (PCache-set! pc hc i)
   (with-access::PCache pc (hclass index)
      (set! hclass hc)
      (set! index i)))

;*---------------------------------------------------------------------*/
;*    HClass-transition-add! ...                                       */
;*---------------------------------------------------------------------*/
(define (HClass-transition-add! hc tran target)
   (with-access::HClass hc (transitions)
      (set! transitions (cons (cons tran target) transitions))))

;*---------------------------------------------------------------------*/
;*    HClass-last-index ...                                            */
;*---------------------------------------------------------------------*/
(define-inline (HClass-last-index hclass)
   (-fx (vector-length (HClass-names hclass)) 1))

(define-macro (make-pcache)
 `(make-PCache '() -1))

(define-macro (pcache-hclass pc)
 `(PCache-hclass ,pc))

(define-macro (pcache-index pc)
 `(PCache-index ,pc))

(define-macro (pcache-set! pc hc i)
 `(let (($pc ,pc))
    (PCache-hclass-set! $pc ,hc)
    (PCache-index-set! $pc ,i)))

(define-macro (make-hclass names)
 `(make-HClass ,names '()))

(define-macro (hclass-names hclass)
 `(HClass-names ,hclass))

(define-macro (hclass-transitions hclass)
 `(HClass-transitions ,hclass))

(define (make-still-copy o)
   o)

;*---------------------------------------------------------------------*/
;*    get-registered-constants-table ...                               */
;*---------------------------------------------------------------------*/
(define (get-registered-constants-table)
   (let ((table (create-hashtable :eqtest string=?)))
      (vector-for-each (lambda (v)
			  (hashtable-put! table "foo" v))
	 __js_strings)
      table))

;*---------------------------------------------------------------------*/
;*    &pystring-init ...                                               */
;*---------------------------------------------------------------------*/
(define (&pystring-init str)
   (string->obj str))

;*---------------------------------------------------------------------*/
;*    profiling                                                        */
;*---------------------------------------------------------------------*/
(define (statprof-begin)
   #unspecified)

(define (statprof-end dir)
   #unspecified)

