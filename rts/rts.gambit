;*---------------------------------------------------------------------*/
;*    Gambit compatibility                                             */
;*---------------------------------------------------------------------*/

(define-macro (with-handler handler . body)
  `(with-exception-catcher
      ,handler
      (lambda ()
        ,@body)))

(define-macro (bind-exit exit . body)
`(call/cc
    (lambda ,exit
      ,@body)))

(define-macro (make-cell e)
  `(box ,e))

(define-macro (cell-ref c)
  `(unbox ,c))

(define-macro (cell-set! c e)
  `(set-box! ,c ,e))

(define-macro (structure-ref obj i)
  `(##unchecked-structure-ref ,obj , i #f #f))

(define-macro (structure-set! obj i val)
  `(##unchecked-structure-set! ,obj ,val ,i #f #f))

(define-macro (structure-type obj)
  `(##structure-type ,obj))

(define-macro (structure-type-set! obj tp)
  `(##structure-type-set! ,obj ,tp))

(define-macro (module-search-order-add! path)
  `(##module-search-order-add! ,path))

(define-macro (module-search-order)
  '##module-search-order)

;; debugging utility
(define (why-am-i-here?)
  (##continuation-capture (lambda (cc) (display-continuation-backtrace cc))))

(define (debug-get-list obj nums)
  (let loop ((obj obj) (nums nums))
   (if (pair? nums)
       (loop (##vector-ref obj (car nums)) (cdr nums))
       obj)))

(define (debug-get obj . nums)
  (debug-get-list obj nums))

(define (debug-ref obj . nums)
  (debug-get-list obj (fold-right (lambda (x y) (cons 2 (cons x y))) '() nums)))

(define (debug-value-get obj)
  (debug-get obj 2 1))

(define (debug-class-name-get obj)
  (debug-get obj 2 0 2 4 2 1))

(define (debug-catch thunk)
  (with-exception-catcher 
    (lambda (e) (if (PyObject? e) (print-exception e) (raise e))) 
    thunk))

(define (object-repr self)
  (let* ((self-type (py-type self))
         (self-type-name (py-str-to-scheme (type-name-fast-get self-type)))
         (addr (integer->hex-string (##object->encoding self)))
         (result (string-append "<" self-type-name " object at " addr ">")))
    (py-str-from-scheme result)))

(define (read-string port)
   (list->string (read-all port read-char)))

(define (compile-to-cache path)
  (let* ((path-cache 
           (string-append
             (path-expand  "~~zipicache/cache")
             (path-strip-extension path)
             ".scm"))
         (path-info (##file-info path #t #f))
         (path-cache-info (##file-info path-cache #t #f)))

    ;; compile file and return #f if compilation failed
    (define (compile)
      (fx= 0 
           (begin
             (ensure-parent-dir-exists path-cache)
             (compile-source path path-cache))))


    (if path-info
        (if path-cache-info
            ;; check according to modified date
            (if (< (time->seconds (file-info-last-modification-time path-info))
                   (time->seconds (file-info-last-modification-time path-cache-info)))
                (begin 
                  (print-debug 1 "WARNING : skipping compilation of unmodified file at " path ", compiled file found : " path-cache "\n") 
                  #t) ;; compilation "succesfull" (file already compiled)
                (compile)) 
            (compile)) ;; compiled file does not exist (must compile)
        #f))) ;; file to compile does not exist (failed compilation)
 
(define (load-module-and-get-init name)
  (let* ((sym (string->symbol name))
         (modref (##parse-module-ref sym)))
    (if modref
        (with-exception-catcher
          (lambda (exn)
            (if (module-not-found-exception? exn)
                #f
                (raise exn)))
          (lambda ()
            (##load-module sym)
            (let ((init (##module-var-ref modref 'init)))
             (if (procedure? init)
                 init
                 #f))))
        #f)))
