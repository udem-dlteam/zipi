;*---------------------------------------------------------------------*/
;*    Gambit compatibility                                             */
;*---------------------------------------------------------------------*/

;; (gambit prim) exports "import" as "##import", which since Gambit v4.9.4
;; does not handle R7RS libraries. Keep the R7RS "import" (it is used in
;; bootstrap-builtins to load the builtins module).
(import (except (gambit prim) import))

(declare (standard-bindings) (extended-bindings) (not safe) (block))

(define-macro (bind-exit exit . body)
  `(##continuation-capture
    (lambda ($cont)
      (let ((,(car exit)
             (lambda (result)
               (##continuation-return $cont result))))
        ,@body))))

;; append-strings was renamed string-concatenate in Gambit v4.9.4
(define-macro (append-strings . args)
  `(string-concatenate ,@args))

(define-macro (make-cell e)
  `(box ,e))

(define-macro (cell-ref c)
  `(unbox ,c))

(define-macro (cell-set! c e)
  `(set-box! ,c ,e))

(namespace ("##" parse-module-ref load-module module-var-ref))

(define-macro (module-search-order-add! path)
  `(##module-search-order-add! ,path))

(define-macro (module-search-order)
  '##module-search-order)

(define-macro (make-still-copy s)
  `(##still-obj-refcount-inc!
    (##still-copy ,s)))

(define-macro (u8= x y)
  `(fx= ,x ,y))

(define-macro (u8> x y)
  `(fx> ,x ,y))

(define-macro (u8< x y)
  `(fx< ,x ,y))

(define-macro (u8>= x y)
  `(fx>= ,x ,y))

(define-macro (u8=< x y)
  `(fx=< ,x ,y))

(define-macro (structure-ref s i)
  `(##unchecked-structure-ref ,s ,i #f #f))

(define-macro (structure-type s)
  `(##structure-type ,s))

(define-macro (structure-type-set! s t)
  `(##structure-type-set! ,s ,t))

(define-macro (type-name t)
  `(##type-name ,t))

;; ##max-fixnum was replaced by (##greatest-fixnum) in Gambit v4.9.4
(define max-fixnum (##greatest-fixnum))

(define (vector-map! proc vec)
   (let loop ((i (fx- (vector-length vec) 1)))
      (if (fx>= i 0)
	  (begin
	     (vector-set! vec i (proc (vector-ref vec i)))
	     (loop (fx- i 1)))
	  vec)))

(define (init-constants constants)
  (vector-for-each
   (lambda (obj)
      (case (type-name (structure-type obj))
        ((StaticPyObjectStr)
         (structure-type-set! obj (PyObjectStr-type-get)))
        ((StaticPyObjectStrRep)
         (structure-type-set! obj (PyObjectStrRep-type-get))))

      (PyObject-hclass-set! obj py-str-hclass-of-instances)
      (PyObject-class-set! obj py-str-class))
    (structure-ref constants 2)))

;; debugging utility
(define (why-am-i-here?)
  (##continuation-capture (lambda (cc) (display-continuation-backtrace cc))))

(define (debug-get-list obj nums)
  (let loop ((obj obj) (nums nums))
   (if (pair? nums)
       (loop (##vector-ref obj (car nums)) (cdr nums))
       obj)))

(define (debug-get obj . nums)
  (debug-get-list obj nums))

(define (debug-ref obj . nums)
  (debug-get-list obj (fold-right (lambda (x y) (cons 2 (cons x y))) '() nums)))

(define (debug-value-get obj)
  (debug-get obj 2 1))

(define (debug-class-name-get obj)
  (debug-get obj 2 0 2 4 2 1))

(define (debug-catch thunk)
  (py-try-except
    (lambda (e)(print-exception e))
    thunk))

(define (read-string port) ;; TODO: change name so it doesn't clash with predefined one
  (read-line port #f))


;; statprof

;; A procedure solely used by statprof to check if Zipi has been compiled
;; with the right debug flags
(define (%statprof-thunk) #f)

(define (statprof-begin kind)
  (if (not (##subprocedure-info %statprof-thunk))
      (println "*** Profiling without debug location for RTS. For better profiling, recompile RTS with 'gsc -debug -debug-location . zipi/rts'."))
  ((eval
    '(lambda (kind)
       (import (github.com/gambit/statprof))
       (statprof-start! kind)))
   '(profile flamegraph)))

(define (statprof-end path)
  (let ((profile-dir (path-expand (string-append path ".statprof"))))
    ((eval
      `(lambda (profile-dir)
         (import (github.com/gambit/statprof))
         (statprof-stop!)
         (statprof-write! profile-dir)))
     profile-dir)))

(define (load-module-and-get-init name)
  (let* ((sym (string->symbol name))
         (modref (parse-module-ref sym)))
    (if modref
        (continuation-capture
         (lambda (abort)
           (with-exception-handler
               (lambda (exn)
                 (if (module-not-found-exception? exn)
                     (continuation-return abort #f)
                     (##repl-debug)))
             (lambda ()
               (load-module sym)
               (let ((init (module-var-ref modref 'init)))
                 (if (procedure? init)
                     init
                     #f))))))
        #f)))

(define (compile-source source dest)

  (define root-dir
    (path-expand "~~zipiroot"))

  (define zpc-path
    (path-expand "bin/zpc.gambit" root-dir))

  (if (not (file-exists? zpc-path))
      (fatal-error
        "cannot find zpc.gambit executable."))

  (possible-error 1 "compiling file " source " to " dest " \n")

  (let* ((output
          (shell-command
           (string-append
            (if debug-flag
                "ZPC_DEBUG=true "
                "ZPC_DEBUG=false ")
            zpc-path
            " -t gambit "
            root-dir
            " "
            source)
           #t))
         (status
          (car output)))
    (if (= status 0)
        (call-with-output-file
            dest
          (lambda (port) (display (cdr output) port)))
        (display (cdr output)))
    status))

(define-rts (ensure-parent-dir-exists path)

  (define (wind path todo)
    (let* ((dir (path-strip-trailing-directory-separator
                  (path-directory path)))
           (fi (with-exception-handler
                 (lambda (exc) #f)
                 (lambda () (file-info dir)))))
      (if fi
          (if (eq? (file-info-type fi) 'directory)
              (unwind todo)
              (error (string-append "directory component can't be created: " fi)))
          (wind dir (cons dir todo)))))

  (define (unwind todo)
    (if (pair? todo)
        (begin
          (create-directory (car todo))
          (unwind (cdr todo)))))

  (wind path '()))


(define-rts (compile-to-cache path path-info path-in-cache)
  (let* ((path-cache
           (string-append
             (cache-location-get)
             "/"
             path-in-cache
             "/"
             (path-strip-directory path-in-cache)
             ".sld"))
         (path-cache-info (file-info path-cache #t #f)))

    (define (create-_must-build_)
      ;; create empty "._must-build_" file
      (if compile-flag
          (let ((_must-build_-path
                  (string-append (path-strip-extension path-cache) "._must-build_")))
            (if compile-flag
                (with-output-to-file _must-build_-path list)
                (delete-file _must-build_-path)))))

    ;; compile file and return #f if compilation failed
    (define (compile)
      (ensure-parent-dir-exists path-cache)
      (create-_must-build_)
      (fx= 0 (compile-source path path-cache)))

    (if path-cache-info
        ;; check according to modified date
        (if (< (time->seconds (file-info-last-modification-time path-info))
               (time->seconds (file-info-last-modification-time path-cache-info)))
            (begin
              (possible-error 1 "skipping compilation of unmodified file at " path ", compiled file found : " path-cache "\n")
              (create-_must-build_)
              #t) ;; compilation "successful" (file already compiled)
            (compile))
        (compile)))) ;; compiled file does not exist (must compile)

;; homebrewed exception handling

(define (native-exception? exc)
  (uncaught-exception? exc))

;; WARNING exception are returned inside a pair
;; using py-try-except to return a pair will fail
(define-macro (py-try-except-else handler body orelse)
  `(let* ((##py-try-except-body
             (let ()
               (declare (not inline))
               (lambda ()
                 (declare (inline))
                 (,body))))
            (##py-try-except-marker
             (##first-argument #f))
            (##exception-or-result
             (let ()
               (declare (environment-map))
               (##first-argument
                 (##py-try-except-body)
                 ##py-try-except-marker))))
     (if (pair? ##exception-or-result)
       (,handler (car ##exception-or-result))
       (,orelse ##exception-or-result))))

(define-macro (py-try-except handler body)
  `(py-try-except-else ,handler ,body (lambda (x) x)))

;; throw an exception without checking it is an instance of BaseException
(define (py-throw-unsafe exn)
  (##continuation-capture
   (lambda (cont)
     (let loop ((cont cont))
       (if (not cont)
           (error "uncaught Python exception" exn)
           (if (if (##interp-continuation? cont)
                   (let ((x (##cte-lookup
                             (##vector-ref (##interp-continuation-code cont) 2)
                             '##py-try-except-marker)))
                     (##eq? (##vector-ref x 0) 'not-found))
                   (not (pair? (##continuation-locals cont '##py-try-except-marker))))
               (loop (##continuation-next! cont))
               (##continuation-return cont (cons exn '()))))))))

;; builtin bootstrap

(define (bootstrap-builtins)
  (import (zipi rts builtins))

  (let ((builtins-mod (init-builtin-module (& "builtins") (& "") #f)))

    ;; builtin functions
    (set! py-builtin-sorted &py-builtin-sorted)

    ;; Exceptions
    (set! py-builtin-ArithmeticError &py-builtin-ArithmeticError)
    (set! py-builtin-AssertionError &py-builtin-AssertionError)
    (set! py-builtin-AttributeError &py-builtin-AttributeError)
    (set! py-builtin-BaseException &py-builtin-BaseException)
    (set! py-builtin-BlockingIOError &py-builtin-BlockingIOError)
    (set! py-builtin-BrokenPipeError &py-builtin-BrokenPipeError)
    (set! py-builtin-BufferError &py-builtin-BufferError)
    (set! py-builtin-BytesWarning &py-builtin-BytesWarning)
    (set! py-builtin-ChildProcessError &py-builtin-ChildProcessError)
    (set! py-builtin-ConnectionAbortedError &py-builtin-ConnectionAbortedError)
    (set! py-builtin-ConnectionError &py-builtin-ConnectionError)
    (set! py-builtin-ConnectionRefusedError &py-builtin-ConnectionRefusedError)
    (set! py-builtin-ConnectionResetError &py-builtin-ConnectionResetError)
    (set! py-builtin-DeprecationWarning &py-builtin-DeprecationWarning)
    (set! py-builtin-EOFError &py-builtin-EOFError)
    (set! py-builtin-EnvironmentError &py-builtin-EnvironmentError)
    (set! py-builtin-Exception &py-builtin-Exception)
    (set! py-builtin-FileExistsError &py-builtin-FileExistsError)
    (set! py-builtin-FileNotFoundError &py-builtin-FileNotFoundError)
    (set! py-builtin-FloatingPointError &py-builtin-FloatingPointError)
    (set! py-builtin-FutureWarning &py-builtin-FutureWarning)
    (set! py-builtin-GeneratorExit &py-builtin-GeneratorExit)
    (set! py-builtin-IOError &py-builtin-IOError)
    (set! py-builtin-ImportError &py-builtin-ImportError)
    (set! py-builtin-ImportWarning &py-builtin-ImportWarning)
    (set! py-builtin-IndentationError &py-builtin-IndentationError)
    (set! py-builtin-IndexError &py-builtin-IndexError)
    (set! py-builtin-InterruptedError &py-builtin-InterruptedError)
    (set! py-builtin-IsADirectoryError &py-builtin-IsADirectoryError)
    (set! py-builtin-KeyError &py-builtin-KeyError)
    (set! py-builtin-KeyboardInterrupt &py-builtin-KeyboardInterrupt)
    (set! py-builtin-LookupError &py-builtin-LookupError)
    (set! py-builtin-MemoryError &py-builtin-MemoryError)
    (set! py-builtin-ModuleNotFoundError &py-builtin-ModuleNotFoundError)
    (set! py-builtin-NameError &py-builtin-NameError)
    (set! py-builtin-NotADirectoryError &py-builtin-NotADirectoryError)
    (set! py-builtin-NotImplementedError &py-builtin-NotImplementedError)
    (set! py-builtin-OSError &py-builtin-OSError)
    (set! py-builtin-OverflowError &py-builtin-OverflowError)
    (set! py-builtin-PendingDeprecationWarning &py-builtin-PendingDeprecationWarning)
    (set! py-builtin-PermissionError &py-builtin-PermissionError)
    (set! py-builtin-ProcessLookupError &py-builtin-ProcessLookupError)
    (set! py-builtin-RecursionError &py-builtin-RecursionError)
    (set! py-builtin-ReferenceError &py-builtin-ReferenceError)
    (set! py-builtin-ResourceWarning &py-builtin-ResourceWarning)
    (set! py-builtin-RuntimeError &py-builtin-RuntimeError)
    (set! py-builtin-RuntimeWarning &py-builtin-RuntimeWarning)
    (set! py-builtin-StopAsyncIteration &py-builtin-StopAsyncIteration)
    (set! py-builtin-StopIteration &py-builtin-StopIteration)
    (set! py-builtin-SyntaxError &py-builtin-SyntaxError)
    (set! py-builtin-SyntaxWarning &py-builtin-SyntaxWarning)
    (set! py-builtin-SystemError &py-builtin-SystemError)
    (set! py-builtin-SystemExit &py-builtin-SystemExit)
    (set! py-builtin-TabError &py-builtin-TabError)
    (set! py-builtin-TimeoutError &py-builtin-TimeoutError)
    (set! py-builtin-TypeError &py-builtin-TypeError)
    (set! py-builtin-UnboundLocalError &py-builtin-UnboundLocalError)
    (set! py-builtin-UnicodeDecodeError &py-builtin-UnicodeDecodeError)
    (set! py-builtin-UnicodeEncodeError &py-builtin-UnicodeEncodeError)
    (set! py-builtin-UnicodeError &py-builtin-UnicodeError)
    (set! py-builtin-UnicodeTranslateError &py-builtin-UnicodeTranslateError)
    (set! py-builtin-UnicodeWarning &py-builtin-UnicodeWarning)
    (set! py-builtin-UserWarning &py-builtin-UserWarning)
    (set! py-builtin-ValueError &py-builtin-ValueError)
    (set! py-builtin-Warning &py-builtin-Warning)
    (set! py-builtin-ZeroDivisionError &py-builtin-ZeroDivisionError)
    (set! py-builtin-range &py-builtin-range)
    (set! py-builtin-range_iterator &py-builtin-range_iterator)
    (set! py-builtin-int &py-builtin-int)
    (set! py-builtin-bool &py-builtin-bool)
    (set! py-builtin-float &py-builtin-float)
    (set! py-builtin-str &py-builtin-str)
    (set! py-builtin-classmethod &py-builtin-classmethod)
    (set! py-builtin-staticmethod &py-builtin-staticmethod)
    (set! py-method-class &py-builtin-method)

    ;; Reuse sorted procedure for list.sort
    (set! list.sort
      (procedure->py-function
        (lambda (self key reversed)
          (PyObjectList-vector-set!
            self
            (PyObjectList-vector
              ((PyObjectFunction-procedure py-builtin-sorted)
               self key reversed)))
          py-None)

        ;;TODO: change default arguments to kwonlyargs
        (make-signature
          args: (self key reversed)
          defaults: (vector py-None py-False))))
    (py-cls-own-attr-set! py-list-class (& "sort") list.sort)

    ;; make constants
    (PyObject-class-set! py-True py-builtin-bool)
    (PyObject-class-set! py-False py-builtin-bool)

    ;; expand builtins.py with scheme-defined builtins
    (global-own-attr-put-no-cache! builtins-mod (& "None") py-None)
    (global-own-attr-put-no-cache! builtins-mod (& "NotImplemented") py-NotImplemented)
    (global-own-attr-put-no-cache! builtins-mod (& "False") py-False)
    (global-own-attr-put-no-cache! builtins-mod (& "True") py-True)
    (global-own-attr-put-no-cache! builtins-mod (& "abs") py-builtin-abs)
    (global-own-attr-put-no-cache! builtins-mod (& "all") py-builtin-all)
    (global-own-attr-put-no-cache! builtins-mod (& "any") py-builtin-any)
    (global-own-attr-put-no-cache! builtins-mod (& "ascii") py-builtin-ascii)
    (global-own-attr-put-no-cache! builtins-mod (& "bin") py-builtin-bin)
    (global-own-attr-put-no-cache! builtins-mod (& "breakpoint") py-builtin-breakpoint)
    (global-own-attr-put-no-cache! builtins-mod (& "bytearray") py-builtin-bytearray)
    (global-own-attr-put-no-cache! builtins-mod (& "bytes") py-builtin-bytes)
    (global-own-attr-put-no-cache! builtins-mod (& "callable") py-builtin-callable)
    (global-own-attr-put-no-cache! builtins-mod (& "chr") py-builtin-chr)
    (global-own-attr-put-no-cache! builtins-mod (& "compile") py-builtin-compile)
    (global-own-attr-put-no-cache! builtins-mod (& "complex") py-builtin-complex)
    (global-own-attr-put-no-cache! builtins-mod (& "delattr") py-builtin-delattr)
    (global-own-attr-put-no-cache! builtins-mod (& "dict") py-builtin-dict)
    (global-own-attr-put-no-cache! builtins-mod (& "dir") py-builtin-dir)
    (global-own-attr-put-no-cache! builtins-mod (& "divmod") py-builtin-divmod)
    (global-own-attr-put-no-cache! builtins-mod (& "enumerate") py-builtin-enumerate)
    (global-own-attr-put-no-cache! builtins-mod (& "eval") py-builtin-eval)
    (global-own-attr-put-no-cache! builtins-mod (& "exec") py-builtin-exec)
    (global-own-attr-put-no-cache! builtins-mod (& "filter") py-builtin-filter)
    (global-own-attr-put-no-cache! builtins-mod (& "float") py-builtin-float)
    (global-own-attr-put-no-cache! builtins-mod (& "format") py-builtin-format)
