;*---------------------------------------------------------------------*/
;*    Gambit compatibility                                             */
;*---------------------------------------------------------------------*/

(import (gambit prim))

(define-macro (with-handler handler . body)
  `(with-exception-catcher
      ,handler
      (lambda ()
        ,@body)))

(define-macro (bind-exit exit . body)
`(call/cc
    (lambda ,exit
      ,@body)))

(define-macro (make-cell e)
  `(box ,e))

(define-macro (cell-ref c)
  `(unbox ,c))

(define-macro (cell-set! c e)
  `(set-box! ,c ,e))

(namespace ("##" parse-module-ref load-module module-var-ref))

(define-macro (module-search-order-add! path)
  `(##module-search-order-add! ,path))

(define-macro (module-search-order)
  '##module-search-order)

(define-macro (make-still-copy s)
  `(##still-obj-refcount-inc!
    (##still-copy ,s)))

(define-macro (u8= x y)
  `(fx= ,x ,y))

(define-macro (u8> x y)
  `(fx> ,x ,y))

(define-macro (u8< x y)
  `(fx< ,x ,y))

(define-macro (u8>= x y)
  `(fx>= ,x ,y))

(define-macro (u8=< x y)
  `(fx=< ,x ,y))

(define-macro (structure-ref s i)
  `(##unchecked-structure-ref ,s ,i #f #f))

(define-macro (structure-type-set! s t)
  `(##structure-type-set! ,s ,t))

(define (init-constants constants)
  (vector-for-each
    (lambda (obj)
      (structure-type-set! obj (PyObjectStr-type-get))
      (PyObject-hclass-set! obj py-str-hclass-of-instances)
      (PyObject-class-set! obj py-str-class))
      (structure-ref constants 2)))

;; debugging utility
(define (why-am-i-here?)
  (##continuation-capture (lambda (cc) (display-continuation-backtrace cc))))

(define (debug-get-list obj nums)
  (let loop ((obj obj) (nums nums))
   (if (pair? nums)
       (loop (##vector-ref obj (car nums)) (cdr nums))
       obj)))

(define (debug-get obj . nums)
  (debug-get-list obj nums))

(define (debug-ref obj . nums)
  (debug-get-list obj (fold-right (lambda (x y) (cons 2 (cons x y))) '() nums)))

(define (debug-value-get obj)
  (debug-get obj 2 1))

(define (debug-class-name-get obj)
  (debug-get obj 2 0 2 4 2 1))

(define (debug-catch thunk)
  (with-exception-catcher
    (lambda (e) (if (PyObject? e) (print-exception e) (raise e)))
    thunk))

(define (read-string port)
   (list->string (read-all port read-char)))


;; statprof

(define (statprof-begin)
  (if (##subprocedure-info py-call)
    (eval
      '(let ()
        (import (github.com/gambit/statprof))
        (profile-start!)))
    (py-throw-exception-with-message
      py-builtin-RuntimeError
      "attempting to profile without debug location. Recompile Zipi with 'gsc -debug -debug-location'"))
  py-None)

(define (statprof-end file)
  (if (py-isinstance? file py-str-class)
    (let* ((file-string (py-str-to-scheme file))
           (profile-dir (path-expand (string-append file-string ".profile"))))
      (eval
        `(let ()
          (import (github.com/gambit/statprof))
          (profile-stop!)
          (write-profile-report ,profile-dir)))
      py-None)
    (py-throw-exception-with-message
      py-builtin-TypeError
      "statprof.stop requires str as attribute")))

(define (load-module-and-get-init name)
  (let* ((sym (string->symbol name))
         (modref (parse-module-ref sym)))
    (if modref
        (with-exception-catcher
          (lambda (exn)
            (if (module-not-found-exception? exn)
                #f
                (raise exn)))
          (lambda ()
            (load-module sym)
            (let ((init (module-var-ref modref 'init)))
             (if (procedure? init)
                 init
                 #f))))
        #f)))

(define (compile-source source target)

  (define (root-dir)
    (getenv "ZIPIROOT"))

  (define py19-path
    (string-append (root-dir) "/etc/py19" ))

  (if (not (file-exists? py19-path))
      (fatal-error
        "cannot find py19 executable. "
        "The environnement variable $ZIPIROOT is probably not set properly. "
        "Please refer to README"))

  (possible-error 1 "compiling file " source " to " target " \n")

  (shell-command
    (string-append
      (if debug-flag
          "ZIPI_DEBUG_PY19=true "
          "ZIPI_DEBUG_PY19=false ")
      py19-path
      " -t gambit "
      (root-dir)
      "/pyc "
      source
      " > "
      target)))
