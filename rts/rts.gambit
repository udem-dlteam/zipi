;*---------------------------------------------------------------------*/
;*    Gambit compatibility                                             */
;*---------------------------------------------------------------------*/

(define-macro (with-handler handler . body)
  `(with-exception-catcher
      ,handler
      (lambda ()
        ,@body)))

(define-macro (bind-exit exit . body)
`(call/cc
    (lambda ,exit
      ,@body)))

(define-macro (make-cell e)
  `(box ,e))

(define-macro (cell-ref c)
  `(unbox ,c))

(define-macro (cell-set! c e)
  `(set-box! ,c ,e))

(define-macro (structure-ref obj i)
  `(##unchecked-structure-ref ,obj , i #f #f))

(define-macro (structure-set! obj i val)
  `(##unchecked-structure-set! ,obj ,val ,i #f #f))

(define-macro (structure-type obj)
  `(##structure-type ,obj))

(define-macro (structure-type-set! obj tp)
  `(##structure-type-set! ,obj ,tp))

(define-macro (module-search-order-add! path)
  `(##module-search-order-add! ,path))

(define-macro (module-search-order)
  '##module-search-order)

(define-macro (make-still-copy s)
  `(##still-obj-refcount-inc!
    (##still-copy ,s)))

;; debugging utility
(define (why-am-i-here?)
  (##continuation-capture (lambda (cc) (display-continuation-backtrace cc))))

(define (debug-get-list obj nums)
  (let loop ((obj obj) (nums nums))
   (if (pair? nums)
       (loop (##vector-ref obj (car nums)) (cdr nums))
       obj)))

(define (debug-get obj . nums)
  (debug-get-list obj nums))

(define (debug-ref obj . nums)
  (debug-get-list obj (fold-right (lambda (x y) (cons 2 (cons x y))) '() nums)))

(define (debug-value-get obj)
  (debug-get obj 2 1))

(define (debug-class-name-get obj)
  (debug-get obj 2 0 2 4 2 1))

(define (debug-catch thunk)
  (with-exception-catcher
    (lambda (e) (if (PyObject? e) (print-exception e) (raise e)))
    thunk))

(define (object-repr self)
  (let* ((self-type (py-type self))
         (self-type-name (py-str-to-scheme (type-name-fast-get self-type)))
         (addr (integer->hex-string (##object->encoding self)))
         (result (string-append "<" self-type-name " object at " addr ">")))
    (py-str-from-scheme result)))

(define (read-string port)
   (list->string (read-all port read-char)))


;; == GAMBIT CACHE SYSTEM ==

;; WARNING : dont change this location without knowing what you do because (delete-zipi-cache) procedures recursively deletes this directory
(define (gambit-cache-location) (path-expand "~~zipicache/cache@zipi_0_0_1"))

(define (ensure-parent-dir-exists path)
  (define (wind path todo)
    (let* ((dir (path-strip-trailing-directory-separator
                  (path-directory path)))
           (fi (with-exception-catcher
                 (lambda (exc) #f)
                 (lambda () (file-info dir)))))
      (if fi
          (if (eq? (file-info-type fi) 'directory)
              (unwind todo)
              (error "directory component can't be created"))
          (wind dir (cons dir todo)))))

  (define (unwind todo)
    (if (pair? todo)
        (begin
          ;;(pretty-print (list 'creating= (car todo)))
          (create-directory (car todo))
          (unwind (cdr todo)))))

  (wind path '()))


(define (compile-source source target)
  (define (root-dir)
    (or (getenv "ZIPIROOT")
        (error "Environnement variable $ZIPIROOT is not set. Refer to the README" )))
  (print-debug 1 "WARNING : compiling file " source " to " target " \n")
  (shell-command
    (string-append
      (root-dir)
      "/etc/py19 -t gambit "
      (root-dir)
      "/pyc "
      source
      " > "
      target)))

(define compile-flag #f)
(define (set-compile-flag value)
  (set! compile-flag value))

(module-search-order-add! (gambit-cache-location))

(define (compile-to-cache path)
  (let* ((path-cache
           (string-append
             (gambit-cache-location)
             (path-strip-extension path)
             "/"
             (path-strip-extension (path-strip-directory path))
             ".sld"))
         (path-info (##file-info path #t #f))
         (path-cache-info (##file-info path-cache #t #f)))


    (define (create-_must-build_)
      (if compile-flag
          (let ((_must-build_-path
                  (string-append (path-strip-extension path-cache) "._must-build_")))
           (if compile-flag
               (with-output-to-file _must-build_-path list)
               (##delete-file _must-build_-path #f)))))

    ;; compile file and return #f if compilation failed
    (define (compile)
      (ensure-parent-dir-exists path-cache)
      (create-_must-build_)
      (fx= 0 (compile-source path path-cache)))

    (if path-info
        (if path-cache-info
            ;; check according to modified date
            (if (< (time->seconds (file-info-last-modification-time path-info))
                   (time->seconds (file-info-last-modification-time path-cache-info)))
                (begin
                  (print-debug 1 "WARNING : skipping compilation of unmodified file at " path ", compiled file found : " path-cache "\n")
                  (create-_must-build_)
                  #t) ;; compilation "succesfull" (file already compiled)
                (compile))
            (compile)) ;; compiled file does not exist (must compile)
        #f))) ;; file to compile does not exist (failed compilation)


(define (load-module-and-get-init name)
  (let* ((sym (string->symbol name))
         (modref (##parse-module-ref sym)))
    (if modref
        (with-exception-catcher
          (lambda (exn)
            (if (module-not-found-exception? exn)
                #f
                (raise exn)))
          (lambda ()
            (##load-module sym)
            (let ((init (##module-var-ref modref 'init)))
             (if (procedure? init)
                 init
                 #f))))
        #f)))

;; statprof

(define (statprof-start)
  (if (##subprocedure-info py-call)
    (eval
      (let ()
        (import (github.com/gambit/statprof))
        (profile-start!)))
    (py-throw-exception-with-message
      py-builtin-RuntimeError
      "attempting to profile without debug location. Recompile Zipi with 'gsc -debug -debug-location'"))
  py-None)

(define (statprof-stop file)
  (if (py-isinstance? file py-str-class)
    (let* ((file-string (py-str-to-scheme file))
           (profile-dir (path-expand (string-append file-string ".profile"))))
      (eval
        (let ()
          (import (github.com/gambit/statprof))
          (profile-stop!)
          (write-profile-report profile-dir)))
      py-None)
    (py-throw-exception-with-message
      py-builtin-TypeError
      "statprof.stop requires str as attribute")))
