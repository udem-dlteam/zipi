;*---------------------------------------------------------------------*/
;*    Library                                                          */
;*---------------------------------------------------------------------*/
(declare-library! 'zipi
		  :version "0.0.1"
		  :module-init '__py_bigloo
		  :module-eval '__py_make_lib)

;*---------------------------------------------------------------------*/
;*    gambit minimal compatibility kit                                 */
;*---------------------------------------------------------------------*/
(define-macro (fx+ x y) `(+fx ,x ,y))
(define-macro (fx- x y) `(-fx ,x ,y))
(define-macro (fx* x y) `(*fx ,x ,y))
(define-macro (fx/ x y) `(/fx ,x ,y))
(define-macro (fx= x y) `(=fx ,x ,y))
(define-macro (fx< x y) `(<fx ,x ,y))
(define-macro (fx> x y) `(>fx ,x ,y))
(define-macro (fx<= x y) `(<=fx ,x ,y))
(define-macro (fx>= x y) `(>=fx ,x ,y))
(define-macro (fxwrap* x y) `(*fx ,x ,y))
(define-macro (fxand x y) `(bit-and ,x ,y))
(define-macro (fxxor x y) `(bit-xor ,x ,y))
(define-macro (fxarithmetic-shift-left x y) `(bit-lsh ,x ,y))
(define-macro (fxarithmetic-shift-right x y) `(bit-rsh ,x ,y))

;*---------------------------------------------------------------------*/
;*    Link option                                                      */
;*---------------------------------------------------------------------*/
(cond-expand
   (bigloo-compile
    (set! *additional-bigloo-libraries* *additional-bigloo-libraries*))
   (bigloo-eval
    #unspecified))


