#*    Copyright   :  2019 Marc Feeley & Manuel Serrano                 */
#*    -------------------------------------------------------------    */
#*    The makefile to build the ZIPI rts library                       */
#*=====================================================================*/
.phony: do.bigloo build.bigloo

do.bigloo: build.bigloo
install.bigloo: install-library

#*---------------------------------------------------------------------*/
#*    Common Makefile                                                  */
#*---------------------------------------------------------------------*/
include $(BUILDETCDIR)/Makefile.bigloo
include $(BIGLOOLIBDIR)/Makefile.config

#*---------------------------------------------------------------------*/
#*    SOURCES                                                          */
#*---------------------------------------------------------------------*/
SOURCES = $(OBJECTS_COMMON:%=%.bgl)

#*---------------------------------------------------------------------*/
#*    Compilers, Tools and Destinations                                */
#*---------------------------------------------------------------------*/
# the library name
TARGETNAME = zipi
ZIPICLOSELIBS_S = -lpyc_s-$(ZIPIRELEASE) $(BGLCLOSELIBS_S)
ZIPICLOSELIBS_U = -lpyc_u-$(ZIPIRELEASE) $(BGLCLOSELIBS_U)
ZIPICLOSELIBS_ES = -lzipi_s-$(ZIPIRELEASE)
ZIPICLOSELIBS_EU = -lzipi_u-$(ZIPIRELEASE)

BLIBFLAGS = $(BCFLAGSRTS)

#*---------------------------------------------------------------------*/
#*    Scheme extended objects                                          */
#*---------------------------------------------------------------------*/
OBJECTS = $(OBJECTS_COMMON:%=o/%.o)
EOBJECTS = o/make_lib.o

INCLUDES = 

#*---------------------------------------------------------------------*/
#*    Sources                                                          */
#*---------------------------------------------------------------------*/
include $(BUILDETCDIR)/Makefile.library

#*---------------------------------------------------------------------*/
#*    all                                                              */
#*---------------------------------------------------------------------*/
.PHONY: build.bigloo

build.bigloo: object.sch hclass.sch iterator.sch
	$(MAKE) o heap-c lib-c

#*---------------------------------------------------------------------*/
#*    ude                                                              */
#*---------------------------------------------------------------------*/
.PHONY: ude
ude:
	$(MAKE) .afile .etags
	$(MAKE) dep

.afile: $(SOURCES)
	$(AFILE) -o .afile $(SOURCES)

.etags: $(SOURCES) $(INCLUDES)
	$(BTAGS) -o .etags $(SOURCES) $(INCLUDES)

#*---------------------------------------------------------------------*/
#*    clean                                                            */
#*---------------------------------------------------------------------*/
.PHONY: clean.bigloo

clean.bigloo:
	rm -f .afile
	rm -rf o

#*---------------------------------------------------------------------*/
#*    Explicit dependencies                                            */
#*---------------------------------------------------------------------*/

#bdepend start (don't edit)
#*---------------------------------------------------------------------*/
#*    Dependencies ...                                                 */
#*---------------------------------------------------------------------*/


#bdepend stop
