#!/bin/bash
#*=====================================================================*/
#*    serrano/prgm/project/zipi/zipi/configure                         */
#*    -------------------------------------------------------------    */
#*    Author      :  Marc Feeley & Manuel Serrano                      */
#*    Creation    :  Sat Jul 31 06:49:37 2004                          */
#*    Last change :  Tue Aug 17 12:12:46 2021 (serrano)                */
#*    Copyright   :  2019-21 Marc Feeley & Manuel Serrano              */
#*    -------------------------------------------------------------    */
#*    Zipi autoconfiguration                                           */
#*=====================================================================*/

#*---------------------------------------------------------------------*/
#*    User flags                                                       */
#*---------------------------------------------------------------------*/
systems="bigloo gambit"
default_scheme_system="no_default_scheme_system_currently_set"

#*---------------------------------------------------------------------*/
#*    Bigloo configuration                                             */
#*---------------------------------------------------------------------*/
# The Scheme compilers and the CPython interpreter can be given with the
# GSI, GSC, BIGLOO and PYTHON environment variables, or as VAR=value
# arguments (e.g., ./configure GSI=gsi GSC=gsc BIGLOO=bigloo). Otherwise,
# the versions pinned in the Makefile are used (see "make compilers").
bigloo=$BIGLOO
if [ "$ZIPIBIGLOO " != " " ]; then
  bigloo=$ZIPIBIGLOO
fi
gsi=$GSI
gsc=$GSC
python=$PYTHON

#*---------------------------------------------------------------------*/
#*    Private variables                                                */
#*---------------------------------------------------------------------*/
version="0.0.1"
pythonversion="python3.9"

prefix="/usr/local"

builddir=$PWD
buildlibdir=$PWD/lib/zipi/$version
buildbindir=$PWD/bin
buildetcdir=$PWD/etc
buildrtsdir=$PWD/rts
buildpycdir=$PWD/pyc
buildzpcdir=$PWD/zpc
buildstdlibdir=$PWD/stdlib
depdirname=dependencies
builddepdir=$PWD/$depdirname
buildbuilddepdir=$PWD/build-$depdirname

install="install -m a+rx,u+rx"

shell=/bin/sh

skipdependencies=false
mode=optim

zipicache=~/.zipicache
depdir=$zipiroot/dependencies

branch=`git describe --tag --always`
date=`date +"%d %B %Y"`

if [ -e .git ]; then
  buildtag=`git log -1 --abbrev-commit --pretty="%h"`

  git status -s | grep M > /dev/null
  
  if [ "$? " = "0 " ]; then
    buildtag="$buildtag+"
  fi
else
  if [ -f .buildtag ]; then
    buildtag=`cat .buildtag`
  else
    buildtag=0
  fi
fi  

#*---------------------------------------------------------------------*/
#*    parseArg ...                                                     */
#*---------------------------------------------------------------------*/
function parseArg() {
  case $1 in
    --prefix=*)
      prefix="`echo $1 | sed 's/^[^=]*=//'`";;

    --bigloo-only)
      systems=bigloo
      default_scheme_system=bigloo;;

    --gambit-only)
      systems=gambit
      default_scheme_system=gambit;;

    --default=*)
      default_scheme_system="`echo $1 | sed 's/^[^=]*=//'`";;

    --gambitroot=*)
      gambitroot="`echo $1 | sed 's/^[^=]*=//'`";;

    --bigloo=*)
      bigloo="`echo $1 | sed 's/^[^=]*=//'`";;

    --bigloolibdir=*)
      bigloolibdir="`echo $1 | sed 's/^[^=]*=//'`";;

    --bigloobindir=*)
      bigloobindir="`echo $1 | sed 's/^[^=]*=//'`";;

    --python=*|PYTHON=*)
      python="`echo $1 | sed 's/^[^=]*=//'`";;

    GSI=*)
      gsi="`echo $1 | sed 's/^[^=]*=//'`";;

    GSC=*)
      gsc="`echo $1 | sed 's/^[^=]*=//'`";;

    BIGLOO=*)
      bigloo="`echo $1 | sed 's/^[^=]*=//'`";;

    --install=*)
      install="`echo $1 | sed 's/^[^=]*=//'`";;

    --skip-dependencies*)
      skipdependencies=true;;

    --mode=*)
      mode="`echo $1 | sed 's/^[^=]*=//'`";;

    --debug*)
      mode=debug;;

    --devel*)
      mode=devel;;

    --zipicache=*)
      zipicache="`echo $1 | sed 's/^[^=]*=//'`";;

    --dependencies-dir=*)
      depdir="`echo $1 | sed 's/^[^=]*=//'`"
      builddepdir=$depdir;;

    -*)
      if [ "$1" != "--help" ]; then
        echo "*** Configure error, unknown option $1" >&2;
        echo >&2;
      fi
      echo "Usage: configure [options]" >&2;
      echo "" >&2;
      echo "Path:" >&2;
      echo "   --prefix=dir................ prefix to Zipi install" >&2;
      echo "" >&2;
      echo "Compilers:" >&2;
      echo "   --bigloo-only............... only compile Bigloo backend" >&2;
      echo "   --gambit-only............... only compile Gambit backend" >&2;
      echo "   --gambitroot=path........... set build and host Gambit, requires path to gambit root folder (not recommended)" >&2;
      echo "   --bigloo=comp............... set both build and host Bigloo compilers ($bigloo/$hostbigloo)" >&2;
      echo "   --python=comp............... set build build and host cPython interpreter (not recommended)" >&2;
      echo "   GSI=gsi GSC=gsc............. use these Gambit interpreter/compiler (default: make compilers)" >&2;
      echo "   BIGLOO=bigloo............... use this Bigloo compiler (default: make compilers)" >&2;
      echo "   PYTHON=python3.9............ use this cPython 3.9 interpreter (default: make compilers)" >&2;
      echo "" >&2;
      echo "bigloo:" >&2;
      echo "   --bigloobindir=path......... the Bigloo bin-dir path" >&2;
      echo "   --bigloolibdir=path......... the Bigloo lib-dir path" >&2;
      echo "" >&2;
      echo "Misc:" >&2;
      echo "   --install................... the installer ($install)" >&2;
      echo "   --skip-dependencies......... do not run \"make compilers\" for missing dependencies" >&2;
      echo "   --dependencies-dir=path..... location of the dependency directory (default ./dependencies)" >&2;
      echo "   --mode=[prod|debug]......... the configuration mode ($mode)" >&2;
      echo "   --debug..................... debug mode (aka --mode=debug)" >&2;
      echo "   --zipicache=path............ location of compiled .py files ($zipicache)" >&2;
      echo "" >&2;
      echo "ZIPICONFIGUREOPTS=opt1 opt2..." >&2;
      exit 255;
  esac
}

configureargs="$*"
echo "configuring with [$*]..." > config.status
echo "ZIPICONFIGUREOPTS=$ZIPICONFIGUREOPTS" >> config.status

# Argument parsing
while : ; do
  case $1 in
    "")
      break;;
    *)
      parseArg $1;;
  esac
  shift
done

for p in $ZIPICONFIGUREOPTS; do
  parseArg $p
done

versiondash=`echo $version | sed 's/[.]/-/g'`
prefix=${prefix%/}
installbindir=$prefix/bin
zipiroot=$prefix/lib/zipi-$versiondash/zipi # TODO: when gambit can accept . in path, use: $prefix/lib/zipi-${version}/zipi
etcdir=$zipiroot/etc
rtsdir=$zipiroot/rts
bindir=$zipiroot/bin
libdir=$zipiroot/lib
pycdir=$zipiroot/pyc
zpcdir=$zipiroot/zpc
stdlibdir=$zipiroot/stdlib
depdir=$zipiroot/$depdirname

#*---------------------------------------------------------------------*/
#*    Dependencies (Gambit, Bigloo, cPython)                           */
#*    -------------------------------------------------------------    */
#*    Unless given explicitly (GSI, GSC, BIGLOO, PYTHON), the tools    */
#*    are the versions pinned in the Makefile and built by             */
#*    "make compilers" in the dependencies directory.                  */
#*---------------------------------------------------------------------*/
make=${MAKE:-make}

eval `$make -s --no-print-directory compilers-paths DEPSDIR=$builddepdir` || exit 1

# resolve_tool name -> absolute path of the executable "name"
function resolve_tool() {
  local path
  path=`command -v "$1" 2> /dev/null`
  if [ "$path " = " " ] || [ ! -x "$path" ]; then
    return 1
  fi
  echo "`cd \`dirname $path\` && pwd -P`/`basename $path`"
}

# install_dependency target -> run "make target" unless --skip-dependencies
function install_dependency() {
  if [ "$skipdependencies" = false ]; then
    echo "***   Building $1 in $builddepdir (make $1)"
    $make --no-print-directory $1 DEPSDIR=$builddepdir || exit 1
  else
    echo "***   WARNING: $1 is missing and --skip-dependencies was given" >&2
  fi
}

#*---------------------------------------------------------------------*/
#*    cPython                                                          */
#*---------------------------------------------------------------------*/
echo "*** Configuring Python"

if [ "$python " = " " ]; then
  python=$deps_python_prefix/bin/python3
  if [ ! -f $deps_python_prefix/.built ]; then
    install_dependency python
  else
    echo "***   Using cPython $deps_python_version from $deps_python_prefix"
  fi
else
  python=`resolve_tool $python` || {
    echo "***   ERROR: cannot find the Python interpreter '$python'" >&2; exit 1; }
  echo "***   Using cPython at '$python'"
fi

if [ "`$python -c 'import sys; print(sys.version_info[:2] == (3,9))'`" != "True" ]; then
  echo "***   ERROR: Zipi requires cPython 3.9 ('$python' is version `$python -c 'import sys; print(sys.version.split()[0])'`)" >&2
  echo "***   Use \"make python\" to build the pinned version or PYTHON=... to select another one" >&2
  exit 1
fi

# The same interpreter is used for building and running Zipi
buildpython=$python

#*---------------------------------------------------------------------*/
#*    Create directories                                               */
#*---------------------------------------------------------------------*/
mkdir -p bin
mkdir -p lib
mkdir -p lib/zipi
mkdir -p lib/zipi/$version

#*---------------------------------------------------------------------*/
#*    We are now able to set the correct value for cc since we know    */
#*    what Bigloo is.                                                  */
#*---------------------------------------------------------------------*/
if test "${systems#*bigloo}" != "$systems"; then
  . ./etc/configure.bigloo $mode
  buildschemescript=$bigloo
fi

if test "${systems#*gambit}" != "$systems"; then
  . ./etc/configure.gambit
  buildschemescript=$buildgambit
fi

if [ "$default_scheme_system " = "no_default_scheme_system_currently_set " ]; then
  # Gambit is the default backend (use --default=bigloo to change it)
  if test "${systems#*gambit}" != "$systems"; then
    default_scheme_system=gambit
  else
    default_scheme_system=bigloo
  fi
  echo "*** Default backend: $default_scheme_system (use --default=[gambit|bigloo] to change it)"
fi

#*---------------------------------------------------------------------*/
#*    buildid & buildtag ...                                           */
#*---------------------------------------------------------------------*/
buildid=
buildtag=

if [ -e .git ]; then
  buildtag=`git log -1 --abbrev-commit --pretty="%h"`

  git status -s | grep M > /dev/null

  if [ "$? " = "0 " ]; then
    buildtag="$buildtag+"
  fi
else
  if [ -f .buildtag ]; then
    buildtag=`cat .buildtag`
  fi
fi

buildid_files="zpc/*.scm rts/*.scm"

# md5sum
echo "1" | md5sum > /dev/null 2> /dev/null

if [ "$? " = "0 " ]; then
  buildid=`md5sum $buildid_files | md5sum | sed 's/[ ]*[-]$//'`
fi

if [ "$buildid " = " " ]; then
  # md5
  echo "1" | md5 -q > /dev/null 2> /dev/null

  if [ "$? " = "0 " ]; then
    buildid=`md5 $buildid_files | md5 -q | sed 's/[ ]*[-]$//'`
  fi
fi

#*---------------------------------------------------------------------*/
#*    Makefile.zipiconfig                                              */
#*---------------------------------------------------------------------*/
for file in Makefile.zipiconfig  configure.scm zpc.bigloo.sh; do
  mkmf=etc/$file

  rm -f $mkmf 2> /dev/null

  if [ $file = "Makefile.zipiconfig" ]; then
    echo "#* Automatically generated file (don't edit) */" > $mkmf
  fi

  cat $mkmf.in \
    | sed -e "s|@RELEASE@|$version|" \
          -e "s|@CONFIGUREARGS@|$configureargs|" \
          -e "s|@DEFAULT_SCHEME_SYSTEM@|$default_scheme_system|" \
          -e "s|@DATE@|$date|" \
          -e "s|@BRANCH@|$branch|" \
          -e "s|@VERSION@|$version|" \
          -e "s|@PYTHONVERSION@|$pythonversion|" \
          -e "s|@ZIPISRFIS@|$zipisrfis|" \
          -e "s|@SYSTEMS@|$systems|" \
          -e "s|@BINDIR@|$bindir|" \
          -e "s|@LIBDIR@|$libdir|" \
          -e "s|@PREFIX@|$prefix|" \
          -e "s|@INSTALLBINDIR@|$installbindir|" \
          -e "s|@ZIPIROOT@|$zipiroot|" \
          -e "s|@ETCDIR@|$etcdir|" \
          -e "s|@RTSDIR@|$rtsdir|" \
          -e "s|@PYCDIR@|$pycdir|" \
          -e "s|@ZPCDIR@|$zpcdir|" \
          -e "s|@STDLIBDIR@|$stdlibdir|" \
          -e "s|@DEPDIRNAME@|$depdirname|" \
          -e "s|@DEPDIR@|$depdir|" \
          -e "s|@BUILDID@|$buildid|" \
          -e "s|@BUILDTAG@|$buildtag|" \
          -e "s|@BUILDDIR@|$builddir|" \
          -e "s|@BUILDETCDIR@|$buildetcdir|" \
          -e "s|@BUILDRTSDIR@|$buildrtsdir|" \
          -e "s|@BUILDLIBDIR@|$buildlibdir|" \
          -e "s|@BUILDBINDIR@|$buildbindir|" \
          -e "s|@BUILDPYCDIR@|$buildpycdir|" \
          -e "s|@BUILDSTDLIBDIR@|$buildstdlibdir|" \
          -e "s|@BUILDZPCDIR@|$buildzpcdir|" \
          -e "s|@BUILDDEPDIR@|$builddepdir|" \
          -e "s|@BUILDBUILDEPDIR@|$buildbuilddepdir|" \
          -e "s|@BIGLOO@|$bigloo|" \
          -e "s|@BUILDGAMBIT@|$buildgambit|" \
          -e "s|@BUILDGAMBITROOT@|$buildgambitroot|" \
          -e "s|@BUILDGAMBITCOMPILER@|$buildgambitcompiler|" \
          -e "s|@GAMBIT@|$gambit|" \
          -e "s|@GAMBITROOT@|$gambitroot|" \
          -e "s|@GAMBITCOMPILER@|$gambitcompiler|" \
          -e "s|@BUILDSCHEMESCRIPT@|$builtschemescript|" \
          -e "s|@INSTALL@|$install|" \
          -e "s|@LINK@|$link|" \
          -e "s|@SHELL@|$shell|" \
          -e "s|@BUILDPYTHON@|$buildpython|" \
          -e "s|@PYTHON@|$python|" \
          -e "s|@PYSEXPPP@|$pysexppp|" \
          -e "s|@ZIPICACHE@|$zipicache|" \
  	>> $mkmf
done

for file in configure.scm; do
  cat etc/$file \
    | sed -e "s|#[*] Automatically|;* Automatically|" \
          -e "s|@VERSION@|$version|" \
          -e "s|@ZIPISRFIS@|$zipisrfis|" \
    > zpc/configure.scm

  cp zpc/configure.scm pyc
  cp zpc/configure.scm rts

  rm etc/$file
done


for file in bin/zipi bin/zipi.gambit bin/zipi.bigloo bin/zipi-compile-and-run.gambit bin/zipi.bigloo bin/zpc bin/zpc.gambit bin/pysexp_script.py zpc/main-gambit.scm; do
  cat $file.in \
    | sed -e "s|@RELEASE@|$version|g" \
          -e "s|@DEFAULT_SCHEME_SYSTEM@|$default_scheme_system|g" \
          -e "s|@DATE@|$date|g" \
          -e "s|@BRANCH@|$branch|g" \
          -e "s|@VERSION@|$version|g" \
          -e "s|@PYTHONVERSION@|$pythonversion|g" \
          -e "s|@SYSTEMS@|$systems|g" \
          -e "s|@ZIPIBIN@|$buildbindir|g" \
          -e "s|@ZIPIETC@|$buildetcdir|g" \
          -e "s|@ZIPIRTS@|$buildrtsdir|g" \
          -e "s|@BIGLOO@|$bigloo|g" \
          -e "s|@GAMBIT@|$buildgambit|g" \
          -e "s|@GAMBITCOMPILER@|$buildgambitcompiler|g" \
          -e "s|@GAMBITROOT@|$buildgambitroot|g" \
          -e "s|@PYTHON@|$buildpython|g" \
          -e "s|@ZIPICACHE@|$zipicache|g" \
          -e "s|@ZIPIROOT@|$builddir|g" \
          -e "s|@BIGLOOLIBPATH@|$zipiroot|g"\
          -e "s|@BUILDTAG@|$buildtag|g"\
    > $file
  chmod +x $file
done

mv etc/zpc.bigloo.sh bin && chmod a+rx bin/zpc.bigloo.sh

rm -rf $buildbindir/pysexp
cp -r $buildetcdir/pysexp $buildbindir/pysexp

