#!/bin/sh
#*=====================================================================*/
#*    serrano/prgm/project/zipi/configure                              */
#*    -------------------------------------------------------------    */
#*    Author      :  Marc Feeley & Manuel Serrano                      */
#*    Creation    :  Sat Jul 31 06:49:37 2004                          */
#*    Last change :  Mon May 25 14:04:55 2020 (serrano)                */
#*    Copyright   :  2019-21 Marc Feeley & Manuel Serrano              */
#*    -------------------------------------------------------------    */
#*    HOP autoconfiguration                                            */
#*=====================================================================*/

#*---------------------------------------------------------------------*/
#*    User flags                                                       */
#*---------------------------------------------------------------------*/
systems="bigloo gambit"
default_scheme_system="no_default_scheme_system_currently_set"

#*---------------------------------------------------------------------*/
#*    Bigloo configuration                                             */
#*---------------------------------------------------------------------*/
bigloo=bigloo
if [ "$HOPBIGLOO " != " " ]; then
  bigloo=$HOPBIGLOO
fi

#*---------------------------------------------------------------------*/
#*    Gambit configuration                                             */
#*---------------------------------------------------------------------*/
gambit=gsi
gambitcompiler=gsc

#*---------------------------------------------------------------------*/
#*    Private variables                                                */
#*---------------------------------------------------------------------*/
version="0.0.1"
pythonversion="python3.9"

prefix="/usr/local"

builddir=$PWD
buildlibdir=$PWD/lib/zipi/$version
buildbindir=$PWD/bin
buildetcdir=$PWD/etc
buildrtsdir=$PWD/rts
buildpycdir=$PWD/pyc
buildzpcdir=$PWD/zpc

install="install -m a+r,u+r"

shell=/bin/sh

mode=optim

buildpython=
zipicache=~/.zipicache

branch=`git rev-parse --abbrev-ref HEAD`
date=`date +"%d %B %Y"`

# Argument parsing
while : ; do
  case $1 in
    "")
      break;;

    --prefix=*)
      prefix="`echo $1 | sed 's/^[^=]*=//'`";;

    --bigloo-only)
      systems=bigloo
      default_scheme_system=bigloo
      ;;

    --gambit-only)
      systems=gambit
      default_scheme_system=gambit
      ;;

    --default=*)
      default_scheme_system="`echo $1 | sed 's/^[^=]*=//'`";;

    --gambit=*)
      gambit="`echo $1 | sed 's/^[^=]*=//'`";
      ;;

    --gambitcompiler=*)
      gambitcompiler="`echo $1 | sed 's/^[^=]*=//'`";
      ;;

    --bigloo=*)
      bigloo="`echo $1 | sed 's/^[^=]*=//'`";
      ;;

    --bigloolibdir=*)
      bigloolibdir="`echo $1 | sed 's/^[^=]*=//'`";;

    --bigloobindir=*)
      bigloobindir="`echo $1 | sed 's/^[^=]*=//'`";;

    --install=*)
      install="`echo $1 | sed 's/^[^=]*=//'`";;

    --mode=*)
      mode="`echo $1 | sed 's/^[^=]*=//'`";;

    --debug*)
      mode=debug;;

    --buildpython=*)
      buildpython="`echo $1 | sed 's/^[^=]*=//'`";;

    --zipicache=*)
      zipicache="`echo $1 | sed 's/^[^=]*=//'`";;

    -*)
      if [ "$1" != "--help" ]; then
        echo "*** Configure error, unknown option $1" >&2;
        echo >&2;
      fi
      echo "Usage: configure [options]" >&2;
      echo "" >&2;
      echo "Path:" >&2;
      echo "   --prefix=dir................ prefix to Zipi install" >&2;
      echo "" >&2;
      echo "Compilers:" >&2;
      echo "   --bigloo-only............... only compile Bigloo backend" >&2;
      echo "   --gambit-only............... only compile Gambit backend" >&2;
      echo "   --gambit=comp............... set both build and host Gambit interpreter ($gambit)" >&2;
      echo "   --gambitcompiler=comp....... set both build and host Gambit compiler ($gambitcompiler)" >&2;
      echo "   --bigloo=comp............... set both build and host Bigloo compilers ($bigloo/$hostbigloo)" >&2;
      echo "" >&2;
      echo "bigloo:" >&2;
      echo "   --bigloobindir=path......... the Bigloo bin-dir path" >&2;
      echo "   --bigloolibdir=path......... the Bigloo lib-dir path" >&2;
      echo "" >&2;
      echo "Misc:" >&2;
      echo "   --install................... the installer ($install)" >&2;
      echo "   --mode=[prod|debug]......... the configuration mode ($mode)" >&2;
      echo "   --debug..................... debug mode (aka --mode=debug)" >&2;
      echo "   --buildpython=python........ python executable used for build ($buildpython)" >&2;
      echo "   --zipicache=path............ location of compiled .py files ($zipicache)" >&2;
      exit 255;
  esac
  shift
done

prefix=${prefix%/}
zipiroot=$prefix/lib/zipi-${version}/zipi
etcdir=$zipiroot/etc
rtsdir=$zipiroot/rts
bindir=$zipiroot/bin
libdir=$zipiroot/lib
pycdir=$zipiroot/pyc
zpcdir=$zipiroot/zpc
venvpython=$bindir/venv/bin/python3
buildvenvpython=$builddir/venv/bin/python3

#*---------------------------------------------------------------------*/
#*    Detect python version of none provided                           */
#*---------------------------------------------------------------------*/

if [ -z $buildpython ];
then
  for py in python3.9 python3.8 python3 python
  do
    if command -v $py > /dev/null;
    then
      thispyversion=$($py -c "import sys; print('.'.join(map(str, sys.version_info[:2])))")
      if [ "$thispyversion" = "3.8" ] || [ "$thispyversion" = "3.9" ];
      then
        buildpython=$py;
        echo "cpython executable detected: $py (python$thispyversion)";
        break;
      fi;
    fi;
  done;

  if [ -z $buildpython ];
  then
    echo "Not found: Zipi requires cpython 3.8 or 3.9 to be installed.";
    echo "You can provide the cpython exectuable with --buildpython=";
    exit 1;
  fi
fi


#*---------------------------------------------------------------------*/
#*    Create directories                                               */
#*---------------------------------------------------------------------*/
mkdir -p bin
mkdir -p lib
mkdir -p lib/zipi
mkdir -p lib/zipi/$version

#*---------------------------------------------------------------------*/
#*    We are now able to set the correct value for cc since we know    */
#*    what Bigloo is.                                                  */
#*---------------------------------------------------------------------*/
if [ "$systems " != "gambit " ]; then
  . ./etc/configure.bigloo $mode
fi

if [ "$systems " != "bigloo " ]; then
  . ./etc/configure.gambit
fi

if [ "$default_scheme_system " = "no_default_scheme_system_currently_set " ]; then
  echo "WARNING: no default scheme system has been set..." 1>&2;
  echo "         use --default=[gambit|bigloo] or --bigloo-only or --gambit-only" 1>&2;
fi

#*---------------------------------------------------------------------*/
#*    buildid & buildtag ...                                           */
#*---------------------------------------------------------------------*/
buildid=
buildtag=

if [ -e .git ]; then
  buildtag=`git log -1 --abbrev-commit --pretty="%h"`

  git status -s | grep M > /dev/null

  if [ "$? " = "0 " ]; then
    buildtag="$buildtag+"
  fi
else
  if [ -f .buildtag ]; then
    buildtag=`cat .buildtag`
  fi
fi

buildid_files="zpc/*.scm rts/*.scm"

# md5sum
echo "1" | md5sum > /dev/null 2> /dev/null

if [ "$? " = "0 " ]; then
  buildid=`md5sum $buildid_files | md5sum | sed 's/[ ]*[-]$//'`
fi

if [ "$buildid " = " " ]; then
  # md5
  echo "1" | md5 -q > /dev/null 2> /dev/null

  if [ "$? " = "0 " ]; then
    buildid=`md5 $buildid_files | md5 -q | sed 's/[ ]*[-]$//'`
  fi
fi

#*---------------------------------------------------------------------*/
#*    Makefile.zipiconfig                                              */
#*---------------------------------------------------------------------*/
for file in Makefile.zipiconfig configure.scm zpc.bigloo.sh; do
  mkmf=etc/$file

  rm -f $mkmf 2> /dev/null

  if [ $file = "Makefile.zipiconfig" ]; then
    echo "#* Automatically generated file (don't edit) */" > $mkmf
  fi

  cat $mkmf.in \
    | sed -e "s|@RELEASE@|$version|" \
          -e "s|@DEFAULT_SCHEME_SYSTEM@|$default_scheme_system|" \
          -e "s|@DATE@|$date|" \
          -e "s|@BRANCH@|$branch|" \
          -e "s|@VERSION@|$version|" \
          -e "s|@PYTHONVERSION@|$pythonversion|" \
          -e "s|@ZIPISRFIS@|$zipisrfis|" \
          -e "s|@SYSTEMS@|$systems|" \
          -e "s|@BINDIR@|$bindir|" \
          -e "s|@LIBDIR@|$libdir|" \
          -e "s|@PREFIX@|$prefix|" \
          -e "s|@ZIPIROOT@|$zipiroot|" \
          -e "s|@ETCDIR@|$etcdir|" \
          -e "s|@RTSDIR@|$rtsdir|" \
          -e "s|@PYCDIR@|$pycdir|" \
          -e "s|@ZPCDIR@|$zpcdir|" \
          -e "s|@BUILDID@|$buildid|" \
          -e "s|@BUILDTAG@|$buildtag|" \
          -e "s|@BUILDDIR@|$builddir|" \
          -e "s|@BUILDETCDIR@|$buildetcdir|" \
          -e "s|@BUILDRTSDIR@|$buildrtsdir|" \
          -e "s|@BUILDLIBDIR@|$buildlibdir|" \
          -e "s|@BUILDBINDIR@|$buildbindir|" \
          -e "s|@BUILDPYCDIR@|$buildpycdir|" \
          -e "s|@BUILDZPCDIR@|$buildzpcdir|" \
          -e "s|@BIGLOO@|$bigloo|" \
          -e "s|@GAMBIT@|$gambit|" \
          -e "s|@GAMBITCOMPILER@|$gambitcompiler|" \
          -e "s|@INSTALL@|$install|" \
          -e "s|@LINK@|$link|" \
          -e "s|@SHELL@|$shell|" \
          -e "s|@BUILDPYTHON@|$buildpython|" \
          -e "s|@VENVPYTHON@|$venvpython|" \
          -e "s|@BUILDVENVPYTHON@|$buildvenvpython|" \
          -e "s|@PYSEXPPP@|$pysexppp|" \
          -e "s|@ZIPICACHE@|$zipicache|" \
  	>> $mkmf
done

for file in configure.scm; do
  cat etc/$file \
    | sed -e "s|#[*] Automatically|;* Automatically|" \
          -e "s|@VERSION@|$version|" \
          -e "s|@ZIPISRFIS@|$zipisrfis|" \
    > zpc/configure.scm

  cp zpc/configure.scm pyc
  cp zpc/configure.scm rts

  rm etc/$file
done


for file in bin/zipi bin/zipi.gambit bin/zipi-compile-and-run.gambit bin/zipi.bigloo bin/zpc bin/zpc.gambit bin/pysexp_script.py; do
  cat $file.in \
    | sed -e "s|@RELEASE@|$version|g" \
          -e "s|@DEFAULT_SCHEME_SYSTEM@|$default_scheme_system|g" \
          -e "s|@DATE@|$date|g" \
          -e "s|@BRANCH@|$branch|g" \
          -e "s|@VERSION@|$version|g" \
          -e "s|@PYTHONVERSION@|$pythonversion|g" \
          -e "s|@SYSTEMS@|$systems|g" \
          -e "s|@ZIPIBIN@|$buildbindir|g" \
          -e "s|@ZIPIETC@|$buildetcdir|g" \
          -e "s|@ZIPIRTS@|$buildrtsdir|g" \
          -e "s|@BIGLOO@|$bigloo|g" \
          -e "s|@GAMBIT@|$gambit|g" \
          -e "s|@GAMBITCOMPILER@|$gambitcompiler|g" \
          -e "s|@PYTHON@|$buildpython|g" \
          -e "s|@ZIPICACHE@|$zipicache|g" \
          -e "s|@ZIPIROOT@|$builddir|g" \
    > $file
  chmod +x $file
done

mv etc/zpc.bigloo.sh bin && chmod a+rx bin/zpc.bigloo.sh
cp -a etc/pysexp bin/pysexp

#
# Check for virtualenv
#

install_virtualenv()
{
  if ${buildpython} -c "import pip"; then
    ${buildpython} -m pip install virtualenv;
  else
    echo "Could not install virtualenv: ${buildpython} does not have pip installed.";
    echo "Please install pip manually or use another python executable using --buildpython=";
  fi
}

if ! ${buildpython} -c "import virtualenv"; then
  echo "The cpython interpreter at ${buildpython} does not have virtualenv installed."
  while true; do
    read -p "Do you want to install virtualenv? [Y/N]" yn
    case $yn in
        [Yy]* ) install_virtualenv; break;;
        [Nn]* ) exit;;
        * ) echo "Answer Y or N.";;
    esac
  done
fi
