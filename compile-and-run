#!/bin/bash

echo "### Compile and run with Gambit ###"
./etc/py19 -t gambit $1 > .test.scm
gsi ./pyc/ .test.scm
rm .test.scm

echo ""
echo "### Compile and run with Bigloo ###"
zpc.bigloo $1 -o ~test.scm
bigloo -L /usr/local/lib/zipi/0.0.1 -rpath /usr/local/lib/zipi/0.0.1 ~test.scm
./a.out
rm ~test.scm
rm ~test.o
rm ./a.out
