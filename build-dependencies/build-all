#! /bin/bash

# File: "build-all"

# This script builds all the compilers required.

# Usage: ./build-all [C-compiler-to-use]
#
# The optional parameter can be used to avoid building the gcc
# compiler, which can be a very long process.  For example this will
# use the system's currently installed gcc compiler:
#
#  ./build-all gcc


GCC_VERSION=10.2.0
GCC_CONFIGURE_OPTIONS=""

CPYTHON_VERSION=3.9.0
CPYTHON_CONFIGURE_OPTIONS="--enable-optimizations"

GAMBIT_VERSION=4.9.3-1380
GAMBIT_CONFIGURE_OPTIONS="--enable-single-host"

BIGLOO_VERSION=4.4b
BIGLOO_CONFIGURE_OPTIONS=""

C_COMPILER="$1"


if test "$C_COMPILER" == "" ; then

  # build specific version of gcc

  GCC_DIR="`pwd`/gcc-$GCC_VERSION"
  GCC_PATH="$GCC_DIR/bin"
  export PATH="$GCC_PATH:$PATH"

  if ! test -e "$GCC_DIR" ; then
    time ./build-gcc gcc-$GCC_VERSION $GCC_CONFIGURE_OPTIONS
  fi

  C_COMPILER="$GCC_PATH/gcc"

fi

echo "***** version of C compiler:"
$C_COMPILER --version


CPYTHON_DIR="`pwd`/cpython-$CPYTHON_VERSION"
CPYTHON_PATH="$CPYTHON_DIR/bin"
export PATH="$CPYTHON_PATH:$PATH"

if ! test -e "$CPYTHON_DIR" ; then
  time ./build-cpython cpython-$CPYTHON_VERSION $CPYTHON_CONFIGURE_OPTIONS CC="$C_COMPILER"
fi

echo "***** version of cpython:"
python3 --version


GAMBIT_DIR="`pwd`/gambit-$GAMBIT_VERSION"
GAMBIT_PATH="$GAMBIT_DIR/bin"
export PATH="$GAMBIT_PATH:$PATH"

if ! test -e "$GAMBIT_DIR" ; then
  time ./build-gambit gambit-$GAMBIT_VERSION $GAMBIT_CONFIGURE_OPTIONS CC="$C_COMPILER"
fi

echo "***** version of gambit:"
gsc -v


BIGLOO_DIR="`pwd`/bigloo-$BIGLOO_VERSION"
BIGLOO_PATH="$BIGLOO_DIR/bin"
export PATH="$BIGLOO_PATH:$PATH"

if ! test -e "$BIGLOO_DIR" ; then
  time ./build-bigloo bigloo-$BIGLOO_VERSION $BIGLOO_CONFIGURE_OPTIONS CC="$C_COMPILER"
fi

echo "***** version of bigloo:"
bigloo -version


echo "PATH=$PATH"
