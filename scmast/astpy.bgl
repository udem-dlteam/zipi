;*---------------------------------------------------------------------*/
;*    The module                                                       */
;*---------------------------------------------------------------------*/
(module astpy
   
   (include "ast/ast.sch")
   
   (import __py_sexp
	   __py_symbol
	   __py_return
	   __py_beval
	   __py_hclass
	   __py_object)

   (main main))

;*---------------------------------------------------------------------*/
;*    main ...                                                         */
;*---------------------------------------------------------------------*/
(define (main argv)
   (let ((ast (if (null? (cdr argv))
		  (py-sexp (read) '())
		  (py-sexp (call-with-input-file (cadr argv) read) '())))
	 (conf '()))
      (py-symbol! ast conf)
      (py-return ast conf)
      (py-beval ast conf)))
       
