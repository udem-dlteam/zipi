;*    -------------------------------------------------------------    */
;*    Hidden classes for python ast interpreter                        */
;*=====================================================================*/

;*---------------------------------------------------------------------*/
;*    The module                                                       */
;*---------------------------------------------------------------------*/
(module evalpy_hclass
   
   (export (class PCache
	      (hclass (default (class-nil HClass)))
	      (index::long (default -1)))

	   (class HClass 
	      (names::vector (default '#()))
	      (transitions::pair-nil (default '()))))
   
   (export (inline make-pcache)
	   (inline pcache-hclass::HClass ::PCache)
	   (inline pcache-index::long ::PCache)
	   (inline pcache-set! ::PCache ::HClass ::long)
	   (inline make-hclass ::vector)
	   (inline hclass-names::vector ::HClass)
	   (inline hclass-transitions::pair-nil ::HClass)
	   (inline hclass-last-index::long ::HClass)
	   (hclass-next ::HClass ::obj ::obj)))

;*---------------------------------------------------------------------*/
;*    make-pcache ...                                                  */
;*---------------------------------------------------------------------*/
(define-inline (make-pcache)
   (instantiate::PCache))

;*---------------------------------------------------------------------*/
;*    pcache-hclass ...                                                */
;*---------------------------------------------------------------------*/
(define-inline (pcache-hclass pc)
   (with-access::PCache pc (hclass)
      hclass))
   
;*---------------------------------------------------------------------*/
;*    pcache-index ...                                                 */
;*---------------------------------------------------------------------*/
(define-inline (pcache-index pc)
   (with-access::PCache pc (index)
      index))
   
;*---------------------------------------------------------------------*/
;*    pcache-set! ...                                                  */
;*---------------------------------------------------------------------*/
(define-inline (pcache-set! pc hc i)
   (with-access::PCache pc (hclass index)
      (set! hclass hc)
      (set! index i)))

;*---------------------------------------------------------------------*/
;*    make-hclass ...                                                  */
;*---------------------------------------------------------------------*/
(define-inline (make-hclass names)
   (instantiate::HClass
      (names names)
      (transitions '())))

;*---------------------------------------------------------------------*/
;*    hclass-transition-add! ...                                       */
;*---------------------------------------------------------------------*/
(define (hclass-transition-add! hc::HClass tran target::HClass)
   (with-access::HClass hc (transitions)
      (set! transitions (cons (cons tran target) transitions))))

;*---------------------------------------------------------------------*/
;*    hclass-names ...                                                 */
;*---------------------------------------------------------------------*/
(define-inline (hclass-names hclass)
   (with-access::HClass hclass (names)
      names))

;*---------------------------------------------------------------------*/
;*    hclass-transitions ...                                           */
;*---------------------------------------------------------------------*/
(define-inline (hclass-transitions hclass)
   (with-access::HClass hclass (transitions)
      transitions))

;*---------------------------------------------------------------------*/
;*    hclass-last-index ...                                            */
;*---------------------------------------------------------------------*/
(define-inline (hclass-last-index hclass)
   (-fx (vector-length (hclass-names hclass)) 1))
   
