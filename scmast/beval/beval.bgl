;*    byte code interpretation of the Python AST.                      */
;*=====================================================================*/

;*---------------------------------------------------------------------*/
;*    The module                                                       */
;*---------------------------------------------------------------------*/
(module __pyc_beval

   (include "ast/ast.sch"
	    "hclass/hclass.sch"
	    "object/object.sch")
   
   (import __py_hclass
	   __py_object
	   __pyc_dump)

   (export (pyc-beval ast conf))

   (option (define includes '())))

;*---------------------------------------------------------------------*/
;*    include                                                          */
;*---------------------------------------------------------------------*/
(define-macro (include file)
   (unless (member file includes)
      (set! includes (cons file includes))
      (call-with-input-file (make-file-name "beval" file) read)))
