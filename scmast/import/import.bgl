;*---------------------------------------------------------------------*/
;*    The module                                                       */
;*---------------------------------------------------------------------*/
(module __py_import

   (import __py_object
	   __py_hclass)

   (export (py-import path)
	   py-import-root))

;*---------------------------------------------------------------------*/
;*    PWD ...                                                          */
;*---------------------------------------------------------------------*/
(define-macro (PWD) (pwd))
	      
;*---------------------------------------------------------------------*/
;*    compile ...                                                      */
;*---------------------------------------------------------------------*/
(define (compile root source target)
   (when (or (not (file-exists? target))
	     (> (file-modification-time source)
		(file-modification-time target)))
      (system (format "cd ~a; scmast.py ~a | pyc -t bigloo --no-main -d ~a ~a > ~a" (PWD) source root source target))))
   
;*---------------------------------------------------------------------*/
;*    loadv ...                                                        */
;*---------------------------------------------------------------------*/
(define (loadv file)
   (call-with-input-file file
      (lambda (ip)
	 (let loop ((v #f))
	    (let ((e (read ip)))
	       (if (eof-object? e)
		   v
		   (loop (eval! e))))))))
