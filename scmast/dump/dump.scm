(define (py->list this)
   (if (PycNode? this)
       (pynode->list this)
       `(alien :typeof ,(string->symbol (typeof this)) :expr ,this)))

(define-walk-method (pynode->list this::PycNode)
   `(,(string->symbol (typeof this))))

(define-walk-method (pynode->list this::PycModule)
   `(,(string->symbol (typeof this))
     :version ,(PycModule-version this)
     :ident ,(PycModule-ident this)
     ,@(map pynode->list (PycModule-stmts this))))

(define-walk-method (pynode->list this::PycSeq)
   `(,(string->symbol (typeof this)) ,@(map pynode->list (PycSeq-nodes this))))

(define-walk-method (pynode->list this::PycBlock)
   `(,(string->symbol (typeof this))
     ,(map pynode->list (PycBlock-decls this))
     ,(pynode->list (PycBlock-body this))))

(define-walk-method (pynode->list this::PycAssig)
   `(,(string->symbol (typeof this))
     ,(pynode->list (PycAssig-lhs this))
     ,(pynode->list (PycAssig-rhs this))))

(define-walk-method (pynode->list this::PycIf)
   `(,(string->symbol (typeof this))
     ,(pynode->list (PycIf-test this))
     ,(pynode->list (PycIf-then this))
     ,(pynode->list (PycIf-else this))))

(define-walk-method (pynode->list this::PycDecl)
   `(,(string->symbol (typeof this))
     :scope ,(PycDecl-scope this)
     :key ,(PycDecl-key this)
     ,(PycDecl-id this)))

(define-walk-method (pynode->list this::PycDeclInit)
   `(,(string->symbol (typeof this))
     :scope ,(PycDecl-scope this)
     :key ,(PycDecl-key this)
     ,(PycDecl-id this) ,(pynode->list (PycDeclInit-val this))))

(define-walk-method (pynode->list this::PycReturn)
   `(,(string->symbol (typeof this))
     :tail ,(PycReturn-tail this)
     ,(pynode->list (PycReturn-val this))))

(define-walk-method (pynode->list this::PycReturnYield)
   `(,(string->symbol (typeof this))
     :generator ,(PycReturnYield-generator this)
     ,(pynode->list (PycReturnYield-val this))
     ,(pynode->list (PycReturnYield-kont this))))

(define-walk-method (pynode->list this::PycStmtExpr)
   `(,(string->symbol (typeof this))
     ,(pynode->list (PycStmtExpr-expr this))))

(define-walk-method (pynode->list this::PycYield)
   `(,(string->symbol (typeof this))
     :generator ,(PycYield-generator this)
     ,(pynode->list (PycYield-val this))))

(define-walk-method (pynode->list this::PycPragma)
   `(,(string->symbol (typeof this))
     :lang ,(PycPragma-lang this)
     ,(PycPragma-expr this)))

(define-walk-method (pynode->list this::PycUninit)
   `(,(string->symbol (typeof this))))

(define-walk-method (pynode->list this::PycLiteral)
   `(,(string->symbol (typeof this)) ,(PycLiteralValue-val this)))

(define-walk-method (pynode->list this::PycRef)
   `(,(string->symbol (typeof this))
     ,(PycDecl-id (PycRef-decl this))))

(define-walk-method (pynode->list this::PycAccess)
   `(,(string->symbol (typeof this))
     ,(pynode->list (PycAccess-obj this))
     ,(PycAccess-field this)))

(define-walk-method (pynode->list this::PycSubscript)
   `(,(string->symbol (typeof this))
     ,(pynode->list (PycSubscript-obj this))
     ,(PycSubscript-slice this)))

(define-walk-method (pynode->list this::PycRefUnresolved)
   `(,(string->symbol (typeof this)) ,(PycRefUnresolved-id this)))

(define-walk-method (pynode->list this::PycFun)
   `(,(string->symbol (typeof this))
     :need-return ,(PycFun-need-return this)
     :can-locals ,(PycFun-can-locals this)
     :args ,(map pynode->list (PycFun-args this))
     ,(pynode->list (PycFun-body this))))

(define-walk-method (pynode->list this::PycClass)
   `(,(string->symbol (typeof this))
     :decls ,(map (lambda (d)
		     `(,(string->symbol (typeof d))
		       :key ,(PycDecl-key d)
		       ,(PycDecl-id d)))
		(PycClass-decls this))
     :supers ,(map pynode->list (PycClass-supers this))
     ,(pynode->list (PycClass-body this))))

(define-walk-method (pynode->list this::PycKont)
   `(,(string->symbol (typeof this))
     (,(pynode->list (PycKont-param this))
      ,(pynode->list (PycKont-exn this)))
     ,(pynode->list (PycKont-body this))))

(define-walk-method (pynode->list this::PycCall)
   `(,(string->symbol (typeof this))
     ,(pynode->list (PycCall-fun this))
     ,@(map pynode->list (PycCall-args this))))

(define-walk-method (pynode->list this::PycCollection)
   `(,(string->symbol (typeof this))
     ,@(map pynode->list (PycCollection-elts this))))

(define-walk-method (pynode->list this::PycBinary)
   `(,(string->symbol (typeof this))
     ,(PycBinary-op this)
     ,(pynode->list (PycBinary-lhs this))
     ,(pynode->list (PycBinary-rhs this))))

(define-walk-method (pynode->list this::PycWhile)
   `(,(string->symbol (typeof this))
     ,(pynode->list (PycWhile-test this))
     ,(pynode->list (PycWhile-body this))
     :else ,(pynode->list (PycWhile-else this))))

(define-walk-method (pynode->list this::PycFor)
   `(,(string->symbol (typeof this))
     :target ,(pynode->list (PycFor-target this))
     :in ,(pynode->list (PycFor-iter this))
     ,(pynode->list (PycFor-body this))
     :else ,(pynode->list (PycFor-else this))))
