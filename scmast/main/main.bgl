;*---------------------------------------------------------------------*/
;*    The module                                                       */
;*---------------------------------------------------------------------*/
(module astpy
   
   (include "ast/ast.sch")
   
   (import __py_dump
	   __py_sexp
	   __py_symbol
	   __py_locals
	   __py_return
	   __py_beval
	   __py_hclass
	   __py_object)

   (main main))

;*---------------------------------------------------------------------*/
;*    main ...                                                         */
;*---------------------------------------------------------------------*/
(define (main args)
   (let ((verb 0)
	 (conf '()))
      (args-parse (cdr args)
	 ((("-h" "--help") (help "This message"))
	  (usage args-parse-usage)
	  (exit 0))
	 (("-v?level" (help "Increase/set verbosity level (-v0 crystal silence)"))
	  (if (string=? level "")
	      (set! verb (+fx 1 verb))
	      (set! verb (string->integer level))))
	 (else
	  (unless (string=? else "--")
	     (set! conf (cons* '|:src| else conf)))))
      (py19 (cons* '|:verbose| verb conf))))

;*---------------------------------------------------------------------*/
;*    usage ...                                                        */
;*---------------------------------------------------------------------*/
(define (usage args-parse-usage)
   (print "py19")
   (print "usage: py19 [options] -- [bigloo-options]")
   (args-parse-usage #f)
   (newline)
   (print "Shell Variables:")
   (print "   - PYTRACE: hop internal trace [PYTRACE=\"key1, key2, ...\"]")
   (print "      trace")
   (newline))

