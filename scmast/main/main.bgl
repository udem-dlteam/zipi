;*---------------------------------------------------------------------*/
;*    The module                                                       */
;*---------------------------------------------------------------------*/
(module astpy
   
   (include "ast/ast.sch")
   
   (import __py_dump
	   __py_sexp
	   __py_symbol
	   __py_locals
	   __py_return
	   __py_break
	   __py_generator
	   __py_cps
	   __py_beval
	   __py_scheme
	   __py_javascript
	   __py_hclass
	   __py_object)

   (main main))

;*---------------------------------------------------------------------*/
;*    main ...                                                         */
;*---------------------------------------------------------------------*/
(define (main args)
   (let ((verb 0)
	 (tgt 'beval)
	 (conf '()))
      (args-parse (cdr args)
	 ((("-h" "--help") (help "This message"))
	  (usage args-parse-usage)
	  (exit 0))
	 ((("-t" "--target") ?target (help "Set target language"))
	  (set! tgt (string->symbol target)))
	 (("-v?level" (help "Increase/set verbosity level (-v0 crystal silence)"))
	  (if (string=? level "")
	      (set! verb (+fx 1 verb))
	      (set! verb (string->integer level))))
	 (else
	  (unless (string=? else "--")
	     (set! conf (cons* 'src else conf)))))
      (pyc (cons* 'verbose verb 'target tgt conf))))

;*---------------------------------------------------------------------*/
;*    usage ...                                                        */
;*---------------------------------------------------------------------*/
(define (usage args-parse-usage)
   (print "pyc")
   (print "usage: pyc [options] -- [bigloo-options]")
   (args-parse-usage #f)
   (newline)
   (print "Shell Variables:")
   (print "   - PYTRACE: hop internal trace [PYTRACE=\"key1, key2, ...\"]")
   (print "      pyc:dump")
   (newline))

