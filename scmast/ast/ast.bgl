;*---------------------------------------------------------------------*/
;*    The module                                                       */
;*---------------------------------------------------------------------*/
(module __py_ast
   
   (export (abstract-class PyNode
              (loc::pair read-only (info '("notraverse")))
              (%info (default #f) (info '("nojson" "notraverse"))))
           
           ;; module
           (class PyModule::PyNode
              (version::int read-only (default 1))
              (ident::string read-only)
              stmts::pair-nil
              (globals::pair-nil (default '()))
	      (caches::long (default -1)))
           
           ;; misc
           (class PyDecl::PyNode
              (key::int (default (genkey)))
              (name (default #f))
              (id::symbol read-only)
              ;; scope: global, local, block
              scope::symbol
	      ;; usage
	      (usage::pair-nil (default '())))
           
           (class PyDeclInit::PyDecl
              val::PyExpr)

           (class PyVar::PyDeclInit)
           
           ;; statements
           (abstract-class PyStmt::PyNode)
           
           (class PySeq::PyStmt
              (nodes::pair-nil (info '("ast"))))
           
           (class PyBlock::PyStmt
              ;; equivalent to a Scheme let*
              decls::pair-nil
;*               vals::pair-nil                                        */
              body::PyStmt)

           (class PyReturn::PyStmt
              val::PyExpr
              tail::bool)

	   (class PyReturnYield::PyStmt
	      (val::PyExpr (info '("ast")))
	      (generator::bool read-only (default #f))
	      (kont::PyExpr (info '("ast"))))

           (class PyDelete::PyStmt
              expr::PyExpr)
           
           (class PyAssig::PyStmt
              lhs::PyExpr
              rhs::PyExpr)
           
           (class PyIf::PyStmt
              (test::PyExpr (info '("ast")))
              (then::PyStmt (info '("ast")))
              (else::PyStmt (info '("ast"))))

	   (class PyLoop::PyStmt
	      (body::PyStmt (info '("ast")))
	      (else::PyStmt (info '("ast")))
	      (need-break::bool (default #t))
	      (need-continue::bool (default #t)))
	      
	   (class PyWhile::PyLoop
	      (test::PyExpr (info '("ast"))))

	   (class PyRaise::PyStmt
	      (exc::PyExpr (info '("ast")))
	      (cause::PyExpr (info '("ast"))))
	   
	   (class PyTry::PyStmt
	      (body::PyStmt (info '("ast")))
	      handlers::pair-nil
	      (else::PyStmt (info '("ast")))
	      (finally::PyStmt (info '("ast"))))

	   (class PyHandler::PyNode
	      (type::PyExpr (info '("ast")))
	      (body::PyStmt (info '("ast"))))
	   
	   (class PyBreak::PyStmt)
	   (class PyContinue::PyStmt)
	   (class PyPass::PyStmt)

	   (class PyStmtExpr::PyStmt
	      expr::PyExpr)
	   
           ;; expressions
           (class PyExpr::PyNode
	      (type::symbol (default 'unknown)))

           (class PyPragma::PyExpr
              (lang::symbol (default 'scheme))
              expr)
           
           (class PyRef::PyExpr
              (decl (info '("jsonref" "notraverse"))))
           
           (class PyRefUnresolved::PyExpr
              id)

	   (class PyAccess::PyExpr
	      obj::PyExpr
	      (field::bstring read-only))
	   
           (abstract-class PyLiteral::PyExpr)
           
           (final-class PyUninit::PyExpr)
           
           (class PyLiteralValue::PyLiteral
              val)
           
           (final-class PyBool::PyLiteralValue)
           (final-class PyNumber::PyLiteralValue)
           (final-class PyString::PyLiteralValue)

	   (final-class PyUnary::PyExpr
	      op::symbol
	      expr::PyExpr)
	   
           (final-class PyBinary::PyExpr
              op::symbol
              lhs::PyExpr
              rhs::PyExpr)
           
           (final-class PyFun::PyExpr
              args::pair-nil
              body::PyStmt
              (decls::pair-nil (default '()))
	      (generator::bool (default #f))
              (need-return::bool (default #t))
              (can-locals::bool (default #t)))

	   (final-class PyYield::PyExpr
	      (val::PyExpr (info '("ast")))
	      (generator::bool read-only (default #f)))
	   
	   (final-class PyKont::PyExpr
	      (param::PyDecl read-only)
	      (exn::PyDecl read-only)
	      (body::PyNode (info '("ast"))))
           
           (final-class PyCall::PyExpr
              fun::PyExpr
              args::pair-nil
              keywords::pair-nil)

           (genkey)
           
           (generic walk0 n::PyNode p::procedure)
           (generic walk1 n::PyNode p::procedure a0)
           (generic walk2 n::PyNode p::procedure a0 a1)
           (generic walk3 n::PyNode p::procedure a0 a1 a2)
           (generic walk4 n::PyNode p::procedure a0 a1 a2 a3)
           (generic walk5 n::PyNode p::procedure a0 a1 a2 a3 a4)
           (generic walk6 n::PyNode p::procedure a0 a1 a2 a3 a4 a5)
           (generic walk7 n::PyNode p::procedure a0 a1 a2 a3 a4 a5 a6)
           (generic walk0*::pair-nil n::PyNode p::procedure)
           (generic walk1*::pair-nil n::PyNode p::procedure a0)
           (generic walk2*::pair-nil n::PyNode p::procedure a0 a1)
           (generic walk3*::pair-nil n::PyNode p::procedure a0 a1 a2)
           (generic walk4*::pair-nil n::PyNode p::procedure a0 a1 a2 a3)
           (generic walk5*::pair-nil n::PyNode p::procedure a0 a1 a2 a3 a4)
           (generic walk6*::pair-nil n::PyNode p::procedure a0 a1 a2 a3 a4 a5)
           (generic walk7*::pair-nil n::PyNode p::procedure a0 a1 a2 a3 a4 a5 a6)
           (generic walk0!::PyNode n::PyNode p::procedure)
           (generic walk1!::PyNode n::PyNode p::procedure a0)
           (generic walk2!::PyNode n::PyNode p::procedure a0 a1)
           (generic walk3!::PyNode n::PyNode p::procedure a0 a1 a2)
           (generic walk4!::PyNode n::PyNode p::procedure a0 a1 a2 a3)
           (generic walk5!::PyNode n::PyNode p::procedure a0 a1 a2 a3 a4)
           (generic walk6!::PyNode n::PyNode p::procedure a0 a1 a2 a3 a4 a5)
           (generic walk7!::PyNode n::PyNode p::procedure a0 a1 a2 a3 a4 a5 a6)))

;*---------------------------------------------------------------------*/
;*    key ...                                                          */
;*---------------------------------------------------------------------*/
(define key 0)

;*---------------------------------------------------------------------*/
;*    genkey ...                                                       */
;*---------------------------------------------------------------------*/
(define (genkey)
   (set! key (+fx key 1))
   key)

;*---------------------------------------------------------------------*/
;*    generic walks ...                                                */
;*---------------------------------------------------------------------*/
(define-generic (walk0 n::PyNode p::procedure)
   (error "walk0" "Internal Error: forgot Node type"
      (with-output-to-string (lambda () (write-circle n)))))
(define-generic (walk1 n::PyNode p::procedure arg0)
   (error "walk1" "Internal Error: forgot Node type"
      (with-output-to-string (lambda () (write-circle n)))))
