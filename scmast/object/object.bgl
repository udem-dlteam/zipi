;*---------------------------------------------------------------------*/
;*    The module                                                       */
;*---------------------------------------------------------------------*/
(module __py_object

   (include "object/object.sch")
   
   (import __py_hclass)
   
   (export (class PyObject
	      (hclass (default #f))
	      (%elements (default (make-vector 4))))

	   (class PyFunction::PyObject
	      (procedure read-only))

	   (inline PyObject-elements-ref ::PyObject ::long)
	   (PyObject-elements-set! ::PyObject ::long ::obj)

	   (PyObject-find-prop ::PyObject ::obj)
	   
	   (PyFunction-default-hclass)

	   (py-procedure->function ::procedure)
	   
	   (PyFunction-call0 ::obj)
	   (PyFunction-call1 ::obj ::obj)
	   (PyFunction-call2 ::obj ::obj ::obj)
	   (PyFunction-call3 ::obj ::obj ::obj ::obj)
	   (PyFunction-call4 ::obj ::obj ::obj ::obj ::obj)))

;*---------------------------------------------------------------------*/
;*    PyObject-elements-ref ...                                        */
;*---------------------------------------------------------------------*/
(define-inline (PyObject-elements-ref obj offset)
   (with-access::PyObject obj (%elements)
      (vector-ref %elements offset)))

;*---------------------------------------------------------------------*/
;*    PyObject-elements-set! ...                                       */
;*---------------------------------------------------------------------*/
(define (PyObject-elements-set! obj offset val)
   (with-access::PyObject obj (%elements)
      (let ((len (vector-length %elements)))
	 (when (>= offset len)
	    (set! %elements (copy-vector %elements (*fx 2 (max 1 len)))))
	 (vector-set! %elements offset val))))
