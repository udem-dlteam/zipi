;*---------------------------------------------------------------------*/
;*    The module                                                       */
;*---------------------------------------------------------------------*/
(module __pyc_return
   
   (include "ast.sch"
	    "walk.sch"
	    "new.sch")
   
   (import __pyc_ast)
   
   (export (pyc-return this::PycNode conf)))

;*---------------------------------------------------------------------*/
;*    fold ...                                                         */
;*---------------------------------------------------------------------*/
(define (fold kons knil lis)
   (let lp ((lis lis) (ans knil))
      (if (null? lis)
	  ans
	  (lp (cdr lis) (kons (car lis) ans)))))
