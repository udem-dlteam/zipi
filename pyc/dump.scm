(define (pyc->list this)
   (if (PycNode? this)
       (pycnode->list this)
       `(alien :typeof ,(string->symbol (typeof this)) :expr ,this)))

(define-walk-method (pycnode->list this::PycNode)
   `(,(string->symbol (typeof this))))

(define-walk-method (pycnode->list this::PycModule)
   `(,(string->symbol (typeof this))
     :version ,(PycModule-version this)
     :ident ,(PycModule-ident this)
     ,@(map pycnode->list (PycModule-stmts this))))

(define-walk-method (pycnode->list this::PycSeq)
   `(,(string->symbol (typeof this)) ,@(map pycnode->list (PycSeq-nodes this))))

(define-walk-method (pycnode->list this::PycBlock)
   `(,(string->symbol (typeof this))
     ,(map pycnode->list (PycBlock-decls this))
     ,(pycnode->list (PycBlock-body this))))

(define-walk-method (pycnode->list this::PycAssig)
   `(,(string->symbol (typeof this))
     ,(pycnode->list (PycAssig-lhs this))
     ,(pycnode->list (PycAssig-rhs this))))

(define-walk-method (pycnode->list this::PycAugAssig)
   `(,(string->symbol (typeof this))
     ,(PycAugAssig-op this)
     ,(pycnode->list (PycAssig-lhs this))
     ,(pycnode->list (PycAssig-rhs this))))

(define-walk-method (pycnode->list this::PycIf)
   `(,(string->symbol (typeof this))
     ,(pycnode->list (PycIf-test this))
     ,(pycnode->list (PycIf-then this))
     ,(pycnode->list (PycIf-else this))))

(define-walk-method (pycnode->list this::PycWithItem)
   `(,(string->symbol (typeof this))
     ,(pycnode->list (PycWithItem-context-expr this))
     ,(pycnode->list (PycWithItem-optional-vars this))))

(define-walk-method (pycnode->list this::PycWith)
   `(,(string->symbol (typeof this))
     ,(pycnode->list (PycWith-items this))
     ,(pycnode->list (PycWith-body this))))

(define-walk-method (pycnode->list this::PycVar)
   `(,(string->symbol (typeof this))
     :scope ,(PycVar-scope this)
     :key ,(PycVar-key this)
     :name ,(PycVar-name this)
     :id ,(PycVar-id this)))

(define-walk-method (pycnode->list this::PycReturn)
   `(,(string->symbol (typeof this))
     :tail ,(PycReturn-tail this)
     ,(pycnode->list (PycReturn-val this))))

(define-walk-method (pycnode->list this::PycReturnYield)
   `(,(string->symbol (typeof this))
     :generator ,(PycReturnYield-generator this)
     ,(pycnode->list (PycReturnYield-val this))
     ,(pycnode->list (PycReturnYield-kont this))))

(define-walk-method (pycnode->list this::PycStmtExpr)
   `(,(string->symbol (typeof this))
     ,(pycnode->list (PycStmtExpr-expr this))))

(define-walk-method (pycnode->list this::PycSymbols)
   `(,(string->symbol (typeof this))
     ,(PycSymbols-scope this)
     ,(PycSymbols-names this)))

(define-walk-method (pycnode->list this::PycYield)
   `(,(string->symbol (typeof this))
     :generator ,(PycYield-generator this)
     ,(pycnode->list (PycYield-val this))))

(define-walk-method (pycnode->list this::PycPragma)
   `(,(string->symbol (typeof this))
     :lang ,(PycPragma-lang this)
     ,(PycPragma-expr this)))

(define-walk-method (pycnode->list this::PycUninit)
   `(,(string->symbol (typeof this))))

(define-walk-method (pycnode->list this::PycLiteral)
   `(,(string->symbol (typeof this)) ,(PycLiteralValue-val this)))

(define-walk-method (pycnode->list this::PycRef)
   `(,(string->symbol (typeof this))
     :key ,(PycVar-key (PycRef-decl this))
     ,(PycVar-id (PycRef-decl this))))

(define-walk-method (pycnode->list this::PycAccess)
   `(,(string->symbol (typeof this))
     ,(pycnode->list (PycAccess-obj this))
     ,(PycAccess-field this)))

(define-walk-method (pycnode->list this::PycSubscript)
   `(,(string->symbol (typeof this))
     ,(pycnode->list (PycSubscript-obj this))
     ,(PycSubscript-index this)))

(define-walk-method (pycnode->list this::PycSlice)
   `(,(string->symbol (typeof this))
     ,(pycnode->list (PycSlice-obj this))
     ,(pycnode->list (PycSlice-lower this))
     ,(pycnode->list (PycSlice-upper this))
     ,(pycnode->list (PycSlice-step this))))

(define-walk-method (pycnode->list this::PycRefUnresolved)
   `(,(string->symbol (typeof this)) ,(PycRefUnresolved-id this)))

(define-walk-method (pycnode->list this::PycFun)
   `(,(string->symbol (typeof this))
     :need-return ,(PycFun-need-return this)
     :can-locals ,(PycFun-can-locals this)
     :args ,(map pycnode->list (PycFun-args this))
     ,(pycnode->list (PycFun-body this))))

(define-walk-method (pycnode->list this::PycClass)
   `(,(string->symbol (typeof this))
     :bases ,(map pycnode->list (PycClass-bases this))
     :decls ,(map (lambda (d)
		     `(,(string->symbol (typeof d))
		       :key ,(PycVar-key d)
		       ,(PycVar-id d)))
		(PycClass-decls this))
     ,(pycnode->list (PycClass-body this))))

(define-walk-method (pycnode->list this::PycKont)
   `(,(string->symbol (typeof this))
     (map pycnode->list (PycKont-params this))
     ,(pycnode->list (PycKont-body this))))

(define-walk-method (pycnode->list this::PycCall)
   `(,(string->symbol (typeof this))
     ,(pycnode->list (PycCall-fun this))
     ,@(map pycnode->list (PycCall-args this))))

(define-walk-method (pycnode->list this::PycCollection)
   `(,(string->symbol (typeof this))
     ,@(map pycnode->list (PycCollection-elts this))))

(define-walk-method (pycnode->list this::PycBinary)
   `(,(string->symbol (typeof this))
     ,(PycBinary-op this)
     ,(pycnode->list (PycBinary-lhs this))
     ,(pycnode->list (PycBinary-rhs this))))

(define-walk-method (pycnode->list this::PycWhile)
   `(,(string->symbol (typeof this))
     ,(pycnode->list (PycWhile-test this))
     ,(pycnode->list (PycWhile-body this))
     :else ,(pycnode->list (PycWhile-else this))))

(define-walk-method (pycnode->list this::PycFor)
   `(,(string->symbol (typeof this))
     :target ,(pycnode->list (PycFor-target this))
     :in ,(pycnode->list (PycFor-iter this))
     ,(pycnode->list (PycFor-body this))
     :else ,(pycnode->list (PycFor-else this))))
