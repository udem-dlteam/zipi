;*---------------------------------------------------------------------*/
;*    The module                                                       */
;*---------------------------------------------------------------------*/
(module __pyc_scheme

   (include "ast.sch"
	    "walk.sch"
	    "new.sch"
      "PycBinary-to-scheme.scm")

   (import __pyc_configure
	   __pyc_dump
	   __pyc_ast
	   __pyc_utils)

   (export (pyc-scheme ast conf)
;* 	   (pyc-scheme-eval ast conf)                                  */
	   (pyc-scheme-bigloo ast conf)
	   (pyc-scheme-gambit ast conf)))

;*---------------------------------------------------------------------*/
;*    epairify ...                                                     */
;*---------------------------------------------------------------------*/
(define (epairify node expr)
   (if (pair? expr)
       (econs (car expr) (cdr expr) (PycNode-loc node))
       expr))

;*---------------------------------------------------------------------*/
;*    epairify-deep ...                                                */
;*---------------------------------------------------------------------*/
(define (epairify-deep node expr)
   (let ((loc (PycNode-loc node)))
      (if (or (epair? expr) (not (pair? expr)))
	  expr
	  (econs (epairify-deep loc (car expr))
	     (epairify-deep loc (cdr expr))
	     loc))))

;*---------------------------------------------------------------------*/
;*    pretty-print ...                                                 */
;*    -------------------------------------------------------------    */
;*    Gambit compatibility                                             */
;*---------------------------------------------------------------------*/
(define (pretty-print exp)
   (pp exp))

;*---------------------------------------------------------------------*/
;*    pyc-scheme-bigloo ...                                            */
;*---------------------------------------------------------------------*/
(define (pyc-scheme-bigloo ast conf)
   (pyc-cache! ast conf)
   (cond
      ((config-get conf semantics:)
       (pyc-scheme-bigloo-semantics ast conf))
      ((config-get conf semantics-macros:)
       (pyc-scheme-bigloo-semantics-macros ast conf))
      (else
       (pyc-scheme-bigloo-ast ast conf))))

;*---------------------------------------------------------------------*/
;*    is-macro? ...                                                    */
;*---------------------------------------------------------------------*/
(define (is-macro? e)
   (match-case e
      ((define-macro . ?-) #t)
      (else #f)))

;*---------------------------------------------------------------------*/
;*    pyc-scheme-bigloo-semantics ...                                  */
;*---------------------------------------------------------------------*/
(define (pyc-scheme-bigloo-semantics ast conf)

   (define (no-macro s)
      (unless (is-macro? (cdr s))
	 (cdr s)))

   (let* ((semantics (sort-semantics (collect-semantics* ast conf)))
	  (defs (filter-map no-macro semantics))
	  (protos (filter-map def->proto defs)))
      `(,(pyc-scheme-bigloo-semantics-module conf protos)
	(start-registering-constants)
	,@defs
	(end-registering-constants))))

;*---------------------------------------------------------------------*/
;*    pyc-scheme-bigloo-semantics-macros ...                           */
;*---------------------------------------------------------------------*/
(define (pyc-scheme-bigloo-semantics-macros ast conf)

   (define (only-macro s)
      (when (is-macro? (cdr s))
	 (cdr s)))

   (let ((semantics (sort-semantics (collect-semantics* ast conf))))
      (filter-map only-macro semantics)))

;*---------------------------------------------------------------------*/
;*    def->proto ...                                                   */
;*---------------------------------------------------------------------*/
(define (def->proto d)
   (match-case d
      ((define-inline ?args ?body)
       `(inline ,@args))
      ((define (?id . ?args) ?body)
       `(,id ,@args))
      ((define ?id ?val)
       id)
      ((define-rts (?id . ?args) ?body)
       `(,id ,@args))
      ((define-rts ?id ?val)
       id)
      (else
       #f)))

;*---------------------------------------------------------------------*/
;*    pyc-scheme-bigloo-ast ...                                        */
;*---------------------------------------------------------------------*/
(define (pyc-scheme-bigloo-ast ast conf)
   (let* ((file (config-get conf file:))
	  (path (config-get conf dir:))
	  (global-funs (if (config-get conf optim-globals:)
			   (let ((defs (PycModule-global-defs ast)))
			      (set-procedure-names! defs conf)
			      defs)
			   '()))
	  (global-refs (if (config-get conf optim-globals:)
			   (collect-globals* ast)
			   '()))
	  (globals (if (config-get conf optim-globals:)
		       (collect-globals* ast)
		       '()))
	  (conf-with-defs (cons* global-funs: global-funs conf))
	  (prog (scheme ast (cons* global-funs: global-funs conf-with-defs)))
	  (full-path (if (and file path) (make-file-path path file) #f))
	  (mod (if (config-get conf :bootstrap)
		   (pyc-scheme-bigloo-ast-bootstrap-module ast conf)
		   (pyc-scheme-bigloo-ast-module conf))))

      `(;; module declaration
	,mod
	(start-registering-constants)
	,@(if (config-get conf-with-defs optim-globals:)
	      `((define %global #f)
		(define %caches #f)
		,@(scheme-init-global-procedures global-funs conf-with-defs)
		,@(scheme-init-global-init-defs global-funs conf-with-defs)
		,@(scheme-init-globals (map PycRef-decl global-refs) conf-with-defs))
	      '())
	,(if (config-get conf-with-defs optim-globals:)
	     `(define (py-module global caches)
		 (set! %global global)
		 (set! %caches caches)
		 ,@(scheme-register-globals (map PycRef-decl global-refs) conf-with-defs)
		 ,@prog)
	     `(define py-module ,prog))
	,(cond
	    ((config-get conf main:)
	     `(begin
		 (define (init name package path)
		    (init-registered-constants)
		    (let ((caches ,(scheme-make-caches ast))
			  (module (py-make-module
				     name
				     package
				     path)))
		       ,@(if full-path
			     `((py-own-attr-set!
				  module (& "__file__") (& ,full-path)))
			     '())
		       (py-module module caches)
		       module))
		 (define (main argv)
		    (bigloo-library-path-set!
		       (cons ,(config-get conf lib-dir:
				 (make-file-path (zipi-lib-dir) (zipi-version)))
			  (bigloo-library-path)))
		    (command-line-argv-set! (cdr argv))
		    (run-as-module ,(config-get conf :src)
		       (zipi-cache-location) init))))
	    (else
	     `(define (init name package path)
		 (init-registered-constants)
		 (let ((caches ,(scheme-make-caches ast))
		       (module (py-make-module
				  name
				  package
				  path)))
		    ,@(if full-path
			  `((py-own-attr-set!
			       module (& "__file__") (& ,full-path)))
			  '())
		    (py-module module caches)
		    module))))
	(end-registering-constants)
	,(if (not (config-get conf main:)) 'init))))

;*---------------------------------------------------------------------*/
;*    pyc-scheme-bigloo-ast-module ...                                 */
;*---------------------------------------------------------------------*/
(define (pyc-scheme-bigloo-ast-module conf)
   (append (pyc-scheme-bigloo-module-base conf)
      (if (config-get conf main:)
	  '((main main))
	  '((export (init name package path))))))

;*---------------------------------------------------------------------*/
;*    pyc-scheme-bigloo-ast-bootstrap-module ...                       */
;*---------------------------------------------------------------------*/
(define (pyc-scheme-bigloo-ast-bootstrap-module ast conf)
   (let ((globals (delete-duplicates (map PycRef-decl (collect-globals* ast)))))
      (append (pyc-scheme-bigloo-ast-module conf)
	 `((export
	      ,@(map (lambda (v) (scheme-var-name v conf))
		   globals))))))

;*---------------------------------------------------------------------*/
;*    pyc-scheme-bigloo-semantics-module ...                           */
;*---------------------------------------------------------------------*/
(define (pyc-scheme-bigloo-semantics-module conf protos)
   (append (pyc-scheme-bigloo-module-base conf)
      `((export ,@protos))))

;*---------------------------------------------------------------------*/
;*    pyc-scheme-bigloo-module-base ...                                */
;*---------------------------------------------------------------------*/
(define (pyc-scheme-bigloo-module-base conf)
  `(module ,(string->symbol
             (or (config-get conf module-name:)
                 (config-get conf src:)
                 "__stdin"))
           ,@(if (or (config-get conf bootstrap:)
                     (config-get conf semantics:))
                 `((import __py_rts
                           __py_bigloo
                           ,@(if (equal? (config-get conf module-name:)
                                         "__stdlib_zemantics")
                                 '()
                                 '(__stdlib_zemantics))
                           ,@(if (equal? (config-get conf module-name:)
                                         "__stdlib_behaviors")
                                 '()
                                 '(__stdlib_behaviors)))
                   (include "rts-macros.scm"
                            "bigloo/call.sch"
                            "bigloo/constants.sch"
                            "behaviors.sch"
                            "zemantics.sch"))
                 '((library zipi)))))
