;*---------------------------------------------------------------------*/
;*    The module                                                       */
;*---------------------------------------------------------------------*/
(module __pyc_scheme
   
   (include "ast.sch"
	    "walk.sch"
	    "new.sch")
   
   (import __pyc_configure
	   __pyc_dump
	   __pyc_ast
	   __pyc_utils)

   (export (pyc-scheme ast conf)
;* 	   (pyc-scheme-eval ast conf)                                  */
	   (pyc-scheme-bigloo ast conf)
	   (pyc-scheme-gambit ast conf)))

;*---------------------------------------------------------------------*/
;*    epairify ...                                                     */
;*---------------------------------------------------------------------*/
(define (epairify node expr)
   (if (pair? expr)
       (econs (car expr) (cdr expr) (PycNode-loc node))
       expr))

;*---------------------------------------------------------------------*/
;*    epairify-deep ...                                                */
;*---------------------------------------------------------------------*/
(define (epairify-deep node expr)
   (let ((loc (PycNode-loc node)))
      (if (or (epair? expr) (not (pair? expr)))
	  expr
	  (econs (epairify-deep loc (car expr))
	     (epairify-deep loc (cdr expr))
	     loc))))

;*---------------------------------------------------------------------*/
;*    pretty-print ...                                                 */
;*    -------------------------------------------------------------    */
;*    Gambit compatibility                                             */
;*---------------------------------------------------------------------*/
(define (pretty-print exp)
   (pp exp))

;*---------------------------------------------------------------------*/
;*    pyc-scheme-bigloo ...                                            */
;*---------------------------------------------------------------------*/
(define (pyc-scheme-bigloo ast conf)
   (pyc-cache! ast conf)
   (let ((semantics (sort-semantics (collect-semantics* ast conf))))
      (if (null? semantics)
	  (pyc-scheme-bigloo-ast ast conf)
	  (pyc-scheme-bigloo-zemantics semantics conf))))

;*---------------------------------------------------------------------*/
;*    pyc-scheme-bigloo-zemantics ...                                  */
;*---------------------------------------------------------------------*/
(define (pyc-scheme-bigloo-zemantics semantics conf)
   (let ((semantics-definitions (map cdr semantics)))
      semantics-definitions))

;*---------------------------------------------------------------------*/
;*    pyc-scheme-bigloo-ast ...                                        */
;*---------------------------------------------------------------------*/
(define (pyc-scheme-bigloo-ast ast conf)
   (let* ((file (config-get conf file:))
	  (path (config-get conf dir:))
          (global-funs
	     (if (config-get conf optim-globals:)
		 (let ((defs (PycModule-global-defs ast)))
		    (set-procedure-names! defs conf)
		    defs)
		 '()))
          (global-refs
	     (if (config-get conf optim-globals:)
		 (collect-globals* ast)
		 '()))
	  (globals (if (config-get conf optim-globals:)
		       (collect-globals* ast)
		       '()))
          (conf-with-defs (cons* global-funs: global-funs conf))
          (prog (scheme ast (cons* global-funs: global-funs conf-with-defs)))
      	  (full-path (if (and file path) (make-file-path path file) #f)))
      
      `(;; module declaration
	,(pyc-scheme-bigloo-module conf)
	(start-registering-constants)
	,@(if (config-get conf-with-defs optim-globals:)
	      `((define %global #f)
		(define %caches #f)
		,@(scheme-init-global-procedures global-funs conf-with-defs)
		,@(scheme-init-global-init-defs global-funs conf-with-defs)
		,@(scheme-init-globals (map PycRef-decl global-refs) conf-with-defs))
	      '())
	,(if (config-get conf-with-defs optim-globals:)
	     `(define (py-module global caches)
		 (set! %global global)
		 (set! %caches caches)
		 ,@(scheme-register-globals (map PycRef-decl global-refs) conf-with-defs)
		 ,@prog)
	     `(define py-module ,prog))
	,(cond
	    ((config-get conf main:)
	     `(define (main argv)
		 (bigloo-library-path-set!
		    (cons ,(config-get conf lib-dir:) (bigloo-library-path)))
		 (build-builtins)
		 (init-registered-constants)
		 (with-handler
		    (lambda (e)
		       (if (PyObject? e)
			   (exception-notify e)
			   (raise e)))
		    (py-module
		       (py-make-global)
		       (py-make-caches ,(PycModule-caches ast))))))
	    (else
	     `(define (zipi-init name package path)
		 (init-registered-constants)
		 (let ((caches (py-make-caches ,(PycModule-caches ast)))
		       (module (py-make-module
				  (py-str-from-scheme name)
				  (py-str-from-scheme package)
				  (py-str-from-scheme path))))
		    ,@(if full-path
			  `((py-own-attr-set!
			       module (& "__file__") (& ,full-path)))
			  '())
		    (py-module module caches)
		    module))))
	(end-registering-constants))))

;*---------------------------------------------------------------------*/
;*    pyc-scheme-bigloo-module ...                                     */
;*---------------------------------------------------------------------*/
(define (pyc-scheme-bigloo-module conf)
   `(module ,(string->symbol
		(or (config-get conf module-name:)
		    (config-get conf src:)
		    "__stdin"))
       ,@(if (config-get conf bootstrap:)
	     '((import __py_rts
		  __py_bigloo
		  __stdlib_zemantics
		  __stdlib_behaviors)
	       (include "rts-macros.scm"
		  "bigloo/call.sch"
		  "bigloo/constants.sch"))
	     '((library zipi)))
       ,@(if (config-get conf main:)
	     '((main main))
	     '((export (zipi-init ::bstring ::bstring ::bstring))))))
