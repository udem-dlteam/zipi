;*---------------------------------------------------------------------*/
;*    The module                                                       */
;*---------------------------------------------------------------------*/
(module __pyc_configure
   (export (zipi-release)
	   (zipi-version)
	   (zipi-branch)
	   (zipi-bin-dir)
	   (zipi-lib-dir)
	   (zipi-etc-dir)
	   (zipi-rts-dir)
	   (zipi-cache-location)))
