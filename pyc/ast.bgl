;*---------------------------------------------------------------------*/
;*    The module                                                       */
;*---------------------------------------------------------------------*/
(module __pyc_ast

   (export (abstract-class PycNode
	      (loc::pair read-only (info '("notraverse")))
	      (%info (default #f) (info '("nojson" "notraverse"))))

	   ;; A syntactical node that indicates an unimplemented feature
	   ;; used to raise py-builtin-NotImplementedError at run-time
	   ;; instead of raising a Scheme error at compile time
	   (class PycUnimplemented::PycNode
	      msg::string)

	   ;; module
	   (class PycModule::PycNode
	      (version::int read-only (default 1))
	      (ident::string read-only)
	      stmts::pair-nil
	      (globals::pair-nil (default '()))
        (global-defs::pair-nil (default '()))
	      (caches::long (default -1)))

	   ;; misc
	   (class PycVar
       id::symbol
       scope::symbol
       (name::symbol (default #f))
       (key::int (default (genkey)))
       ;; scope: global, local, block
       ;; usage
       (usage::pair-nil (default '()))
       (simple-scoping-top-block (info '("jsonref" "notraverse")) (default #f))
       (cache (default #f)))

	   ;; statements
	   (class PycStmt::PycNode
	      (need-return::bool (default #f)))

	   (class PycSeq::PycStmt
	      (nodes::pair-nil (info '("ast"))))

	   (class PycBlock::PycStmt
	      ;; equivalent to a Scheme let*
	      decls::pair-nil
	      body::PycStmt)

	   (class PycReturn::PycStmt
	      val::PycExpr
	      (tail::bool (default #t)))

	   (class PycReturnYield::PycStmt
	      (val::PycExpr (info '("ast")))
	      (generator::bool read-only (default #f))
	      (kont::PycExpr (info '("ast"))))

	   (class PycDelete::PycStmt
	      expr::PycExpr)

	   (class PycAssig::PycStmt
	      lhs::PycExpr
	      rhs::PycExpr)

	   (class PycAugAssig::PycAssig
	      op::symbol
	      (cache (default #f)))

	   (class PycIf::PycStmt
	      (test::PycExpr (info '("ast")))
	      (then::PycStmt (info '("ast")))
	      (else::PycStmt (info '("ast"))))

	   (class PycWithItem::PycStmt
	      (context-expr::PycExpr (info '("ast")))
	      (optional-vars::PycExpr (info '("ast"))))

	   (class PycWith::PycStmt
	      (items::PycWithItem (info '("ast")))
	      (body::PycStmt (info '("ast"))))

	   (class PycLoop::PycStmt
	      (body::PycStmt (info '("ast")))
	      (else::PycStmt (info '("ast")))
	      (need-break::bool (default #t))
	      (need-continue::bool (default #t)))

	   (class PycFor::PycLoop
	      (target::PycExpr (info '("ast")))
	      (iter::PycExpr (info '("ast")))
	      (cachei (default #f))
	      (cachen (default #f)))

	   (class PycWhile::PycLoop
	      (test::PycExpr (info '("ast"))))

	   (class PycRaise::PycStmt
	      (exc::PycExpr (info '("ast")))
	      (cause::PycExpr (info '("ast"))))

	   (class PycTry::PycStmt
	      (body::PycStmt (info '("ast")))
	      handlers::pair-nil
	      (else::PycStmt (info '("ast")))
	      (finally::PycStmt (info '("ast")))
	      exc-sym::symbol
	      (tail::bool (default #t)))

	   (class PycHandler::PycNode
	      (type::PycExpr (info '("ast")))
	      (body::PycStmt (info '("ast"))))

	   (class PycBreak::PycStmt)
	   (class PycContinue::PycStmt)
	   (class PycPass::PycStmt)

	   (class PycStmtExpr::PycStmt
	      expr::PycExpr)

	   (class PycSymbols::PycStmt
	      (scope::symbol read-only)
	      (names::pair-nil read-only))

	   ;; expressions
	   (class PycExpr::PycNode
	      (type::symbol (default 'unknown)))

	   ;; starred expressions
	   (class PycStarredExpr::PycExpr
	      expr::PycExpr)

	   (class PycPragma::PycExpr
	      (lang::symbol (default 'scheme))
	      expr)

	   (class PycRef::PycExpr
	      (decl::PycVar (info '("jsonref" "notraverse")))
        ctx::symbol
	      (cache (default #f)))

	   (class PycRefUnresolved::PycExpr
	      id::symbol
        ctx::symbol
	      (cache (default #f)))

	   (class PycAccess::PycExpr
	      obj::PycExpr
	      (field::obj read-only)
	      (cache (default #f)))

	   (class PycSubscript::PycExpr
	      obj::PycExpr
	      index::PycExpr
	      (cache (default #f)))

	   (class PycSlice::PycExpr
	      obj::PycExpr
	      lower::PycExpr
	      upper::PycExpr
	      step::PycExpr)

	   (class PycIfExp::PycExpr
	      (test::PycExpr (info '("ast")))
	      (body::PycExpr (info '("ast")))
	      (orelse::PycExpr (info '("ast"))))

	   (class PycAssert::PycStmt
	      (test::PycExpr (info '("ast")))
	      (msg::PycExpr (info '("ast"))))

	   (abstract-class PycLiteral::PycExpr)

	   (final-class PycUninit::PycExpr)

	   (class PycLiteralValue::PycLiteral
	      val)

	   (final-class PycBool::PycLiteralValue)
	   (final-class PycNone::PycLiteralValue)
	   (final-class PycNumber::PycLiteralValue)
	   (final-class PycString::PycLiteralValue)

	   (final-class PycUnary::PycExpr
	      op::symbol
	      expr::PycExpr
	      (type-hint (default #f))
	      (cache (default #f)))

	   (final-class PycBinary::PycExpr
	      op::symbol
	      lhs::PycExpr
	      rhs::PycExpr
	      (lhs-type-hint (default #f))
	      (rhs-type-hint (default #f))
	      (cache (default #f)))

	   (final-class PycBoolOp::PycExpr
	      op::symbol
	      args::pair-nil
	      (cache (default #f)))

	   (class PycFun::PycExpr
	      args::pair-nil
	      posonlyargs::pair-nil
	      vararg::obj
	      kwonlyargs::pair-nil
	      kw-defaults::pair-nil
	      kwarg::obj
	      defaults::pair-nil
	      body::PycStmt
	      (decorators::pair-nil (default '()))
	      (decls::pair-nil (default '()))
	      (generator::bool (default #f))
	      (need-return::bool (default #f))
	      (can-locals::bool (default #t))
	      (super-in-class::bool (default #f))
	      (use-simple-scoping::bool (default #f))
	      (name (default #f))
	      (annotation-names::pair-nil (default '()))
	      (annotation::pair-nil (default '()))
	      (&proc::obj (default #f)))

	   (final-class PycSemantics::PycFun
	      (inline::bool (default #f))
	      (inline-as-is::bool (default #f)))

	   (final-class PycClass::PycExpr
	      (name::bstring read-only)
	      (module::bstring read-only)
	      bases::pair-nil
	      body::PycStmt
	      (decorators::pair-nil (default '()))
	      (decls::pair-nil (default '()))
	      (super-key::symbol (default '_))
	      (is-builtin::bool (default #f)))

	   (final-class PycYield::PycExpr
	      (val::PycExpr (info '("ast")))
	      (generator::bool read-only (default #f)))

	   (final-class PycKont::PycExpr
	      (param::PycVar read-only)
	      (exn::PycVar read-only)
	      (body::PycNode (info '("ast"))))

	   (final-class PycCall::PycExpr
	      fun::PycExpr
	      args::pair-nil
	      (keywords-values::pair-nil (default '()))
	      (keywords-names::pair-nil (default '()))
	      (can-be-super::bool (default #t)))

	   (abstract-class PycCollection::PycExpr
	      elts::pair-nil)

	   (final-class PycList::PycCollection)

	   (final-class PycTuple::PycCollection)

	   (final-class PycDict::PycCollection
	      keys::pair-nil)

	   (final-class PycSet::PycCollection)

	   (final-class PycImport::PycExpr
	      (path::bstring read-only)
	      (depth::int read-only (default 0)))

	   (class PycIntrinsics::PycExpr
	      id::symbol)

	   (final-class PycStatic::PycIntrinsics
	      value::symbol)

	   (final-class PycStaticSexp::PycIntrinsics
	      value::pair-nil)

	   (genkey)

	   (generic walk0 n::PycNode p::procedure)
	   (generic walk1 n::PycNode p::procedure a0)
	   (generic walk2 n::PycNode p::procedure a0 a1)
	   (generic walk3 n::PycNode p::procedure a0 a1 a2)
	   (generic walk4 n::PycNode p::procedure a0 a1 a2 a3)
	   (generic walk5 n::PycNode p::procedure a0 a1 a2 a3 a4)
	   (generic walk6 n::PycNode p::procedure a0 a1 a2 a3 a4 a5)
	   (generic walk7 n::PycNode p::procedure a0 a1 a2 a3 a4 a5 a6)
	   (generic walk8 n::PycNode p::procedure a0 a1 a2 a3 a4 a5 a6 a7)
	   (generic walk0*::pair-nil n::PycNode p::procedure)
	   (generic walk1*::pair-nil n::PycNode p::procedure a0)
	   (generic walk2*::pair-nil n::PycNode p::procedure a0 a1)
	   (generic walk3*::pair-nil n::PycNode p::procedure a0 a1 a2)
	   (generic walk4*::pair-nil n::PycNode p::procedure a0 a1 a2 a3)
	   (generic walk5*::pair-nil n::PycNode p::procedure a0 a1 a2 a3 a4)
	   (generic walk6*::pair-nil n::PycNode p::procedure a0 a1 a2 a3 a4 a5)
	   (generic walk7*::pair-nil n::PycNode p::procedure a0 a1 a2 a3 a4 a5 a6)
	   (generic walk8*::pair-nil n::PycNode p::procedure a0 a1 a2 a3 a4 a5 a6 a7)
	   (generic walk0!::PycNode n::PycNode p::procedure)
	   (generic walk1!::PycNode n::PycNode p::procedure a0)
	   (generic walk2!::PycNode n::PycNode p::procedure a0 a1)
	   (generic walk3!::PycNode n::PycNode p::procedure a0 a1 a2)
	   (generic walk4!::PycNode n::PycNode p::procedure a0 a1 a2 a3)
	   (generic walk5!::PycNode n::PycNode p::procedure a0 a1 a2 a3 a4)
	   (generic walk6!::PycNode n::PycNode p::procedure a0 a1 a2 a3 a4 a5)
	   (generic walk7!::PycNode n::PycNode p::procedure a0 a1 a2 a3 a4 a5 a6)
	   (generic walk8!::PycNode n::PycNode p::procedure a0 a1 a2 a3 a4 a5 a6 a7)))

;*---------------------------------------------------------------------*/
;*    key ...                                                          */
;*---------------------------------------------------------------------*/
(define key 0)

;*---------------------------------------------------------------------*/
;*    genkey ...                                                       */
;*---------------------------------------------------------------------*/
(define (genkey)
   (set! key (+fx key 1))
   key)

;*---------------------------------------------------------------------*/
;*    generic walks ...                                                */
;*---------------------------------------------------------------------*/
(define-generic (walk0 n::PycNode p::procedure)
   (error "walk0" "Internal Error: forgot Node type"
      (with-output-to-string (lambda () (write-circle n)))))
(define-generic (walk1 n::PycNode p::procedure arg0)
   (error "walk1" "Internal Error: forgot Node type"
      (with-output-to-string (lambda () (write-circle n)))))
(define-generic (walk2 n::PycNode p::procedure arg0 arg1)
   (error "walk2" "Internal Error: forgot Node type"
      (with-output-to-string (lambda () (write-circle n)))))
