      (with-output-to-string (lambda () (write-circle n)))))
(define-generic (walk8 n::PycNode p::procedure arg0 arg1 arg2 arg3 arg4 arg5 arg6 arg7)
   (error "walk8" "Internal Error: forgot Node type"
      (with-output-to-string (lambda () (write-circle n)))))

